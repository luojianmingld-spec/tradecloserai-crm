[project]
requires = ["nodejs-24"]

[dev]
build = ["sh", "-c", "cd ${COZE_WORKSPACE_PATH:-/workspace/projects} && pnpm install --filter=backend --filter=frontend && cd backend && npx prisma generate"]
run = ["sh", "-c", "bash ${COZE_WORKSPACE_PATH:-/workspace/projects}/start-dev.sh"]

[deploy]
build = ["bash", "build.sh"]
run = ["bash", "start.sh"]

[project]
requires = ["nodejs-24"]

[dev]
build = ["sh", "-c", "cd ${COZE_WORKSPACE_PATH} && pnpm install --filter=backend --filter=frontend && cd backend && npx prisma generate"]
run = ["bash", "${COZE_WORKSPACE_PATH}/start-dev.sh"]

[deploy]
build = ["sh", "-c", "cd ${COZE_WORKSPACE_PATH}/backend && pnpm install && npx prisma generate && npx prisma db push && cd ${COZE_WORKSPACE_PATH}/frontend && pnpm install && pnpm build"]
run = ["sh", "-c", "cd ${COZE_WORKSPACE_PATH}/backend && NODE_ENV=production node src/server.js"]

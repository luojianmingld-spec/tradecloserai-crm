<template>
  <div class="cust-list-page">
    <!-- Header -->
    <div class="cust-header">
      <button class="back-btn" @click="$router.push('/chat')" title="返回聊天">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
        <span>返回聊天</span>
      </button>
      <h2 class="page-title">👥 客户管理</h2>
      <div class="spacer"></div>
      <button class="hdr-btn ghost" @click="onImport" title="导入">📥 导入</button>
      <button class="hdr-btn ghost" @click="onExport" title="导出">📤 导出</button>
      <el-button type="primary" @click="showAddDialog = true" class="add-btn">
        <span style="margin-right:4px">➕</span>添加客户
      </el-button>
    </div>

    <!-- KPI Bar -->
    <div class="kpi-bar">
      <div class="kpi-item"><span class="kpi-num">{{ stats.total || 0 }}</span><span class="kpi-label">👥 客户</span></div>
      <div class="kpi-item"><span class="kpi-num" style="color:#00a884">{{ stats.active || 0 }}</span><span class="kpi-label">🔥 活跃</span></div>
      <div class="kpi-item"><span class="kpi-num" style="color:#f59e0b">{{ stats.aLevel || 0 }}</span><span class="kpi-label">⭐ A级</span></div>
      <div class="kpi-item"><span class="kpi-num" style="color:#f87171">{{ stats.pending || 0 }}</span><span class="kpi-label">📋 待跟进</span></div>
      <div class="kpi-item"><span class="kpi-num" style="color:#7c3aed">{{ stats.newThisMonth || 0 }}</span><span class="kpi-label">🆕 本月</span></div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="filter-tabs">
        <button v-for="t in tabs" :key="t.key" class="filter-tab"
                :class="{active: activeTab === t.key}"
                @click="switchTab(t.key)">{{ t.label }}</button>
      </div>
      <div class="toolbar-right">
        <el-dropdown trigger="click" @command="onFilterCmd">
          <button class="hdr-btn filter-btn">🔽 筛选 ▾</button>
          <template #dropdown>
            <el-dropdown-menu>
              <el-dropdown-item command="clear">清除筛选</el-dropdown-item>
              <el-dropdown-item divided disabled>按等级</el-dropdown-item>
              <el-dropdown-item v-for="l in ['A','B','C']" :key="l" :command="'level:'+l">{{ l }}级客户</el-dropdown-item>
              <el-dropdown-item divided disabled>按状态</el-dropdown-item>
              <el-dropdown-item command="status:active">活跃</el-dropdown-item>
              <el-dropdown-item command="status:potential">待跟进</el-dropdown-item>
              <el-dropdown-item command="status:dormant">沉睡</el-dropdown-item>
            </el-dropdown-menu>
          </template>
        </el-dropdown>
        <el-input v-model="search" placeholder="🔍 搜索公司/联系人/邮箱/电话"
                  class="search-input" clearable @keyup.enter="reload(1)" @clear="reload(1)" />
      </div>
    </div>

    <!-- Table area -->
    <div class="table-wrap">
      <div v-if="loading" class="empty-state"><div class="loading">加载中...</div></div>
      <template v-else>
        <div v-if="!items.length" class="empty-state">
          <div style="font-size:48px;opacity:0.3">👥</div>
          <div class="empty-desc">还没有客户，点击右上角➕添加第一个客户</div>
          <el-button type="primary" @click="showAddDialog = true" style="margin-top:12px">添加客户</el-button>
        </div>
        <div v-else class="table-scroll">
          <table class="cust-table">
            <thead>
              <tr>
                <th class="col-check"><el-checkbox :model-value="allSelected" :indeterminate="someSelected" @change="toggleAll" /></th>
                <th class="col-name sortable" @click="doSort('companyName')">
                  客户名称 <span v-if="sortKey==='companyName'">{{ sortOrder==='asc'?'↑':'↓' }}</span>
                </th>
                <th class="col-contact">联系人</th>
                <th class="col-country">国家/地区</th>
                <th class="col-level">等级</th>
                <th class="col-status">状态</th>
                <th class="col-phone">电话/WhatsApp</th>
                <th class="col-email">邮箱</th>
                <th class="col-source">来源</th>
                <th class="col-last sortable" @click="doSort('lastContactAt')">
                  最近联系 <span v-if="sortKey==='lastContactAt'">{{ sortOrder==='asc'?'↑':'↓' }}</span>
                </th>
                <th class="col-docs">单证</th>
                <th class="col-follow">跟进</th>
                <th class="col-preview">最近消息</th>
                <th class="col-actions">操作</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="c in items" :key="c.id"
                  :class="{'row-selected': selected.has(c.id)}"
                  @click="goDetail(c)">
                <td class="col-check" @click.stop>
                  <el-checkbox :model-value="selected.has(c.id)" @change="toggleOne(c.id)" />
                </td>
                <td class="col-name">
                  <div class="name-cell">
                    <div class="avatar" :style="{background: avatarColor(displayName(c))}">
                      {{ (displayName(c) || '?')[0].toUpperCase() }}
                    </div>
                    <div class="name-text">
                      <span class="name-link">{{ displayName(c) }}</span>
                      <span v-if="c.companyName && c.contactName && c.contactName !== c.companyName" class="name-sub">{{ c.contactName }}</span>
                    </div>
                  </div>
                </td>
                <td class="col-contact">
                  <span v-if="c.contactName">{{ c.contactName }}</span>
                  <span v-else-if="c.title">{{ c.title }}</span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-country">
                  <span v-if="c.country" class="country-cell">
                    <span class="flag-emoji">{{ countryFlag(c.country) }}</span>
                    <span>{{ c.country }}</span>
                  </span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-level">
                  <span class="level-tag" :class="'level-'+(c.customerLevel||'c').toLowerCase()">{{ (c.customerLevel||'C') }}级</span>
                </td>
                <td class="col-status">
                  <span class="status-tag" :class="'status-'+(c.status||'new')">{{ statusLabel(c.status) }}</span>
                </td>
                <td class="col-phone">
                  <span v-if="c.jid || c.phone" class="contact-cell">
                    <span class="wa-icon" :title="c.jid ? 'WhatsApp已绑定' : '电话'">{{ c.jid ? '💬' : '📱' }}</span>
                    <span class="mono">{{ formatPhone(c.phone || c.jid) }}</span>
                  </span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-email">
                  <span v-if="c.email" class="email-cell" :title="c.email">
                    <span>✉️</span>
                    <span class="email-text">{{ c.email }}</span>
                  </span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-source">
                  <span v-if="c.source" class="source-tag">{{ sourceLabel(c.source) }}</span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-last">
                  <span v-if="c._lastMessageAt || c.lastContactAt">{{ relTime(c._lastMessageAt || c.lastContactAt) }}</span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-docs">
                  <span v-if="c._docCount > 0" class="doc-badge" :class="{'has-pending': c._pendingDocCount>0}">
                    📄 {{ c._docCount }}<template v-if="c._pendingDocCount>0"><span class="pending-dot" title="有待确认单证">!</span></template>
                  </span>
                  <span v-else class="muted">0</span>
                </td>
                <td class="col-follow">
                  <span v-if="c._followUpCount > 0" class="fu-badge">📝 {{ c._followUpCount }}</span>
                  <span v-else class="muted">0</span>
                </td>
                <td class="col-preview">
                  <span v-if="c.requirementSummary || c.requirementProducts" class="req-icon" :title="buildReqTitle(c)">🎯</span>
                  <span v-if="c._lastMessage" class="last-msg" :title="c._lastMessage">{{ c._lastMessage }}</span>
                  <span v-else class="muted">—</span>
                </td>
                <td class="col-actions" @click.stop>
                  <div class="action-cell">
                    <button class="mini-icon" @click="goDetail(c)" title="查看详情">👁</button>
                    <button class="mini-icon" v-if="c.jid" @click="jumpToChat(c)" title="去聊天">💬</button>
                    <el-dropdown trigger="click" @command="(cmd)=>onRowCmd(cmd,c)">
                      <button class="mini-icon" title="更多">⋯</button>
                      <template #dropdown>
                        <el-dropdown-menu>
                          <el-dropdown-item command="view">查看详情</el-dropdown-item>
                          <el-dropdown-item command="edit">编辑客户</el-dropdown-item>
                          <el-dropdown-item command="newdoc" divided>新建单证</el-dropdown-item>
                          <el-dropdown-item command="chat" v-if="c.jid">发起聊天</el-dropdown-item>
                          <el-dropdown-item command="delete" divided>删除</el-dropdown-item>
                        </el-dropdown-menu>
                      </template>
                    </el-dropdown>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <!-- Pagination -->
        <div class="pager">
          <span class="pager-total">共 {{ total }} 条</span>
          <el-pagination
            background
            layout="prev, pager, next, sizes"
            :total="total"
            :page-size="pageSize"
            :current-page="page"
            :page-sizes="[20, 50, 100, 200]"
            @current-change="onPageChange"
            @size-change="onSizeChange"
          />
          <span v-if="selected.size" class="sel-hint">已选 {{ selected.size }} 项</span>
        </div>
      </template>
    </div>

    <!-- Add Customer Dialog -->
    <el-dialog v-model="showAddDialog" title="添加新客户" width="520px" class="cust-dialog" :append-to-body="true">
      <el-form :model="addForm" label-width="90px" label-position="right">
        <el-form-item label="公司名称*">
          <el-input v-model="addForm.companyName" placeholder="客户公司名（必填）" />
        </el-form-item>
        <el-form-item label="联系人">
          <el-input v-model="addForm.contactName" placeholder="联系人姓名" />
        </el-form-item>
        <el-form-item label="职位">
          <el-input v-model="addForm.title" placeholder="职位/头衔" />
        </el-form-item>
        <div class="form-row">
          <el-form-item label="国家" style="flex:1">
            <el-input v-model="addForm.country" placeholder="国家" />
          </el-form-item>
          <el-form-item label="等级" style="width:180px">
            <el-select v-model="addForm.customerLevel" style="width:100%">
              <el-option label="A级 重点" value="A" />
              <el-option label="B级 普通" value="B" />
              <el-option label="C级 潜在" value="C" />
            </el-select>
          </el-form-item>
        </div>
        <el-form-item label="邮箱">
          <el-input v-model="addForm.email" placeholder="email@example.com" />
        </el-form-item>
        <el-form-item label="电话/WhatsApp">
          <el-input v-model="addForm.phone" placeholder="如 97150xxxxxxx" />
        </el-form-item>
        <el-form-item label="网站">
          <el-input v-model="addForm.website" placeholder="https://..." />
        </el-form-item>
        <el-form-item label="来源">
          <el-select v-model="addForm.source" style="width:100%">
            <el-option label="WhatsApp" value="whatsapp" />
            <el-option label="展会" value="展会" />
            <el-option label="独立站询盘" value="独立站询盘" />
            <el-option label="主动开发" value="主动开发" />
            <el-option label="客户介绍" value="老客户推荐" />
            <el-option label="手动添加" value="manual" />
            <el-option label="其他" value="其他" />
          </el-select>
        </el-form-item>
        <el-form-item label="备注">
          <el-input v-model="addForm.notes" type="textarea" :rows="3" placeholder="备注信息" />
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showAddDialog = false">取消</el-button>
        <el-button type="primary" :loading="adding" @click="doAdd">添加</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, reactive } from 'vue';
import { useRouter } from 'vue-router';
import { ElMessage, ElMessageBox } from 'element-plus';
import api from '../utils/api.js';

const router = useRouter();
const loading = ref(false);
const items = ref([]);
const total = ref(0);
const page = ref(1);
const pageSize = ref(50);
const stats = ref({});
const search = ref('');
const activeTab = ref('all');
const filters = reactive({ level: null, status: null });
const showAddDialog = ref(false);
const adding = ref(false);
const addForm = reactive({ companyName:'', contactName:'', title:'', country:'', email:'', phone:'', website:'', source:'manual', customerLevel:'C', notes:'' });
const selected = ref(new Set());
const sortKey = ref('updatedAt');
const sortOrder = ref('desc');

const tabs = [
  { key: 'all', label: '全部' },
  { key: 'A', label: 'A级' },
  { key: 'B', label: 'B级' },
  { key: 'C', label: 'C级' },
  { key: 'potential', label: '潜在' },
  { key: 'active', label: '活跃' },
  { key: 'following', label: '跟进中' },
  { key: 'recent', label: '最近联系' },
];

const allSelected = computed(() => items.value.length>0 && items.value.every(c=>selected.value.has(c.id)));
const someSelected = computed(() => items.value.some(c=>selected.value.has(c.id)) && !allSelected.value);

function avatarColor(name) {
  if (!name) return '#00a884';
  const palette = ['#00a884','#4FC3F7','#AB47BC','#FF7043','#66BB6A','#FFA726','#EC407A','#26A69A','#EF5350','#5C6BC0'];
  let hash = 0;
  for (let i=0;i<name.length;i++) hash = name.charCodeAt(i) + ((hash<<5) - hash);
  return palette[Math.abs(hash) % palette.length];
}
function displayName(c) {
  const n = c.companyName || c.contactName || c.name;
  if (n && String(n).trim() && n !== '0') return n;
  if (c.phone) { const p=String(c.phone).replace(/@.*$/,''); if (p && p!=='0') return p; }
  if (c.jid) { const j=c.jid.split('@')[0]; if (j && j!=='0') return j; }
  return '(未命名)';
}
function formatPhone(p) {
  if (!p) return '';
  const s = String(p).replace(/@.*$/,'');
  if (s.length > 18) return s.slice(0,18)+'…';
  return s;
}
function statusLabel(s) {
  return ({active:'活跃', following:'跟进中', dormant:'沉睡', potential:'潜在客户', new:'新客户'})[s] || s || '新';
}
function sourceLabel(s) {
  return ({whatsapp:'WhatsApp', manual:'手动', '展会':'展会', '独立站询盘':'询盘', '主动开发':'主动开发', '老客户推荐':'推荐'})[s] || s || '其他';
}
function countryFlag(c) {
  if (!c) return '🌍';
  const map = {UAE:'🇦🇪','阿联酋':'🇦🇪','China':'🇨🇳','中国':'🇨🇳','USA':'🇺🇸','US':'🇺🇸','美国':'🇺🇸','UK':'🇬🇧','Britain':'🇬🇧','英国':'🇬🇧','India':'🇮🇳','印度':'🇮🇳','Saudi':'🇸🇦','沙特':'🇸🇦','Germany':'🇩🇪','德国':'🇩🇪','France':'🇫🇷','法国':'🇫🇷','Turkey':'🇹🇷','土耳其':'🇹🇷','Egypt':'🇪🇬','埃及':'🇪🇬','Brazil':'🇧🇷','巴西':'🇧🇷','Russia':'🇷🇺','俄罗斯':'🇷🇺','Japan':'🇯🇵','日本':'🇯🇵','Korea':'🇰🇷','韩国':'🇰🇷','Italy':'🇮🇹','意大利':'🇮🇹','Spain':'🇪🇸','西班牙':'🇪🇸','Mexico':'🇲🇽','墨西哥':'🇲🇽','Canada':'🇨🇦','加拿大':'🇨🇦','Australia':'🇦🇺','澳大利亚':'🇦🇺','Pakistan':'🇵🇰','巴基斯坦':'🇵🇰','Bangladesh':'🇧🇩','孟加拉':'🇧🇩','Nigeria':'🇳🇬','尼日利亚':'🇳🇬','South Africa':'🇿🇦','南非':'🇿🇦','Kenya':'🇰🇪','肯尼亚':'🇰🇪','Vietnam':'🇻🇳','越南':'🇻🇳','Thailand':'🇹🇭','泰国':'🇹🇭','Indonesia':'🇮🇩','印尼':'🇮🇩','Malaysia':'🇲🇾','马来西亚':'🇲🇾','Philippines':'🇵🇭','菲律宾':'🇵🇭','Iran':'🇮🇷','伊朗':'🇮🇷','Iraq':'🇮🇶','伊拉克':'🇮🇶','Israel':'🇮🇱','以色列':'🇮🇱','Dubai':'🇦🇪'};
  for (const k in map) if (c.toLowerCase().includes(k.toLowerCase())) return map[k];
  return '🌍';
}
function relTime(iso) {
  if (!iso) return '';
  const d = new Date(iso); const now = new Date();
  const diff = (now - d) / 1000;
  if (isNaN(diff)) return '';
  if (diff < 60) return '刚刚';
  if (diff < 3600) return Math.floor(diff/60)+'分钟前';
  if (diff < 86400) return Math.floor(diff/3600)+'小时前';
  const days = Math.floor(diff/86400);
  if (days === 0) return '今天';
  if (days === 1) return '昨天';
  if (days < 7) return days+'天前';
  if (days < 30) return Math.floor(days/7)+'周前';
  return d.toISOString().slice(0,10);
}

async function reload(p) {
  if (p) page.value = p;
  selected.value.clear();
  loading.value = true;
  try {
    const params = { page: page.value, pageSize: pageSize.value };
    if (search.value) params.search = search.value;
    if (activeTab.value === 'A' || activeTab.value === 'B' || activeTab.value === 'C') params.level = activeTab.value;
    else if (activeTab.value === 'potential' || activeTab.value === 'active' || activeTab.value === 'following') params.status = activeTab.value;
    if (activeTab.value === 'recent') params.recent = '1';
    if (filters.level) params.level = filters.level;
    if (filters.status) params.status = filters.status;
    if (sortKey.value && sortKey.value !== 'updatedAt') {
      params.sort = sortKey.value; params.order = sortOrder.value;
    }
    const qs = new URLSearchParams(params).toString();
    const { data } = await api.get('/customers?' + qs);
    items.value = data.items || [];
    total.value = data.total || 0;
    stats.value = data.stats || {};
  } catch (e) {
    console.error(e);
    ElMessage.error('加载客户列表失败');
  } finally {
    loading.value = false;
  }
}
function onPageChange(p) { reload(p); }
function onSizeChange(s) { pageSize.value = s; reload(1); }
function switchTab(key) {
  activeTab.value = key;
  filters.level = null; filters.status = null;
  reload(1);
}
function onFilterCmd(cmd) {
  if (cmd === 'clear') { filters.level=null; filters.status=null; activeTab.value='all'; reload(1); return; }
  const [k,v] = cmd.split(':');
  if (k === 'level') { filters.level = v; filters.status=null; activeTab.value='all'; }
  if (k === 'status') { filters.status = v; filters.level=null; activeTab.value='all'; }
  reload(1);
}
function doSort(key) {
  if (sortKey.value === key) {
    sortOrder.value = sortOrder.value==='asc'?'desc':'asc';
  } else { sortKey.value = key; sortOrder.value = 'desc'; }
  reload();
}
function toggleAll(v) {
  if (v) items.value.forEach(c => selected.value.add(c.id));
  else selected.value.clear();
}
function toggleOne(id) {
  if (selected.value.has(id)) selected.value.delete(id);
  else selected.value.add(id);
}
function goDetail(c) { router.push(`/customers/${c.id}`); }
function buildReqTitle(c) {
  const parts = [];
  if (c.requirementProducts) parts.push('产品：' + c.requirementProducts);
  if (c.requirementQuantity) parts.push('数量：' + c.requirementQuantity);
  if (c.requirementBudget) parts.push('预算：' + c.requirementBudget);
  if (c.requirementDelivery) parts.push('交期：' + c.requirementDelivery);
  if (c.requirementSummary) parts.push('详情：' + c.requirementSummary);
  return parts.join('\n') || '已记录需求';
}
function jumpToChat(c) {
  if (!c.jid) { ElMessage.warning('该客户无WhatsApp号码'); return; }
  router.push('/chat');
  sessionStorage.setItem('wa-open-jid', c.jid);
}
function onRowCmd(cmd, c) {
  if (cmd === 'view' || cmd === 'edit') goDetail(c);
  else if (cmd === 'chat') jumpToChat(c);
  else if (cmd === 'newdoc') router.push(`/customers/${c.id}/documents/new`);
  else if (cmd === 'delete') {
    ElMessageBox.confirm(`确认删除客户 ${displayName(c)} 吗？`, '确认', {type:'warning'})
      .then(async ()=>{
        try { await api.delete(`/customers/${c.id}`); ElMessage.success('已删除'); reload(); }
        catch(e){ ElMessage.error('删除失败'); }
      }).catch(()=>{});
  }
}
function onImport() { ElMessage.info('导入功能即将开放'); }
function onExport() { ElMessage.info('导出功能即将开放'); }

async function doAdd() {
  if (!addForm.companyName) { ElMessage.warning('请填写公司名称'); return; }
  adding.value = true;
  try {
    await api.post('/customers', addForm);
    ElMessage.success('添加成功');
    showAddDialog.value = false;
    Object.assign(addForm, { companyName:'', contactName:'', title:'', country:'', email:'', phone:'', website:'', source:'manual', customerLevel:'C', notes:'' });
    reload();
  } catch (e) {
    ElMessage.error(e?.response?.data?.error || '添加失败');
  } finally { adding.value = false; }
}

onMounted(() => reload(1));

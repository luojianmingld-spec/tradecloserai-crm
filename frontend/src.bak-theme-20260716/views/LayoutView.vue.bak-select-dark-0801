<script setup>
import { ref, computed, onMounted, onUnmounted, watch, nextTick, reactive } from 'vue';
import { useRouter, useRoute } from 'vue-router';
import { useAuthStore } from '../stores/auth.js';
import { useChatStore } from '../stores/chat.js';
import { initSocket } from '../utils/socket.js';
import api from '../utils/api.js';
import { ElMessage } from 'element-plus';
import { QuestionFilled } from '@element-plus/icons-vue';

const router = useRouter();
const route = useRoute();
const authStore = useAuthStore();
const chatStore = useChatStore();

// ========== 折叠状态 ==========
const platformCollapsed = ref(localStorage.getItem('platform-collapsed') === 'true');
const accountsCollapsed = ref(localStorage.getItem('accounts-collapsed') === 'true');
const chatlistCollapsed = ref(false);
// ── 功能面板状态 ──
const activePanel = ref(null); // 默认收起，点图标再展开
const lastActivePanel = ref('ai');
const panelWidth = ref(parseInt(localStorage.getItem('panel-width') || '360'));
const iconbarCollapsed = ref(localStorage.getItem('iconbar-collapsed') ? localStorage.getItem('iconbar-collapsed') === '1' : true);
const aiMiniMode = ref(false);
const chatViewRef = ref(null);
// ── AI 话术面板独立状态 ──
const aitalkModel = ref('');
const aiModels = ref([]);
const aitalkStyle = ref('formal');
const aitalkLoading = ref(false);
const aitalkError = ref('');
const aitalkReplies = ref([]);

// 加载可用 AI 模型列表
async function loadAiModels() {
  try {
    const { data } = await api.get('/ai/models');
    const list = Array.isArray(data?.models) ? data.models : [];
    aiModels.value = list;
    if (list.length && !list.find(m => m.key === aitalkModel.value)) {
      // 优先选 Lite/快速 模型
      const lite = list.find(m => (m.name || '').toLowerCase().includes('lite') || (m.name || '').includes('快速'));
      aitalkModel.value = (lite || list[0]).key;
    }
  } catch (e) {
    // fallback 默认两个
    aiModels.value = [];
  }
}
loadAiModels();

const aitalkStyles = [
  { key: 'formal',   label: '正式商务', sub: 'Professional', icon: '💼' },
  { key: 'friendly', label: '友好亲切', sub: 'Friendly',     icon: '😊' },
  { key: 'concise',  label: '简洁高效', sub: 'Concise',      icon: '⚡' },
];
const aitalkStyleMeta = Object.fromEntries(aitalkStyles.map(x => [x.key, x]));
const aitalkConfidence = ['92%', '88%', '85%'];

async function handleAitalkGenerate() {
  if (aitalkLoading.value) return;
  if (!chatStore.activeJid) {
    aitalkError.value = '请先选择一个会话';
    aitalkReplies.value = [];
    return;
  }
  aitalkLoading.value = true;
  aitalkError.value = '';
  aitalkReplies.value = [];
  try {
    const { data } = await api.post('/ai/reply', { jid: chatStore.activeJid, style: aitalkStyle.value, model: aitalkModel.value });
    const list = Array.isArray(data?.replies) ? data.replies.map(t => (t||'').trim()).filter(Boolean) : [];
    if (!list.length) {
      aitalkError.value = data?.error || '未生成回复，请重试';
    } else {
      aitalkReplies.value = list.slice(0, 3);
    }
  } catch (err) {
    aitalkError.value = err?.response?.data?.error || err?.message || '生成失败，请重试';
  } finally {
    aitalkLoading.value = false;
  }
}

function applyAitalkReply(text) {
  if (!text) return;
  activePanel.value = null;
  nextTick(() => {
    let inst = chatViewRef.value;
    // 处理 <component :is> 可能的包装
    if (inst && inst.$ && typeof inst.applyAiReply !== 'function') {
      inst = inst.$.exposed || inst;
    }
    if (inst && typeof inst.applyAiReply === 'function') {
      inst.applyAiReply(text);
    } else {
      console.warn('[aitalk] ChatView applyAiReply not found');
    }
  });
}

// 兼容别名
const aiWidth = computed(() => panelWidth.value);
const aiCollapsed = computed(() => activePanel.value !== 'ai');
const panelCollapsed = computed(() => activePanel.value === null);
const channelDropdown = ref(false);
const activeFilter = ref('all');
const filters = [
  { key: 'all',     label: '所有',     icon: '' },
  { key: 'unread',  label: '未读',     icon: '' },
  { key: 'starred', label: '特别关注', icon: '⭐' },
  { key: 'groups',  label: '群组',     icon: '' },
  { key: 'glass',   label: '玻璃',     icon: '' },
];


// 会话搜索
const searchKeyword = ref('');

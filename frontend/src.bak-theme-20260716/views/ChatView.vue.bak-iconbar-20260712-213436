          <svg v-if="!sidebarCollapsed" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/>
          </svg>
          <svg v-else viewBox="0 0 24 24" width="12" height="12" fill="currentColor">

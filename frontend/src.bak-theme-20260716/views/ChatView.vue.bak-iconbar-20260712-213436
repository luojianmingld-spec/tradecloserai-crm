          <el-tooltip content="翻译设置" placement="left" :disabled="!sidebarCollapsed" effect="dark">
            <button class="rfb-item" :class="{ active: chatStore.translationSettings?.receiveEnabled || chatStore.translationSettings?.sendEnabled }" @click="transDrawerVisible = true">
              <span class="rfb-icon">🌐</span>
              <span v-if="!sidebarCollapsed" class="rfb-label">翻译设置</span>
            </button>

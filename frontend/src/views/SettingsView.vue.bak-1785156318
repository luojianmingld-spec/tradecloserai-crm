            <button class="btn-test" @click="testTranslate" :disabled="testing || providers.length === 0">
              {{ testing ? '翻译中...' : '测试' }}
            </button>
          </div>
          <div v-if="testResult" class="test-result">
            <span class="result-label">翻译结果:</span>
            <span class="result-text">{{ testResult }}</span>
          </div>
        </div>

        <div class="settings-actions">
          <button class="save-btn" @click="saveTransSettings" :disabled="savingTrans">
            {{ savingTrans ? '保存中...' : '保存翻译设置' }}
          </button>
          <span v-if="saveMsg" class="save-msg" :class="{ error: saveMsg.includes('失败') }">{{ saveMsg }}</span>
        </div>
      </section>

      <!-- Tab 2: AI话术 -->
      <section v-if="activeTab === 'reply'" class="settings-section">
        <h2>AI 话术生成</h2>
        <div v-if="providers.length === 0" class="empty-state">
          <p>请先在上方添加AI模型</p>
        </div>
        <template v-else>
          <div class="form-group">
            <label>默认回复风格</label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" v-model="replyStyle" value="formal" />
                <span>正式商务</span>
              </label>
              <label class="radio-label">
                <input type="radio" v-model="replyStyle" value="friendly" />
                <span>友好热情</span>
              </label>
              <label class="radio-label">
                <input type="radio" v-model="replyStyle" value="concise" />
                <span>简洁高效</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label>话术测试</label>
            <textarea v-model="replyTestText" class="form-textarea" rows="4" placeholder="输入客户消息，生成回复话术..."></textarea>
            <button class="btn-test" @click="testReply" :disabled="testingReply" style="margin-top: 8px;">
              {{ testingReply ? '生成中...' : '生成话术' }}
            </button>
          </div>

          <div v-if="replyResults.length > 0" class="reply-results">
            <div v-for="(reply, idx) in replyResults" :key="idx" class="reply-item">
              <div class="reply-index">话术 {{ idx + 1 }}</div>
              <div class="reply-content">{{ reply }}</div>
            </div>
          </div>
        </template>
      </section>

      <!-- Tab 3: 需求总结 -->
      <section v-if="activeTab === 'summarize'" class="settings-section">
        <h2>需求总结</h2>
        <div v-if="providers.length === 0" class="empty-state">
          <p>请先在上方添加AI模型</p>
        </div>
        <template v-else>
          <div class="form-group">
            <label>测试需求分析</label>
            <textarea v-model="summarizeTestText" class="form-textarea" rows="6" placeholder="输入对话内容，分析客户需求..."></textarea>
            <button class="btn-test" @click="testSummarize" :disabled="testingSummarize" style="margin-top: 8px;">
              {{ testingSummarize ? '分析中...' : '分析需求' }}
            </button>
          </div>

          <div v-if="summarizeResult" class="summarize-result">
            <div class="result-item" v-if="summarizeResult.products">
              <span class="result-key">意向产品:</span>
              <span class="result-value">{{ summarizeResult.products }}</span>
            </div>
            <div class="result-item" v-if="summarizeResult.quantity">
              <span class="result-key">需求规模:</span>
              <span class="result-value">{{ summarizeResult.quantity }}</span>
            </div>
            <div class="result-item" v-if="summarizeResult.keyConcerns">
              <span class="result-key">核心关注:</span>
              <span class="result-value">{{ summarizeResult.keyConcerns }}</span>
            </div>
            <div class="result-item" v-if="summarizeResult.nextActions">
              <span class="result-key">下一步行动:</span>
              <span class="result-value">{{ summarizeResult.nextActions }}</span>
            </div>
            <div class="result-item" v-if="summarizeResult.intentionScore">
              <span class="result-key">意向度:</span>
              <span class="result-value">{{ summarizeResult.intentionScore }}/10</span>
            </div>
          </div>
        </template>
      </section>

      <!-- Tab 4: 客户背调 -->
      <section v-if="activeTab === 'background'" class="settings-section">
        <h2>客户背调</h2>
        <div v-if="providers.length === 0" class="empty-state">
          <p>请先在上方添加AI模型</p>
        </div>
        <template v-else>
          <div class="form-group">
            <label>搜索深度</label>
            <select v-model="backgroundDepth" class="form-select">
              <option value="quick">快速</option>
              <option value="standard">标准</option>
              <option value="deep">深度</option>
            </select>
          </div>

          <div class="form-group">
            <label>背调测试</label>
            <input v-model="backgroundQuery" class="form-input" placeholder="输入公司名或域名..." @keyup.enter="testBackground" />
            <button class="btn-test" @click="testBackground" :disabled="testingBackground" style="margin-top: 8px;">
              {{ testingBackground ? '搜索中...' : '开始背调' }}
            </button>
          </div>

          <div v-if="backgroundResult" class="background-result">
            <div class="result-section" v-if="backgroundResult.companyInfo">
              <h4>公司信息</h4>
              <p>{{ backgroundResult.companyInfo }}</p>
            </div>
            <div class="result-section" v-if="backgroundResult.products">
              <h4>主要产品/服务</h4>
              <p>{{ backgroundResult.products }}</p>
            </div>
            <div class="result-section" v-if="backgroundResult.reputation">
              <h4>市场声誉</h4>
              <p>{{ backgroundResult.reputation }}</p>
            </div>
            <div class="result-section" v-if="backgroundResult.recommendations">
              <h4>合作建议</h4>
              <p>{{ backgroundResult.recommendations }}</p>
            </div>
          </div>
        </template>
      </section>


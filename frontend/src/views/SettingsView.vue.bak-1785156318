            <option value="Asia/Shanghai">北京时间 (UTC+8)</option>
            <option value="Asia/Dubai">迪拜 (UTC+4)</option>
            <option value="Asia/Kolkata">印度 (UTC+5:30)</option>
            <option value="America/New_York">美东 (UTC-5)</option>
            <option value="America/Los_Angeles">美西 (UTC-8)</option>
            <option value="Europe/London">伦敦 (UTC+0)</option>
            <option value="Europe/Berlin">柏林 (UTC+1)</option>
          </select>
        </div>

        <div class="form-group" v-if="unattendedForm.enabled">
          <label>回复策略</label>
          <div class="radio-group">
            <label class="radio-label">
              <input type="radio" v-model="unattendedForm.strategy" value="smart" />
              <span>智能回复（AI 根据客户消息生成）</span>
            </label>
            <label class="radio-label">
              <input type="radio" v-model="unattendedForm.strategy" value="simple" />
              <span>简单告知（固定话术：正在离线中）</span>
            </label>
          </div>
        </div>

        <div class="form-actions" v-if="unattendedForm.enabled">
          <button class="btn btn-primary" @click="saveUnattended" :disabled="unattendedSaving">
            {{ unattendedSaving ? '保存中...' : '保存设置' }}
          </button>
          <span v-if="unattendedSaved" class="save-hint">✓ 已保存</span>
        </div>
      </section>
    </div>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted } from 'vue';
import { useRouter } from 'vue-router';
import { useAuthStore } from '../stores/auth.js';
import { ElMessage, ElMessageBox } from 'element-plus';
import api from '../utils/api.js';

// TG User Bot
const tgStatus = ref({ connected: false, user: null });
const tgLoading = ref(true);
const tgSyncing = ref(false);
const tgContactCount = ref(0);
const tgSyncResult = ref(null);

const router = useRouter();
const authStore = useAuthStore();
const teamUsers = ref([]);
const teamLoading = ref(false);
const showAddUser = ref(false);
const pwdTarget = ref(null);
const submitting = ref(false);
const modalMsg = ref('');
const modalErr = ref(false);
const userForm = reactive({ name:'', username:'', password:'', role:'user' });

async function loadTeam() {
  if (authStore.user?.role !== 'admin') return;
  teamLoading.value = true;
  try { const { data } = await api.get('/auth/users'); teamUsers.value = data; }
  catch(e) { ElMessage.error('加载成员失败'); }
  teamLoading.value = false;
}

function handleLogout() {
  ElMessageBox.confirm('确定退出登录？', '提示', { type: 'warning' }).then(() => {
    authStore.logout();
    router.push('/login');
  }).catch(()=>{});
}

function resetPwd(u) {
  pwdTarget.value = u;
  userForm.password = '';
  modalMsg.value = '';
}

async function delUser(u) {
  try {
    await ElMessageBox.confirm(`确定删除成员 ${u.name} (@${u.username})？`, '删除确认', { type: 'warning' });
    await api.delete('/auth/users/' + u.id);
    ElMessage.success('已删除');
    loadTeam();
  } catch(e) { if(e!=='cancel') ElMessage.error('删除失败'); }
}

function closeModals() {
  showAddUser.value = false; pwdTarget.value = null;
  modalMsg.value = ''; userForm.name=''; userForm.username=''; userForm.password=''; userForm.role='user';
}

async function submitUser() {
  submitting.value = true; modalMsg.value = ''; modalErr.value = false;
  try {
    if (pwdTarget.value) {
      if (!userForm.password || userForm.password.length < 4) throw new Error('密码至少4位');
      await api.put('/auth/users/' + pwdTarget.value.id, { password: userForm.password });
      ElMessage.success('密码已重置');
    } else {
      if (!userForm.username || !userForm.password) throw new Error('用户名密码必填');
      if (userForm.password.length < 4) throw new Error('密码至少4位');
      await api.post('/auth/register', { ...userForm });
      ElMessage.success('成员已添加');
    }
    closeModals();
    loadTeam();
  } catch(e) {
    modalErr.value = true;
    modalMsg.value = e.response?.data?.error || e.message || '操作失败';
  }
  submitting.value = false;
}

// Provider management
const providers = ref([]);
const activeId = ref(null);
const showAddForm = ref(false);
const editingId = ref(null);
const showApiKey = ref(false);
const testingConnection = ref(false);
const savingForm = ref(false);
const testMessage = ref('');
const testSuccess = ref(false);

const PROVIDER_DEFAULTS = {
  doubao: { baseUrl: 'https://ark.cn-beijing.volces.com/api/v3', model: 'doubao-seed-2-0-pro-260215' },
  deepseek: { baseUrl: 'https://api.deepseek.com', model: 'deepseek-chat' },
  openai: { baseUrl: 'https://api.openai.com/v1', model: 'gpt-4o-mini' },
  custom: { baseUrl: '', model: '' },
};

const form = ref({
  name: '',
  provider: 'doubao',
  apiKey: '',
  baseUrl: PROVIDER_DEFAULTS.doubao.baseUrl,
  model: PROVIDER_DEFAULTS.doubao.model,
});

// Tabs
const tabs = [
  { id: 'translation', label: '翻译设置' },
  { id: 'reply', label: 'AI话术' },
  { id: 'summarize', label: '需求总结' },
  { id: 'background', label: '客户背调' },
  { id: 'unattended', label: '无人值守' },
];
const activeTab = ref('translation');

// Unattended settings
const unattendedForm = ref({
  enabled: false,
  startHour: 22,
  endHour: 8,
  timezone: 'Asia/Shanghai',
  strategy: 'smart',
});
const unattendedSaving = ref(false);
const unattendedSaved = ref(false);

async function loadUnattended() {
  try {
    const res = await api.get('/settings/unattended');
    unattendedForm.value = { ...unattendedForm.value, ...res.data };
  } catch (e) {
    console.warn('load unattended failed:', e.message);
  }
}

async function saveUnattended() {
  unattendedSaving.value = true;
  unattendedSaved.value = false;
  try {
    await api.put('/settings/unattended', unattendedForm.value);
    unattendedSaved.value = true;
    setTimeout(() => { unattendedSaved.value = false; }, 3000);
  } catch (e) {
    console.error('save unattended failed:', e);
  } finally {
    unattendedSaving.value = false;
  }
}

// Translation settings
const transForm = ref({
  translationEnabled: 'true',
  translationEngine: '',
  translationTargetLang: 'auto',
  translationAutoSend: 'false',
});
const testing = ref(false);
const testText = ref('');
const testResult = ref('');
const savingTrans = ref(false);
const saveMsg = ref('');

// Reply settings
const replyStyle = ref('formal');
const replyTestText = ref('');
const replyResults = ref([]);
const testingReply = ref(false);

// Summarize settings
const summarizeTestText = ref('');
const summarizeResult = ref(null);
const testingSummarize = ref(false);

// Background settings
const backgroundDepth = ref('standard');
const backgroundQuery = ref('');
const backgroundResult = ref(null);
const testingBackground = ref(false);

// TG methods
const fetchTgStatus = async () => {
  try {
    const res = await fetch('/api/tg-userbot/state');
    if (res.ok) {
      tgStatus.value = await res.json();
    }
    if (tgStatus.value.connected) {
      const contactsRes = await fetch('/api/tg-userbot/contacts').then(r => r.json());
      tgContactCount.value = contactsRes.contacts?.length || 0;
    }
  } catch (e) {
    console.warn('TG status fetch failed:', e);
  } finally {
    tgLoading.value = false;
  }
};

const syncTgContacts = async () => {
  tgSyncing.value = true;
  tgSyncResult.value = null;
  try {
    const res = await fetch('/api/tg-userbot/sync-contacts', { method: 'POST' });
    if (res.ok) {
      tgSyncResult.value = await res.json();
      tgContactCount.value = tgSyncResult.value.total;
    }
  } catch (e) {
    console.error('TG sync failed:', e);
  } finally {
    tgSyncing.value = false;
  }
};


      // ===== WhatsApp 账号管理 =====
      const waAccounts = ref([]);
      const waLoading = ref(false);
      const showQRModal = ref(false);
      const qrLoading = ref(false);
      const qrBase64 = ref(null);
      const currentQRAccount = ref(null);
      let qrPollTimer = null;

      const stateLabel = (state) => {
        const map = { open: "已连接", connecting: "连接中", close: "未连接", disconnected: "已断开", no_instance: "未创建实例", error: "异常" };
        return map[state] || state;
      };

      const fetchWAStatus = async () => {
        waLoading.value = true;
        try {
          const res = await apiClient.get(`/accounts/wa/status`);
          waAccounts.value = res.data;
        } catch (e) {
          console.error("Failed to fetch WA status:", e);
        } finally {
          waLoading.value = false;
        }
      };

      const showQR = async (acct) => {
        showQRModal.value = true;
        currentQRAccount.value = acct;
        qrBase64.value = null;
        await refreshQR();
      };

      const refreshQR = async () => {
        if (!currentQRAccount.value) return;
        qrLoading.value = true;
        qrBase64.value = null;
        try {
          const res = await apiClient.get(`/accounts/wa/${currentQRAccount.value.id}/qr`);
          qrBase64.value = res.data.base64;
          // Poll for connection status
          if (qrPollTimer) clearInterval(qrPollTimer);
          qrPollTimer = setInterval(async () => {
            try {
              const statusRes = await apiClient.get(`/accounts/wa/status`);
              waAccounts.value = statusRes.data;
              const acct = waAccounts.value.find(a => a.id === currentQRAccount.value.id);
              if (acct && acct.connectionState === "open") {
                clearInterval(qrPollTimer);
                qrPollTimer = null;
                closeQRModal();
              }
            } catch {}
          }, 3000);
        } catch (e) {
          console.error("QR fetch failed:", e);
        } finally {
          qrLoading.value = false;
        }
      };

      const closeQRModal = () => {
        showQRModal.value = false;
        qrBase64.value = null;
        currentQRAccount.value = null;
        if (qrPollTimer) { clearInterval(qrPollTimer); qrPollTimer = null; }
      };

      const disconnectWA = async (acct) => {
        if (!confirm(`确定断开 ${acct.name || acct.phone} 的连接？`)) return;
        try {
          await apiClient.post(`/accounts/wa/${acct.id}/disconnect`);
          await fetchWAStatus();
        } catch (e) {
          alert("断开失败: " + e.message);
        }
      };

      onMounted(async () => {
  fetchTgStatus();
      fetchWAStatus();
  loadTeam();
  await loadProviders();
  await loadTransSettings();
  await loadUnattended();
});

function getProviderLabel(provider) {
  const labels = { doubao: '豆包', deepseek: 'DeepSeek', openai: 'OpenAI', custom: '自定义' };
  return labels[provider] || provider;
}

async function loadProviders() {
  try {
    const res = await api.get('/api/settings/ai-providers');
    providers.value = res.data.providers || [];
    activeId.value = res.data.activeId;
    // Set default translation engine if not set
    if (!transForm.value.translationEngine && providers.value.length > 0) {
      transForm.value.translationEngine = providers.value[0].id;
    }
  } catch (err) {
    console.error('Failed to load providers:', err);
  }
}

async function loadTransSettings() {
  try {
    const res = await api.get('/api/settings/ai');
    if (res.data.settings) {
      transForm.value.translationEnabled = res.data.settings.translationEnabled || 'true';
      transForm.value.translationTargetLang = res.data.settings.translationTargetLang || 'auto';
      transForm.value.translationAutoSend = res.data.settings.translationAutoSend || 'false';
      transForm.value.translationEngine = res.data.settings.translationEngine || '';
    }
  } catch (err) {
    console.error('Failed to load settings:', err);
  }
}

function onProviderChange() {
  const defaults = PROVIDER_DEFAULTS[form.value.provider] || PROVIDER_DEFAULTS.custom;
  form.value.baseUrl = defaults.baseUrl;
  form.value.model = defaults.model;
}

function editProvider(p) {
  editingId.value = p.id;
  showAddForm.value = false;
  form.value = {
    name: p.name,
    provider: p.provider,
    apiKey: '',
    baseUrl: p.baseUrl,
    model: p.model,
  };
  showApiKey.value = false;
  testMessage.value = '';
}

function cancelForm() {
  showAddForm.value = false;
  editingId.value = null;
  form.value = {
    name: '',
    provider: 'doubao',
    apiKey: '',
    baseUrl: PROVIDER_DEFAULTS.doubao.baseUrl,
    model: PROVIDER_DEFAULTS.doubao.model,
  };
  showApiKey.value = false;
  testMessage.value = '';
}

async function saveForm() {
  if (!form.value.name || !form.value.model) {
    testMessage.value = '请填写模型名称和模型ID';
    testSuccess.value = false;
    return;
  }
  if (!editingId.value && !form.value.apiKey) {
    testMessage.value = '请填写 API Key';
    testSuccess.value = false;
    return;
  }

  savingForm.value = true;
  testMessage.value = '';
  try {
    if (editingId.value) {
      await api.put(`/api/settings/ai-providers/${editingId.value}`, form.value);
    } else {
      await api.post('/api/settings/ai-providers', form.value);
    }
    await loadProviders();
    cancelForm();
  } catch (err) {
    testMessage.value = '保存失败: ' + (err.response?.data?.error || err.message);
    testSuccess.value = false;
  } finally {
    savingForm.value = false;
  }
}

async function deleteProvider(id) {
  if (!confirm('确定要删除这个模型配置吗？')) return;
  try {
    await api.delete(`/api/settings/ai-providers/${id}`);
    await loadProviders();
  } catch (err) {
    alert('删除失败: ' + (err.response?.data?.error || err.message));
  }
}

async function activateProvider(id) {
  try {
    await api.post(`/api/settings/ai-providers/${id}/activate`);
    await loadProviders();
  } catch (err) {
    alert('激活失败: ' + (err.response?.data?.error || err.message));
  }
}

async function testFormConnection() {
  testingConnection.value = true;
  testMessage.value = '';
  try {
    const payload = editingId.value
      ? { providerId: editingId.value }
      : { apiKey: form.value.apiKey, baseUrl: form.value.baseUrl, model: form.value.model };
    const res = await api.post('/api/settings/ai-providers/test', payload);
    testMessage.value = res.data.message || (res.data.success ? '连接成功' : '连接失败');
    testSuccess.value = res.data.success;
  } catch (err) {
    testMessage.value = '测试失败: ' + (err.response?.data?.error || err.message);
    testSuccess.value = false;
  } finally {
    testingConnection.value = false;
  }
}

async function saveTransSettings() {
  savingTrans.value = true;
  saveMsg.value = '';
  try {
    await api.put('/api/settings/ai', transForm.value);
    saveMsg.value = '保存成功';
    setTimeout(() => { saveMsg.value = ''; }, 3000);
  } catch (err) {
    saveMsg.value = '保存失败: ' + (err.response?.data?.error || err.message);
  } finally {
    savingTrans.value = false;
  }
}

async function testTranslate() {
  if (!testText.value.trim() || providers.length === 0) return;
  testing.value = true;
  testResult.value = '';
  try {
    const res = await api.post('/api/ai/translate', {
      text: testText.value,
      sourceLang: 'auto',
      targetLang: transForm.value.translationTargetLang === 'auto' ? 'zh' : transForm.value.translationTargetLang,
      providerId: transForm.value.translationEngine,
    });
    testResult.value = res.data.translated || '无结果';
  } catch (err) {
    testResult.value = '翻译失败: ' + (err.response?.data?.error || err.message);
  } finally {
    testing.value = false;
  }
}

async function testReply() {
  if (!replyTestText.value.trim()) return;
  testingReply.value = true;
  replyResults.value = [];
  try {
    const res = await api.post('/api/ai/reply', {
      text: replyTestText.value,
      style: replyStyle.value,
    });
    replyResults.value = res.data.replies || [];
  } catch (err) {
    alert('生成失败: ' + (err.response?.data?.error || err.message));
  } finally {
    testingReply.value = false;
  }
}

async function testSummarize() {
  if (!summarizeTestText.value.trim()) return;
  testingSummarize.value = true;
  summarizeResult.value = null;
  try {
    const res = await api.post('/api/ai/summarize', {
      text: summarizeTestText.value,
    });
    summarizeResult.value = res.data.summary || res.data;
  } catch (err) {
    alert('分析失败: ' + (err.response?.data?.error || err.message));
  } finally {
    testingSummarize.value = false;
  }
}

async function testBackground() {
  if (!backgroundQuery.value.trim()) return;
  testingBackground.value = true;
  backgroundResult.value = null;
  try {
    const res = await api.post('/api/background-check', {
      query: backgroundQuery.value,
      depth: backgroundDepth.value,
    });
    backgroundResult.value = res.data;
  } catch (err) {
    alert('背调失败: ' + (err.response?.data?.error || err.message));
  } finally {
    testingBackground.value = false;
  }
}
</script>


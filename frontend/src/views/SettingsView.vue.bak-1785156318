            {{ testMessage }}
          </div>
          <div class="form-actions">
            <button class="btn-secondary" @click="testFormConnection" :disabled="testingConnection">
              {{ testingConnection ? '测试中...' : '测试连接' }}
            </button>
            <button class="btn-primary" @click="saveForm" :disabled="savingForm">
              {{ savingForm ? '保存中...' : '保存' }}
            </button>
            <button class="btn-cancel" @click="cancelForm">取消</button>
          </div>

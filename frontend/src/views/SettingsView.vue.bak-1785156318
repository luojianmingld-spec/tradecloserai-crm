        <div class="form-group">
          <label class="toggle-label">
            <span>启用自动翻译</span>
            <button class="toggle-btn" :class="{ active: transForm.translationEnabled === 'true' }" @click="transForm.translationEnabled = transForm.translationEnabled === 'true' ? 'false' : 'true'">
              <span class="toggle-thumb"></span>
            </button>
          </label>
        </div>

        <div class="form-group">
          <label>翻译引擎</label>
          <select v-model="transForm.translationEngine" class="form-select" :disabled="providers.length === 0">

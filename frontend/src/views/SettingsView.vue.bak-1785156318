              <label>模型名称</label>
              <input v-model="form.name" class="form-input" placeholder="例如：火山引擎豆包Pro" />
            </div>
            <div class="form-group">
              <label>供应商</label>
              <select v-model="form.provider" class="form-select" @change="onProviderChange">
                <option value="doubao">火山引擎豆包 (Doubao)</option>
                <option value="deepseek">DeepSeek</option>
                <option value="openai">OpenAI</option>
                <option value="custom">自定义</option>
              </select>
            </div>
            <div class="form-group full-width">
              <label>API Key</label>
              <div class="input-with-toggle">
                <input v-model="form.apiKey" class="form-input" :type="showApiKey ? 'text' : 'password'" :placeholder="editingId ? '留空则不修改' : '输入 API Key'" />
                <button type="button" class="btn-toggle" @click="showApiKey = !showApiKey">
                  <svg v-if="showApiKey" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                    <line x1="1" y1="1" x2="23" y2="23"/>
                  </svg>
                  <svg v-else width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="form-group full-width">
              <label>API 地址</label>
              <input v-model="form.baseUrl" class="form-input" placeholder="https://..." />
            </div>
            <div class="form-group full-width">
              <label>模型 ID / Endpoint</label>
              <input v-model="form.model" class="form-input" placeholder="例如：doubao-seed-2-0-pro-260215" />
            </div>
          </div>

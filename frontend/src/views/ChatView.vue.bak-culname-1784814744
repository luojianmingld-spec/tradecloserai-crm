function safeParseTags(t) {
  if (!t) return '';
  if (Array.isArray(t)) return t.join(',');
  if (typeof t === 'string') {
    try { const arr = JSON.parse(t); return Array.isArray(arr) ? arr.join(',') : t; }
    catch { return t; }
  }
  return '';
}

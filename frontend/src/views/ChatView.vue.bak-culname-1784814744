                      <div class="mmd-name">{{ msg.fileName || msg.body || '文件' }}</div>
                      <div class="mmd-size">{{ (msg.fileSize ? formatFileSize(msg.fileSize) + ' · ' : '') + (msg.pending ? '发送中…' : (isPdfMsg(msg) ? '点击预览' : '已发送 · 点击下载')) }}</div>

</template>

<script setup>
import { ref, onMounted, nextTick } from 'vue';

const draftMsg = ref('');
const msgArea = ref(null);

const currentConv = ref({
  name: 'John Smith',
  color: '#4FC3F7',
  status: 'online',
});

function sendMsg() {
  if (!draftMsg.value.trim()) return;
  // 简化演示：清空输入
  draftMsg.value = '';
}

onMounted(() => {
  nextTick(() => {
    if (msgArea.value) msgArea.value.scrollTop = msgArea.value.scrollHeight;
  });
});
</script>


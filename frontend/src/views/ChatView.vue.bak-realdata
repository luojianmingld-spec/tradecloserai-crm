        <div class="ch-name">{{ currentConv?.name || '选择一个会话' }}</div>
        <div class="ch-status" v-if="currentConv">
          <span class="online-dot" :class="currentConv.status"></span>
          {{ currentConv.status === 'online' ? '在线' : '最近在线' }}
        </div>
      </div>
      <div class="ch-actions">
        <button title="搜索"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></button>
        <button title="更多"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg></button>
      </div>
    </div>

    <!-- 消息区 -->
    <div class="conv-messages" ref="msgArea">
      <div class="msg-date-divider"><span>今天</span></div>

      <div class="msg incoming">
        <div class="msg-bubble">
          <div class="msg-text">Hi, I saw your tempered glass products on the website. Can you send me a quote for 500sqm?</div>
          <div class="msg-time">10:15</div>
        </div>
      </div>

      <div class="msg incoming">
        <div class="msg-bubble">
          <div class="msg-text">Also need CE certification documents if available.</div>
          <div class="msg-time">10:16</div>
        </div>
      </div>

      <div class="msg outgoing">
        <div class="msg-bubble">
          <div class="msg-text">
            Hi John, thanks for reaching out!<br/>
            Our 10mm clear tempered glass: <b>USD 18.5/sqm</b> EXW Shenzhen.<br/>
            MOQ: 100sqm | Lead time: 15-20 days
          </div>
          <div class="msg-time">10:28 <span class="msg-check">✓✓</span></div>
        </div>
      </div>

      <div class="msg outgoing">
        <div class="msg-bubble">
          <div class="msg-text">
            CE & ISO 9001 certified. I'll send the certificate and factory video shortly.
          </div>
          <div class="msg-time">10:28 <span class="msg-check">✓✓</span></div>
        </div>
      </div>

      <!-- AI建议条 (悬浮在输入框上方) -->
      <div class="ai-suggest-bar">
        <div class="ai-sb-label">🤖 AI建议</div>
        <div class="ai-sb-chips">
          <button class="ai-chip">询问目标价</button>
          <button class="ai-chip">发送产品目录</button>
          <button class="ai-chip">邀请视频验厂</button>
        </div>
      </div>
    </div>

    <!-- 输入区 -->
    <div class="conv-input-area">
      <button class="input-action" title="添加">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
      </button>
      <div class="input-wrap">
        <input
          type="text"
          v-model="draftMsg"
          placeholder="输入消息... (Enter发送)"
          @keydown.enter="sendMsg"
        />
        <button class="emoji-btn" title="表情">😊</button>
      </div>
      <button class="send-btn" @click="sendMsg">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>

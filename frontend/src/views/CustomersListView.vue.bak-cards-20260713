<script setup>
import { ref, onMounted, reactive } from 'vue';
import { useRouter } from 'vue-router';
import { ElMessage } from 'element-plus';
import api from '../utils/api.js';

const router = useRouter();
const loading = ref(false);
const items = ref([]);
const stats = ref({});
const search = ref('');
const activeTab = ref('all');
const filters = reactive({ level: null, status: null });
const showAddDialog = ref(false);
const adding = ref(false);
const addForm = reactive({ companyName:'', contactName:'', title:'', country:'', email:'', phone:'', website:'', source:'manual', customerLevel:'C', notes:'' });

const tabs = [
  { key: 'all', label: '全部' },
  { key: 'A', label: 'A级' },
  { key: 'B', label: 'B级' },
  { key: 'C', label: 'C级' },
  { key: 'pending', label: '待跟进' },
  { key: 'recent', label: '最近联系' },
];

function avatarColor(name) {
  if (!name) return '#00a884';
  const palette = ['#00a884','#4FC3F7','#AB47BC','#FF7043','#66BB6A','#FFA726','#EC407A','#26A69A','#EF5350','#5C6BC0'];
  let hash = 0;
  for (let i=0;i<name.length;i++) hash = name.charCodeAt(i) + ((hash<<5) - hash);
  return palette[Math.abs(hash) % palette.length];
}
function statusDotClass(s) {
  if (s === 'active') return 'online';
  if (s === 'following') return 'following';
  if (s === 'dormant') return 'offline';
  return 'idle';
}
function statusLabel(s) {
  return ({active:'活跃', following:'跟进中', dormant:'沉睡', potential:'待跟进', new:'新客户'})[s] || s || '新';
}
function countryFlag(c) {
  if (!c) return '🌍';
  const map = {UAE:'🇦🇪','阿联酋':'🇦🇪','China':'🇨🇳','中国':'🇨🇳','USA':'🇺🇸','美国':'🇺🇸','UK':'🇬🇧','英国':'🇬🇧','India':'🇮🇳','印度':'🇮🇳','Saudi':'🇸🇦','沙特':'🇸🇦','Germany':'🇩🇪','德国':'🇩🇪','France':'🇫🇷','法国':'🇫🇷','Turkey':'🇹🇷','土耳其':'🇹🇷','Egypt':'🇪🇬','埃及':'🇪🇬','Brazil':'🇧🇷','巴西':'🇧🇷','Russia':'🇷🇺','俄罗斯':'🇷🇺','Japan':'🇯🇵','日本':'🇯🇵','Korea':'🇰🇷','韩国':'🇰🇷','Italy':'🇮🇹','意大利':'🇮🇹','Spain':'🇪🇸','西班牙':'🇪🇸','Mexico':'🇲🇽','墨西哥':'🇲🇽','Canada':'🇨🇦','加拿大':'🇨🇦','Australia':'🇦🇺','澳大利亚':'🇦🇺','Pakistan':'🇵🇰','巴基斯坦':'🇵🇰','Bangladesh':'🇧🇩','孟加拉':'🇧🇩','Nigeria':'🇳🇬','尼日利亚':'🇳🇬','South Africa':'🇿🇦','南非':'🇿🇦','Kenya':'🇰🇪','肯尼亚':'🇰🇪'};
  for (const k in map) if (c.toLowerCase().includes(k.toLowerCase())) return map[k];
  return '🌍';
}
function relTime(iso) {
  if (!iso) return '';
  const d = new Date(iso); const now = new Date();
  const diff = (now - d) / 1000;
  if (diff < 60) return '刚刚';
  if (diff < 3600) return Math.floor(diff/60)+'分钟前';
  if (diff < 86400) return Math.floor(diff/3600)+'小时前';
  const days = Math.floor(diff/86400);
  if (days === 0) return '今天';
  if (days === 1) return '昨天';
  if (days < 7) return days+'天前';
  if (days < 30) return Math.floor(days/7)+'周前';
  return d.toISOString().slice(0,10);
}

async function loadList() {
  loading.value = true;
  try {
    const params = { pageSize: 100 };
    if (search.value) params.search = search.value;
    if (activeTab.value === 'A' || activeTab.value === 'B' || activeTab.value === 'C') params.level = activeTab.value;
    if (activeTab.value === 'pending') params.status = 'potential';
    if (activeTab.value === 'recent') params.recent = '1';
    if (filters.level) params.level = filters.level;
    if (filters.status) params.status = filters.status;
    const qs = new URLSearchParams(params).toString();
    const { data } = await api.get('/customers?' + qs);
    items.value = data.items || [];
    stats.value = data.stats || {};
    // For each, load a pending doc hint (best effort, skip errors)
    // Use the list's _docCount already; fetch pending docs per item cheaply via /customers/:id/documents?status=DRAFT - simplified: skip extra call
  } catch (e) {
    console.error(e);
    ElMessage.error('加载客户列表失败');
  } finally {
    loading.value = false;
  }
}

function switchTab(key) {
  activeTab.value = key;
  filters.level = null;
  filters.status = null;
  if (key === 'A' || key === 'B' || key === 'C') filters.level = key;
  if (key === 'pending') filters.status = 'potential';
  loadList();
}
function onFilterCmd(cmd) {
  if (cmd === 'clear') { filters.level=null; filters.status=null; activeTab.value='all'; loadList(); return; }
  const [k,v] = cmd.split(':');
  if (k === 'level') { filters.level = v; filters.status=null; activeTab.value='all'; }
  if (k === 'status') { filters.status = v; filters.level=null; activeTab.value='all'; }
  loadList();
}
function goDetail(c) { router.push(`/customers/${c.id}`); }

async function doAdd() {
  if (!addForm.companyName) { ElMessage.warning('请填写公司名称'); return; }
  adding.value = true;
  try {
    await api.post('/customers', addForm);
    ElMessage.success('添加成功');
    showAddDialog.value = false;
    Object.assign(addForm, { companyName:'', contactName:'', title:'', country:'', email:'', phone:'', website:'', source:'manual', customerLevel:'C', notes:'' });
    loadList();
  } catch (e) {
    ElMessage.error(e?.response?.data?.error || '添加失败');
  } finally { adding.value = false; }
}

onMounted(loadList);
</script>


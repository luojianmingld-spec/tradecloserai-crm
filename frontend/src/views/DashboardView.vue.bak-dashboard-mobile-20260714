<script setup>
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { useRouter } from 'vue-router'
import api from '../utils/api.js'
import { useAuthStore } from '../stores/auth.js'

const router = useRouter()
const authStore = useAuthStore()

const username = computed(() => authStore.user?.name || authStore.user?.username || '销售')

const stats = ref({})
const statsLoading = ref(true)
const statsError = ref(false)

const conversations = ref([])
const convLoading = ref(true)
const convError = ref(false)

const activeTab = ref('todo')
let refreshTimer = null

const pendingTotal = computed(() => {
  if (statsLoading.value) return 0
  return (stats.value.urgent?.length || 0)
    + (stats.value.followup?.length || 0)
    + (stats.value.reactivate?.length || 0)
})

const todoList = computed(() => {
  const list = []
  const withLevel = (arr, level) => arr.map(x => ({ ...x, followupLevel: level }))
  list.push(...withLevel(stats.value.urgent || [], 'urgent'))
  list.push(...withLevel(stats.value.followup || [], 'followup'))
  list.push(...withLevel(stats.value.reactivate || [], 'reactivate'))
  return list
})

async function loadStats() {
  statsError.value = false
  try {
    const { data } = await api.get('/dashboard/stats')
    stats.value = data || {}
  } catch (e) {
    statsError.value = true
    console.error('[Dashboard] stats error:', e?.message || e)
  } finally {
    statsLoading.value = false
  }
}

async function loadConversations() {
  convError.value = false
  try {
    const { data } = await api.get('/whatsapp/conversations?limit=20')
    conversations.value = Array.isArray(data) ? data : []
  } catch (e) {
    convError.value = true
    console.error('[Dashboard] conversations error:', e?.message || e)
  } finally {
    convLoading.value = false
  }
}

async function loadAll() {
  statsLoading.value = true
  convLoading.value = true
  await Promise.all([loadStats(), loadConversations()])
}

function goChat(filter) {
  const q = {}
  if (filter) q.filter = filter
  router.push({ path: '/chat', query: q })
}

function goChatJid(jid) {
  router.push({ path: '/chat', query: { jid } })
}

function levelLabel(level) {
  if (level === 'urgent') return '紧急'
  if (level === 'followup') return '跟进'
  if (level === 'reactivate') return '唤醒'
  return ''
}

function formatTime(t) {
  if (!t) return ''
  const d = new Date(t)
  if (isNaN(d.getTime())) return ''
  const now = new Date()
  const sameDay = d.toDateString() === now.toDateString()
  const pad = n => String(n).padStart(2, '0')
  if (sameDay) return `${pad(d.getHours())}:${pad(d.getMinutes())}`
  const yesterday = new Date(now.getTime() - 86400000)
  if (d.toDateString() === yesterday.toDateString()) return '昨天'
  return `${d.getMonth() + 1}/${d.getDate()}`
}

function formatNum(n) {
  if (n == null) return 0
  if (n >= 10000) return (n / 10000).toFixed(1) + 'w'
  if (n >= 1000) return (n / 1000).toFixed(1) + 'k'
  return n
}

onMounted(async () => {
  authStore.checkAuth?.()
  await loadAll()
  refreshTimer = setInterval(loadAll, 30000)
})

onUnmounted(() => {
  if (refreshTimer) clearInterval(refreshTimer)
})
</script>


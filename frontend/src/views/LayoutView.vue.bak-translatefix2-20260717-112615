/* ===== 2026-07-13 移动端响应式补丁（追加） ===== */
@media (max-width: 768px) {
  /* 平台侧栏永远隐藏 */
  .platform-nav { display: none !important; }

  /* 顶部栏：让右侧按钮组横向排列 */
  .mh-right { display: flex; align-items: center; gap: 2px; margin-left: auto; }
  .mh-btn.active { background: #00a88430; color: var(--accent); border-radius: 50%; }
  .mh-btn { min-width: 40px; min-height: 40px; }

  /* 遮罩要覆盖整个视口，除顶部头和底部tab */
  .mobile-overlay { z-index: 40; }

  /* 聊天区固定撑满，padding-bottom 预留底部tab空间 */
  .workspace { flex: 1; min-height: 0; position: relative; width: auto; overflow: hidden; height: 0; padding-bottom: 0; box-sizing: border-box; }
  .workspace.has-mheader { padding-top: 0; }
  /* comm-module在手机端必须占满workspace；module-full走下方full-page fixed规则 */
  .comm-module { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; }
  .module-full { height: 100%; overflow-y: auto !important; -webkit-overflow-scrolling: touch; background: var(--panel-bg); }

  /* 账号栏：抽屉式，默认隐藏在屏幕左侧，m-open时滑入 */

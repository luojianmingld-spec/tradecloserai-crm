  transition: border-color .15s, transform .1s;
}
.stat-card.clickable { cursor: pointer; }
.stat-card.clickable:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}
.stat-icon { font-size: 30px; line-height: 1; }

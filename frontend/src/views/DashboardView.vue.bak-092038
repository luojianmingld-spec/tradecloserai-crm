.quick-tx {
  font-size: 14px;
  color: var(--text-primary);
  font-weight: 500;
}

/* ④ 两栏布局 */
.two-col {
  display: grid;
  grid-template-columns: 6fr 4fr;
  gap: 16px;
}
.panel {
  background: var(--mgmt-card-bg);
  border: 1px solid var(--mgmt-divider);
  border-radius: 12px;
  overflow: hidden;
}

<template>
  <div class="dashboard-page">
    <!-- ① 顶部欢迎横条 -->
    <div class="welcome-bar">
      <div class="welcome-left">
        <div class="welcome-title">
          <span class="wave">👋</span>
          欢迎回来，<span class="username">{{ username }}</span>
        </div>
        <div class="welcome-sub">
          <template v-if="!statsLoading && !statsError">
            今天有 <b :class="pendingTotal > 0 ? 'hl' : ''">{{ pendingTotal }}</b> 个客户需要关注，加油！
          </template>
          <template v-else-if="statsLoading">数据加载中…</template>
          <template v-else>数据加载失败</template>
        </div>
      </div>
      <button
        v-if="pendingTotal > 0"
        class="primary-btn"
        @click="goChat()"
      >🚀 开始处理</button>
    </div>

    <!-- ② 数字统计卡片行 -->
    <div class="stat-grid">
      <div
        class="stat-card clickable"
        :class="{ 'card-pending': true }"
        @click="goChat('pending')"
      >
        <div class="stat-icon">📩</div>
        <div class="stat-value">{{ statsLoading ? '…' : (stats.pending?.length || stats.urgent?.length || 0) }}</div>
        <div class="stat-label">待回复</div>
      </div>
      <div
        class="stat-card clickable"
        @click="goChat('followup')"
      >
        <div class="stat-icon">⏰</div>
        <div class="stat-value">{{ statsLoading ? '…' : stats.followup?.length || 0 }}</div>
        <div class="stat-label">待跟进</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">💬</div>
        <div class="stat-value">{{ statsLoading ? '…' : stats.unreadMessages ?? 0 }}</div>
        <div class="stat-label">未读消息</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-value">{{ statsLoading ? '…' : stats.totalConversations ?? 0 }}</div>
        <div class="stat-label">活跃客户</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">⚡</div>
        <div class="stat-value">{{ statsLoading ? '…' : stats.todayMessages ?? 0 }}</div>
        <div class="stat-label">今日消息</div>
      </div>
    </div>

    <!-- ③ 快捷操作行 -->
    <div class="quick-row">
      <div class="quick-item" @click="router.push('/chat')">
        <span class="quick-ic">💬</span>
        <span class="quick-tx">客户沟通</span>
      </div>
      <div class="quick-item" @click="router.push('/customers')">
        <span class="quick-ic">👥</span>
        <span class="quick-tx">客户管理</span>
      </div>
    </div>

    <!-- ④ 两栏布局 -->
    <div class="two-col">
      <!-- 左栏 -->
      <div class="col-left panel">
        <div class="tab-bar">
          <div
            class="tab"
            :class="{ active: activeTab === 'todo' }"
            @click="activeTab = 'todo'"
          >📩 待回复</div>
          <div
            class="tab"
            :class="{ active: activeTab === 'recent' }"
            @click="activeTab = 'recent'"
          >⏰ 待跟进</div>
        </div>

        <div class="tab-body" v-if="activeTab === 'todo'">
          <template v-if="statsLoading">
            <div class="loading-state">⏳ 加载中…</div>
          </template>
          <template v-else-if="statsError">
            <div class="error-state" @click="loadAll">⚠️ 加载失败，点击重试</div>
          </template>
          <template v-else-if="todoList.length === 0">
            <div class="empty-state">
              <div class="empty-ic">✅</div>
              <div class="empty-tx">暂无待回复客户，真棒！</div>
            </div>
          </template>
          <template v-else>
            <div
              v-for="c in todoList"
              :key="c.jid"
              class="cust-row"
              @click="goChatJid(c.jid)"
            >
              <div class="avatar" :class="'av-' + (c.followupLevel || 'normal')">
                {{ (c.name || '?').slice(0, 1).toUpperCase() }}
              </div>
              <div class="cust-main">
                <div class="cust-top">
                  <span class="cust-name">{{ c.name }}</span>
                  <span class="cust-time">{{ formatTime(c.lastMessageTime) }}</span>
                </div>
                <div class="cust-msg">{{ c.lastMessage || '（无消息）' }}</div>
              </div>
              <div class="cust-side">
                <span class="tag" :class="'tag-' + c.followupLevel">
                  {{ levelLabel(c.followupLevel) }}
                </span>
                <button
                  class="mini-btn"
                  @click.stop="goChatJid(c.jid)"
                >{{ c.followupLevel === 'followup' ? '去跟进' : '去回复' }}</button>
              </div>
            </div>
          </template>
        </div>

        <div class="tab-body" v-else>
          <template v-if="statsLoading">
            <div class="loading-state">⏳ 加载中…</div>
          </template>
          <template v-else-if="statsError">
            <div class="error-state" @click="loadAll">⚠️ 加载失败，点击重试</div>
          </template>
          <template v-else-if="(stats.followup?.length || 0) === 0">
            <div class="empty-state">
              <div class="empty-ic">✅</div>
              <div class="empty-tx">暂无待跟进客户</div>
            </div>
          </template>
          <template v-else>
            <div
              v-for="c in stats.followup"
              :key="c.jid"
              class="cust-row"
              @click="goChatJid(c.jid)"
            >
              <div class="avatar" :class="'av-' + (c.followupLevel || 'followup')">
                {{ (c.name || '?').slice(0, 1).toUpperCase() }}
              </div>
              <div class="cust-main">
                <div class="cust-top">
                  <span class="cust-name">{{ c.name }}</span>
                  <span class="cust-time">{{ formatTime(c.lastMessageTime) }}</span>
                </div>
                <div class="cust-msg">
                  <span class="dir-tx">↗ 我：</span>
                  {{ c.lastMessage || '（无消息）' }}
                </div>
                <div class="cust-meta" v-if="c.hoursSinceLastMsg">
                  {{ Math.floor(c.hoursSinceLastMsg / 24) }}天未回复
                </div>
              </div>
              <div class="cust-side">
                <span class="tag tag-followup">待跟进</span>
                <button
                  class="mini-btn"
                  @click.stop="goChatJid(c.jid)"
                >去跟进</button>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- 右栏 -->
      <div class="col-right">
        <div class="panel">
          <div class="panel-title">📊 数据概览</div>
          <div class="kpi-grid">
            <div class="kpi-cell">
              <div class="kpi-label">👤 客户总数</div>
              <div class="kpi-value">{{ statsLoading ? '…' : stats.totalCustomers ?? 0 }}</div>
            </div>
            <div class="kpi-cell">
              <div class="kpi-label">💬 消息总数</div>
              <div class="kpi-value">{{ statsLoading ? '…' : formatNum(stats.totalMessages) }}</div>
            </div>
            <div class="kpi-cell">
              <div class="kpi-label">📊 本周消息</div>
              <div class="kpi-value">{{ statsLoading ? '…' : formatNum(stats.weekMessages) }}</div>
            </div>
            <div class="kpi-cell">
              <div class="kpi-label">⏱️ 平均响应</div>
              <div class="kpi-value">
                <template v-if="statsLoading">…</template>
                <template v-else-if="stats.avgResponseMinutes == null">暂无数据</template>
                <template v-else>{{ stats.avgResponseMinutes }}<span class="unit">分钟</span></template>
              </div>
            </div>
          </div>
        </div>

        <div class="panel tips-panel">
          <div class="panel-title">💡 今日建议</div>
          <ul class="tips-list">
            <li v-if="((stats.pending?.length || stats.urgent?.length || 0)) > 0">
              📩 有 <b>{{ (stats.pending?.length || stats.urgent?.length || 0) }}</b> 位客户发了消息等待您回复，优先处理。
            </li>
            <li v-if="(stats.followup?.length || 0) > 0">
              ⏰ 有 <b>{{ stats.followup.length }}</b> 位客户超 3 天未回复，建议主动跟进。
            </li>
            <li v-if="!statsLoading && pendingTotal === 0">
              ✅ 所有客户都已跟进，做得漂亮！
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { useRouter } from 'vue-router'
import api from '../utils/api.js'
import { useAuthStore } from '../stores/auth.js'

const router = useRouter()
const authStore = useAuthStore()

const username = computed(() => authStore.user?.name || authStore.user?.username || '销售')

const stats = ref({})
const statsLoading = ref(true)
const statsError = ref(false)

const conversations = ref([])
const convLoading = ref(true)
const convError = ref(false)

const activeTab = ref('todo')
let refreshTimer = null

const pendingTotal = computed(() => {
  if (statsLoading.value) return 0
  const pending = stats.value.pending?.length ?? stats.value.urgent?.length ?? 0
  return pending + (stats.value.followup?.length || 0)
})

const todoList = computed(() => {
  if (activeTab.value === 'todo') {
    // 待回复 tab：pending（最后一条是 inbound 未回）
    const pendingArr = stats.value.pending || stats.value.urgent || []
    return pendingArr.map(x => ({ ...x, followupLevel: 'pending' }))
  } else {
    // 待跟进 tab：followup（最后一条 outbound 超 72h）
    return (stats.value.followup || []).map(x => ({ ...x, followupLevel: 'followup' }))
  }
})

async function loadStats() {
  statsError.value = false
  try {
    const { data } = await api.get('/dashboard/stats')
    stats.value = data || {}
  } catch (e) {
    statsError.value = true
    console.error('[Dashboard] stats error:', e?.message || e)
  } finally {
    statsLoading.value = false
  }
}

async function loadConversations() {
  convError.value = false
  try {
    const { data } = await api.get('/whatsapp/conversations?limit=20')
    conversations.value = Array.isArray(data) ? data : []
  } catch (e) {
    convError.value = true
    console.error('[Dashboard] conversations error:', e?.message || e)
  } finally {
    convLoading.value = false
  }
}

async function loadAll() {
  statsLoading.value = true
  convLoading.value = true
  await Promise.all([loadStats(), loadConversations()])
}

function goChat(filter) {
  // 若该分类只有1个客户，直接跳到该客户聊天；多个则带filter跳列表
  const q = {}
  if (filter) {
    const arr = stats.value?.[filter]
    if (Array.isArray(arr) && arr.length === 1 && arr[0]?.jid) {
      q.jid = arr[0].jid
    } else if (arr && arr.length > 0) {
      q.filter = filter
    } else {
      // 空列表也跳chat，不带筛选
    }
  }
  router.push({ path: '/chat', query: q })
}

function goChatJid(jid) {
  router.push({ path: '/chat', query: { jid } })
}

function levelLabel(level) {
  if (level === 'pending') return '待回复'
  if (level === 'followup') return '待跟进'
  return ''
}

function formatTime(t) {
  if (!t) return ''
  const d = new Date(t)
  if (isNaN(d.getTime())) return ''
  const now = new Date()
  const sameDay = d.toDateString() === now.toDateString()
  const pad = n => String(n).padStart(2, '0')
  if (sameDay) return `${pad(d.getHours())}:${pad(d.getMinutes())}`
  const yesterday = new Date(now.getTime() - 86400000)
  if (d.toDateString() === yesterday.toDateString()) return '昨天'
  return `${d.getMonth() + 1}/${d.getDate()}`
}

function formatNum(n) {
  if (n == null) return 0
  if (n >= 10000) return (n / 10000).toFixed(1) + 'w'
  if (n >= 1000) return (n / 1000).toFixed(1) + 'k'
  return n
}

onMounted(async () => {
  authStore.checkAuth?.()
  await loadAll()
  refreshTimer = setInterval(loadAll, 30000)
})

onUnmounted(() => {
  if (refreshTimer) clearInterval(refreshTimer)
})
</script>

<style scoped>

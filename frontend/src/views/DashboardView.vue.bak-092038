  .welcome-sub .hl { color: var(--danger); font-weight: 700; }
  .wave { font-size: 22px; }
  .username { color: var(--accent); }
  .primary-btn {
    width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 10px;
    padding: 10px; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 10px;
  }
  .stat-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 8px !important;
    margin-bottom: 10px !important;

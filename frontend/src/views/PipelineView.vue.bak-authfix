  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8px;
  margin-bottom: 16px;
}
.pipe-pc-tab {
  background: var(--mgmt-card);
  border: 1px solid var(--mgmt-border);
  border-radius: 8px;
  padding: 10px 12px;
  cursor: pointer;
  border-top: 3px solid transparent;
  transition: all .2s;
}

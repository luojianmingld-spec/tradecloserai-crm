}
.ppt-bar {
  height: 4px;
  background: var(--mgmt-border);
  border-radius: 2px;
  overflow: hidden;
}
.ppt-bar-fill { height: 100%; border-radius: 2px; transition: width .4s; }

/* 客户卡 */
.pipe-list { display: flex; flex-direction: column; gap: 8px; }
.pipe-empty, .pipe-empty-stage {
  text-align: center;
  padding: 48px 20px;
  color: var(--mgmt-text-secondary);
  font-size: 14px;
}
.pes-icon { font-size: 36px; display: block; margin-bottom: 8px; opacity: .5; }

.pipe-card {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--mgmt-card);
  border: 1px solid var(--mgmt-border);
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
  transition: all .15s;
}
.pipe-card:active { transform: scale(.98); }
.pc-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 600;
  font-size: 16px;
  flex-shrink: 0;
}
.pc-body { flex: 1; min-width: 0; }
.pc-row1 { display: flex; align-items: center; gap: 6px; }
.pc-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--mgmt-text);
  overflow: hidden;

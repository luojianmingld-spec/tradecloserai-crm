  white-space: nowrap;
}
.pc-row3 {
  display: flex;
  gap: 10px;
  font-size: 11px;
  color: var(--mgmt-text-muted);
  margin-top: 4px;
  flex-wrap: wrap;
}
.pc-value { color: #f59e0b; font-weight: 600; }
.pc-stage-btn {
  background: var(--mgmt-primary, #25d366);
  color: #fff;

  background: rgba(0,0,0,.1);
  border-radius: 10px;
  padding: 0 7px;
  font-size: 11px;
  font-weight: 600;
  min-width: 20px;
  text-align: center;
}
.pipe-tab.active .pt-count { background: rgba(255,255,255,.25); }
.pt-count.urgent { background: #ef4444; color: #fff; animation: pulse 1.5s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.6} }

/* PC端Tab */

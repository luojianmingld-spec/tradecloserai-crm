  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 12px;
  border-radius: 20px;
  background: var(--mgmt-card);
  border: 1.5px solid var(--mgmt-border);
  font-size: 13px;
  color: var(--mgmt-text-secondary);
  cursor: pointer;
  transition: all .2s;
  white-space: nowrap;
}
.pipe-tab.active {
  background: var(--stage-color);
  border-color: var(--stage-color);
  color: #fff;
}

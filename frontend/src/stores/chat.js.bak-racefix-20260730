import { defineStore } from 'pinia';
import { ref, computed } from 'vue';
import api from '../utils/api.js';
import { useSocket } from '../utils/socket.js';

export const useChatStore = defineStore('chat', () => {
  // WhatsApp Connection
  const connectionStatus = ref('disconnected');
  let followupPollTimer = null; // 跟进提醒轮询timer
  const sessionId = ref(null);
  const connectedPhone = ref(null);
  const qrCode = ref(null);
  const waError = ref(null);
  const pushName = ref(null); // 当前账号昵称
  const ownerJid = ref(null);  // 当前登录账号 jid
  const selfAvatarUrl = ref(null); // 自己的头像 URL（由 /api/wa/avatar 代理）
  const avatarCache = ref({}); // { jid: '/api/wa/avatar?jid=xxx&_t=...' }
  const avatarFailed = ref({}); // { jid: true } 加载失败标记
  const pairingCode = ref(null); // { code, phone }
  const pairingLoading = ref(false);
  const pairingError = ref(null);

  // Conversations
  const conversations = ref([]);
  const activeJid = ref(null);
  const accountFilter = ref(null); // null = all accounts, number = specific WA account id
  function setAccountFilter(id) {
    accountFilter.value = id;
    // Refresh conversations with new filter
    fetchConversations(currentConvFilter.value);
  }

  // Messages
  const messages = ref({});
  const loadingMessages = ref(false);

  // Translation (双向自动翻译设置)
  const DEFAULT_TRANSLATION_SETTINGS = {
    receiveEnabled: true,
    receiveEngine: 'google',
    receiveSourceLang: 'auto',
    receiveTargetLang: 'zh',
    sendEnabled: true,
    sendEngine: 'google',
    sendSourceLang: 'auto',
    sendTargetLang: 'en',
    groupAutoTranslate: false,
    blockChinese: true,
    translateConfirm: false,
    translationColor: '#8696a0',
    translationSize: '14px',
  };
  const translationSettings = ref({ ...DEFAULT_TRANSLATION_SETTINGS });
  const autoTranslateOutgoing = ref(false);

  // ── AI 迷你聊天框状态 ──
  const aiMode = ref(null); // 'reply' | 'summary' | 'profile' | 'translate' | null
  const aiChat = ref([]);
  const aiLoading = ref(false);
  const aiCollapsed = ref(false);
  const aiFocusMessage = ref(null);
  const replyStyle = ref('formal');

  // 新面板专用状态
  const aiReplyResults = ref([]); // [{id, style, styleIcon, styleName, content}]
  const aiSummaryResult = ref(null); // {score, stage, fields, summary}
  const aiProfileResult = ref(null); // 保持为气泡

  // Legacy AI state（兼容旧代码）
  const aiReplies = ref([]);
  const aiGenerating = ref(false);
  const insertText = ref('');
  const needSummary = ref(null);
  const summarizeLoading = ref(false);
const replyTo = ref(null); // { msgId, waMessageId, jid, name, body, fromMe }
const editingMsgId = ref(null); // 正在编辑的消息id


  // ── 跟进提醒系统状态 ──
  const pendingFollowups = ref({ urgent: [], followup: [], reactivate: [], firstResponse: [], total: 0, firstResponseCount: 0 });
  const showFollowupsOnly = ref(false);
  // 5 分钟首响提醒：已在本次页面会话中弹过提醒的 jid 集合，避免重复闪烁/提醒
  const firstResponseAlertedJids = ref(new Set());
  const firstResponseMapByJid = computed(() => {
    const map = {};
    const list = Array.isArray(pendingFollowups.value.firstResponse) ? pendingFollowups.value.firstResponse : [];
    for (const m of list) {
      if (m?.jid) map[m.jid] = m;
    }
    return map;
  });
  const firstResponseAlerts = computed(() =>
    Array.isArray(pendingFollowups.value.firstResponse) ? pendingFollowups.value.firstResponse : []
  );
  const followupMapByJid = computed(() => {
    const map = {};
    for (const m of pendingFollowups.value.urgent) map[m.jid] = 'urgent';
    for (const m of pendingFollowups.value.followup) map[m.jid] = 'followup';
    for (const m of pendingFollowups.value.reactivate) map[m.jid] = 'reactivate';
    return map;
  });
  const followupCounts = computed(() => ({
    urgent: pendingFollowups.value.urgent.length,
    followup: pendingFollowups.value.followup.length,
    reactivate: pendingFollowups.value.reactivate.length,
    firstResponse: pendingFollowups.value.firstResponseCount || 0,
    total: pendingFollowups.value.total,
  }));

  async function fetchPendingFollowups() {
    try {
      const { data } = await api.get('/followups/pending');
      const firstResponse = Array.isArray(data.firstResponse) ? data.firstResponse : [];
      pendingFollowups.value = {
        urgent: Array.isArray(data.urgent) ? data.urgent : [],
        followup: Array.isArray(data.followup) ? data.followup : [],
        reactivate: Array.isArray(data.reactivate) ? data.reactivate : [],
        firstResponse,
        total: data.total || 0,
        firstResponseCount: data.firstResponseCount ?? firstResponse.length,
        generatedAt: data.generatedAt || new Date().toISOString(),
      };
      // 清理已恢复回复的 jid（从 alerted 集合中移除，下次重新超时可再提醒）
      const currentJids = new Set(firstResponse.map(x => x.jid));
      for (const jid of Array.from(firstResponseAlertedJids.value)) {
        if (!currentJids.has(jid)) firstResponseAlertedJids.value.delete(jid);
      }
      return pendingFollowups.value;
    } catch (err) {
      console.error('Failed to fetch pending followups:', err);
      return pendingFollowups.value;
    }
  }

  function toggleFollowupsFilter() {
    showFollowupsOnly.value = !showFollowupsOnly.value;
  }

  function startFollowupPoll() {
    if (followupPollTimer) return; // 已有timer
    fetchPendingFollowups().catch(() => {});
    followupPollTimer = setInterval(() => {
      if (connectionStatus.value === 'connected') {
        fetchPendingFollowups().catch(() => {});
      }
    }, 30000); // 30秒轮询一次
    console.log('[FollowupPoll] started, interval=30s');
  }
  function stopFollowupPoll() {
    if (followupPollTimer) {
      clearInterval(followupPollTimer);
      followupPollTimer = null;
      console.log('[FollowupPoll] stopped');
    }
  }
  function markFirstResponseAlerted(jid) {
    if (jid) firstResponseAlertedJids.value.add(jid);
  }

  // Computed
  const activeConversation = computed(() =>
    conversations.value.find(c => c.jid === activeJid.value)
  );

  const currentMessages = computed(() => {
    if (!activeJid.value) return [];
    return messages.value[activeJid.value] || [];
  });

  const sortedConversations = computed(() => {
    // 后端已按 pinned 优先、时间降序返回，前端只对本地插入的新消息重排
    return [...conversations.value].sort((a, b) => {
      if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
      const tA = a.lastMessageTime ? new Date(a.lastMessageTime).getTime() : 0;
      const tB = b.lastMessageTime ? new Date(b.lastMessageTime).getTime() : 0;
      return tB - tA;
    });
  });

  const isConnected = computed(() => connectionStatus.value === 'connected');

  // ─── Avatar helpers ───
  const SELF_JID_FALLBACK = '8613016242602@s.whatsapp.net';

  function selfJid() {
    return ownerJid.value || SELF_JID_FALLBACK;
  }

  /**
   * 返回会话头像 URL（优先缓存，缓存失败不再重试）。
   * 调用方直接用作 <img :src="chatStore.loadAvatar(jid)"> 即可，
   * onerror 时调用 markAvatarFailed(jid) 回退首字母占位。
   */
  function loadAvatar(jid) {
    if (!jid) return '';
    if (avatarFailed.value[jid]) return '';
    if (avatarCache.value[jid]) return avatarCache.value[jid];
    // 先生成 URL 缓存（带 _t 仅做首次触发，后续复用）
    const url = '/api/wa/avatar?jid=' + encodeURIComponent(jid);
    avatarCache.value[jid] = url;
    return url;
  }

  function markAvatarFailed(jid) {
    if (!jid) return;
    avatarFailed.value[jid] = true;
    delete avatarCache.value[jid];
  }

  function preloadSelfAvatar() {
    const jid = selfJid();
    if (!jid) return;
    // 触发一次 head/GET 由浏览器缓存
    const url = '/api/wa/avatar?jid=' + encodeURIComponent(jid) + '&_t=' + Date.now();
    selfAvatarUrl.value = url;
  }

  // ─── WhatsApp Connection Actions ───

  async function fetchConnectionStatus() {
    try {
      const { data } = await api.get('/whatsapp/status');
      connectionStatus.value = data.status;
      sessionId.value = data.sessionId;
      connectedPhone.value = data.phone || null;
      if (data.pushName) pushName.value = data.pushName;
      if (data.ownerJid) ownerJid.value = data.ownerJid;
      if (data.status === 'connected') {
        qrCode.value = null;
        if (data.profilePicUrl) { /* 不直接用 —— 浏览器有跨域/Referer 问题，走自己代理 */ }
        if (!ownerJid.value) ownerJid.value = (data.phone ? data.phone + '@s.whatsapp.net' : SELF_JID_FALLBACK);
        preloadSelfAvatar();
        startFollowupPoll();
      } else {
        stopFollowupPoll();
      }
      return data;
    } catch (err) {
      console.error('Failed to fetch connection status:', err);
      return null;
    }
  }

  async function requestQR() {
    try {
      qrCode.value = null;
      connectionStatus.value = 'connecting';
      waError.value = null;
      const { data } = await api.post('/whatsapp/qr');
      sessionId.value = data.sessionId;
      if (data.qr) qrCode.value = { qr: data.qr, sessionId: data.sessionId };
      if (data.status === 'connected') {
        connectionStatus.value = 'connected';
        connectedPhone.value = data.phone;
        if (data.pushName) pushName.value = data.pushName;
        if (data.ownerJid) ownerJid.value = data.ownerJid;
        if (!ownerJid.value && data.phone) ownerJid.value = data.phone + '@s.whatsapp.net';
        qrCode.value = null;
        preloadSelfAvatar();
      }
      if (data.status === 'unavailable') {
        connectionStatus.value = 'unavailable';
        waError.value = data.message || 'WhatsApp 库未安装';
      }
      return data;
    } catch (err) {
      console.error('Failed to request QR:', err);
      connectionStatus.value = 'disconnected';
      waError.value = err.response?.data?.error || err.message || '连接失败';
      return null;
    }
  }

  async function requestPairingCode(phone) {
    try {
      pairingLoading.value = true;
      pairingError.value = null;
      pairingCode.value = null;
      // 先确保连接已建立
      if (connectionStatus.value !== 'waiting_qr' && connectionStatus.value !== 'connecting') {
        connectionStatus.value = 'connecting';
        waError.value = null;
        const qrRes = await api.post('/whatsapp/qr');
        sessionId.value = qrRes.data?.sessionId;
        // 等2.5秒让socket建立noise握手
        await new Promise(r => setTimeout(r, 2500));
      }
      const { data } = await api.post('/whatsapp/pairing-code', { phone });
      pairingCode.value = { code: data.code, phone: data.phone };
      return data;
    } catch (err) {
      pairingError.value = err.response?.data?.error || err.message || '获取配对码失败';
      console.error('Failed to request pairing code:', err);
      return null;
    } finally {
      pairingLoading.value = false;
    }
  }

  function clearPairing() {
    pairingCode.value = null;
    pairingError.value = null;
    pairingLoading.value = false;
    stopFollowupPoll();
  }

  async function disconnectWhatsApp() {
    try {
      await api.post('/whatsapp/disconnect');
    } catch (err) { console.error('Failed to disconnect:', err); }
    // 无论 API 成功与否，都清空本地状态
    clearOnDisconnect();
  }

  /**
   * 断开连接时清空所有会话/消息/AI 状态
   */
  function clearOnDisconnect() {
    connectionStatus.value = 'disconnected';
    connectedPhone.value = null;
    pushName.value = null;
    ownerJid.value = null;
    selfAvatarUrl.value = null;
    avatarCache.value = {};
    avatarFailed.value = {};
    qrCode.value = null;
    sessionId.value = null;
    conversations.value = [];
    activeJid.value = null;
    messages.value = {};
    aiMode.value = null;
    aiChat.value = [];
    aiLoading.value = false;
    aiFocusMessage.value = null;
    aiReplyResults.value = [];
    aiSummaryResult.value = null;
    aiProfileResult.value = null;
    aiReplies.value = [];
    aiGenerating.value = false;
    needSummary.value = null;
    insertText.value = '';
    pairingCode.value = null;
    pairingError.value = null;
    pairingLoading.value = false;
    stopFollowupPoll();
  }

  // ─── Conversations Actions ───

  async function fetchConversations(params = {}) {
    try {
      // 默认只拉WA渠道会话，TG有自己的loadTgConversations；传入platform='all'可拉全部
      const reqParams = { platform: 'whatsapp', ...params };
      if (reqParams.platform === 'all') delete reqParams.platform;
      // Multi-WA: pass accountId filter (null = all accounts)
      reqParams.accountId = accountFilter.value != null ? accountFilter.value : 'all';
      const { data } = await api.get('/whatsapp/conversations', { params: reqParams });
      // 前端双保险过滤：按platform字段+jid后缀双重判断，防止后端漏打platform标
      const filtered = (data || []).filter(c => {
        if (reqParams.platform === 'whatsapp') {
          const p = c.platform || (c.jid && c.jid.endsWith('@telegram') ? 'telegram' : 'whatsapp');
          return p === 'whatsapp' && (!c.jid || !c.jid.endsWith('@telegram'));
        }
        if (reqParams.platform === 'telegram') {
          const p = c.platform || (c.jid && c.jid.endsWith('@telegram') ? 'telegram' : 'whatsapp');
          return p === 'telegram';
        }
        return true;
      });
      conversations.value = filtered;
      return data;
    } catch (err) { console.error('Failed to fetch conversations:', err); return []; }
  }

  // ─── 会话操作：置顶 / 特别关注 / 封锁 / 删除 ───
  async function togglePin(jid) {
    try {
      const { data } = await api.post(`/whatsapp/conversations/${encodeURIComponent(jid)}/pin`);
      // 更新本地状态
      const c = conversations.value.find(x => x.jid === jid);
      if (c) c.pinned = data.pinned;
      // 重排序：后端以pinned优先，重新拉取最稳妥
      await fetchConversations(currentConvFilter.value);
      return data;
    } catch (err) { console.error('Pin failed:', err); throw err; }
  }
  async function toggleStar(jid) {
    try {
      const { data } = await api.post(`/whatsapp/conversations/${encodeURIComponent(jid)}/star`);
      const c = conversations.value.find(x => x.jid === jid);
      if (c) c.starred = data.starred;
      // 若在特别关注tab，重新拉取（取消特别关注需移除）
      await fetchConversations(currentConvFilter.value);
      return data;
    } catch (err) { console.error('Star failed:', err); throw err; }
  }
  async function toggleBlock(jid) {
    try {
      const { data } = await api.post(`/whatsapp/conversations/${encodeURIComponent(jid)}/block`);
      // 封锁后从列表移除
      conversations.value = conversations.value.filter(x => x.jid !== jid);
      // 若当前打开的是该会话，退出
      if (activeJid.value === jid) {
        activeJid.value = null;
      }
      return data;
    } catch (err) { console.error('Block failed:', err); throw err; }
  }
  async function deleteConversation(jid) {
    try {
      const { data } = await api.delete(`/whatsapp/conversations/${encodeURIComponent(jid)}`);
      // 删除本地状态
      conversations.value = conversations.value.filter(x => x.jid !== jid);
      if (activeJid.value === jid) {
        activeJid.value = null;
        messages.value[jid] = [];
      } else {
        delete messages.value[jid];
      }
      return data;
    } catch (err) { console.error('Delete conv failed:', err); throw err; }
  }
  const currentConvFilter = ref({}); // 保存当前筛选参数，用于刷新后保持
  function setConvFilter(params) {
    currentConvFilter.value = params || {};
    return fetchConversations(currentConvFilter.value);
  }

  async function fetchMessages(jid, limit = 50, accountId = null) {
    if (!jid) return;
    loadingMessages.value = true;
    try {
      const params = { jid, limit };
      if (accountId) params.accountId = accountId;
      const { data } = await api.get('/whatsapp/messages', { params });
      messages.value[jid] = data.map(normalizeMessage);
    } catch (err) { console.error('Failed to fetch messages:', err); }
    finally { loadingMessages.value = false; }
  }

  function normalizeMessage(msg) {
    const fromJid = (msg.direction === 'inbound' || msg.direction === 'incoming') ? msg.from : msg.to;
    // 规范化translation字段: 统一为{original, translated, sourceLang, targetLang}
    // 约定：
    //   outbound（我方发送）:
    //     气泡正文显示发出的文本（如已翻译则是译文外文，如输入中文+自动翻译开启则body=外文）
    //     虚线译文显示【中文原文】original（方便销售回看中文原意）
    //     若没翻译（translatedMeta=null），不显示虚线译文
    //   inbound（对方发来）:
    //     气泡正文显示原文外文
    //     虚线译文显示【中文翻译】translated
    let translation = msg.translation ?? msg.translated ?? null;
    let sourceLang = msg.sourceLang || null;
    let body = msg.body || msg.content || "";

    // Parse JSON-string translation
    if (typeof translation === "string" && translation.trim()) {
      const st = translation.trim();
      if ((st.startsWith("{") && st.endsWith("}")) || (st.startsWith("[") && st.endsWith("]"))) {
        try { translation = JSON.parse(st); } catch(_) { /* keep as string */ }
      }
    }

    const hasChinese = /[\u4e00-\u9fff]/.test(body);
    const isOutbound = msg.direction === "outbound" || msg.direction === "outgoing" || msg.fromMe === true;

    if (translation && typeof translation === "object") {
      if (!sourceLang && translation.sourceLang) sourceLang = translation.sourceLang;
      // Outbound: if body is the translated foreign text and original is Chinese original → correct as-is
      // If body is Chinese and translation.translated is foreign → swap: body becomes translated foreign, original stays Chinese
      if (isOutbound && hasChinese && translation.translated && !translation.original) {
        translation.original = body;
        body = translation.translated;
      }
      // If translation.original equals body (same language sent, no translation happened), clear translation to avoid duplicate display
      if (translation.original === body && translation.translated === body) {
        translation = null;
      }
      // Outbound: only show dashed line if we have a Chinese translation to show
      if (isOutbound && translation) {
        const hasChineseTranslation = /[\u4e00-\u9fff]/.test(translation.translated || "");
        // If translated is Chinese (back-translation), keep it for display
        if (!hasChineseTranslation && (!translation.original || translation.original === body)) {
          // No Chinese translation and no distinct original, skip display
          translation = null;
        }
      }
      // Inbound: only show dashed line if translated differs from body
      if (!isOutbound && translation && translation.translated === body) {
        translation = null;
      }
    } else if (typeof translation === "string" && translation) {
      // String translation — convert to object
      if (isOutbound && hasChinese) {
        translation = { original: body, translated: translation };
        body = translation.translated;
      } else if (isOutbound) {
        // Outbound non-Chinese body with string translation: treat translated as Chinese reference if it contains Chinese
        if (/[\u4e00-\u9fff]/.test(translation) && translation !== body) {
          translation = { original: body, translated: translation };
        } else {
          translation = null;
        }
      } else {
        translation = { translated: translation };
      }
    } else {
      translation = null;
    }

    const mediaType = msg.type || msg.messageType || 'text';

    // Convert translation object to string for template rendering
    // ChatWindow.vue expects msg.translation as a string:
    //   - outgoing: Chinese original (original field)
    //   - incoming: Chinese translation (translated field)
    if (translation && typeof translation === 'object') {
      translation = isOutbound
        ? (translation.original || translation.translated || null)
        : (translation.translated || translation.original || null);
    }

    return {
      id: msg.id ?? msg.waMessageId ?? Date.now(),
      waMessageId: msg.waMessageId || null,
      jid: msg.jid || fromJid,
      from: msg.from,
      to: msg.to,
      content: body,
      body: body,
      fromMe: isOutbound,
      direction: msg.direction,
      messageType: mediaType,
      type: mediaType,
      timestamp: msg.timestamp,
      translation: translation,
      sourceLang: sourceLang,
      pending: !!msg.pending,
      deliveredAt: msg.deliveredAt || null,
      readAt: msg.readAt || null,
      ackError: msg.ackError || null,
      read: msg.read === true || !!msg.readAt,
      mediaUrl: msg.mediaUrl || null,
      fileName: msg.fileName || null,
      mimeType: msg.mimeType || null,
      fileSize: msg.fileSize || null,
      previewDataUrl: msg.previewDataUrl || null,
    };
  }

  async function sendMessage(jid, text, quoted = null) {
    const tempId = 'tmp-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7);
    const _quoted = quoted || (replyTo.value && replyTo.value.jid === jid ? {
      key: {
        remoteJid: replyTo.value.jid,
        fromMe: !!replyTo.value.fromMe,
        id: replyTo.value.waMessageId || replyTo.value.msgId,
      },
      message: { conversation: (replyTo.value.body || '').substring(0, 200) }
    } : null);
    if (!messages.value[jid]) messages.value[jid] = [];
    const optimistic = {
      id: tempId,
      jid,
      from: 'me',
      to: jid,
      content: text,
      body: text,
      fromMe: true,
      direction: 'outbound',
      messageType: 'text',
      timestamp: new Date(),
      pending: true,
      deliveredAt: null,
      readAt: null,
      ackError: null,
      read: false,
    };
    messages.value[jid].push(optimistic);
    let conv = conversations.value.find(c => c.jid === jid);
    if (conv) {
      conv.lastMessage = text.substring(0, 100);
      conv.lastMessageTime = optimistic.timestamp;
    }
    try {
      const sendPayload = { to: jid, message: text, quoted: _quoted || undefined };
      if (accountFilter.value != null) sendPayload.accountId = accountFilter.value;
      const { data } = await api.post('/whatsapp/send', sendPayload);
      // 发送成功后立刻更新乐观消息（不等socket）：译文覆盖body、translation带原文
      const list = messages.value[jid];
      if (list) {
        const idx = list.findIndex(x => x.id === tempId);
        if (idx >= 0) {
          const oldM = list[idx];
          let transObj = oldM.translation || null;
          if (data.translation) {
            transObj = typeof data.translation === 'string'
              ? { original: text, translated: data.translation, sourceLang: 'zh', targetLang: 'en' }
              : data.translation;
          }
          const bodyText = transObj?.translated || text;
          list.splice(idx, 1, {
            ...oldM,
            savedId: data.savedId || oldM.savedId,
            waMessageId: data.messageId || (data.key?.id) || oldM.waMessageId,
            pending: false,
            deliveredAt: oldM.deliveredAt || null,
            readAt: oldM.readAt || null,
            ackError: oldM.ackError || null,
            read: false,
            content: bodyText,
            body: bodyText,
            translation: transObj,

  // 前端图片压缩：超过1MB的图片自动压缩（Canvas→JPEG/WebP），减少上传超时
  async function compressImage(file, maxSizeMB = 1, maxDim = 1600, quality = 0.82) {
    if (!file.type || !file.type.startsWith('image/')) return file;
    if (file.size <= maxSizeMB * 1024 * 1024) return file;
    // GIF不压缩（动图）
    if (file.type === 'image/gif') return file;
    try {
      const imgBitmap = await createImageBitmap(file);
      let { width, height } = imgBitmap;
      const scale = Math.min(1, maxDim / Math.max(width, height));
      width = Math.round(width * scale);
      height = Math.round(height * scale);
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(imgBitmap, 0, 0, width, height);
      const outType = file.type === 'image/png' ? 'image/jpeg' : file.type;
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, outType, quality));
      if (!blob || blob.size >= file.size) return file; // 压缩后更大就用原图
      const ext = outType === 'image/jpeg' ? 'jpg' : outType.split('/')[1];
      const name = (file.name || 'image').replace(/\.[^.]+$/, '') + '.' + ext;
      return new File([blob], name, { type: outType });
    } catch(e) {
      console.warn('Image compress failed, using original:', e);
      return file;
    }
  }

  async function sendMedia(jid, file, mediatype, caption = '') {
    const isVideo = mediatype === 'video' || (file.type && file.type.startsWith('video/'));

  // 解析 <foreign>...</foreign><zh>...</zh> 双语标签，拆成 segments 数组
  function parseBilingualContent(text) {
    if (!text || typeof text !== 'string') return { plain: text || '', segments: null };
    const reg = /<foreign>([\s\S]*?)<\/foreign>\s*<zh>([\s\S]*?)<\/zh>/g;
    const segs = [];
    let lastEnd = 0;
    let m;
    let any = false;
    while ((m = reg.exec(text)) !== null) {
      any = true;
      if (m.index > lastEnd) {
        const t = text.slice(lastEnd, m.index).trim();
        if (t) segs.push({ type: 'text', text: t });
      }
      segs.push({ type: 'bilingual', foreign: m[1].trim(), zh: m[2].trim() });
      lastEnd = reg.lastIndex;
    }
    if (!any) return { plain: text, segments: null };
    const tail = text.slice(lastEnd).trim();
    if (tail) segs.push({ type: 'text', text: tail });
    return { plain: '', segments: segs };
  }


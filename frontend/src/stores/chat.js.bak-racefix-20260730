        reader.onload = () => resolve(reader.result);
        reader.onerror = () => resolve(null);
        reader.readAsDataURL(file);
      });
    }
    const bodyText = caption || file.name || (isImage ? '[图片]' : isVideo ? '[视频]' : '[文件]');

    const optimistic = {
      id: tempId,

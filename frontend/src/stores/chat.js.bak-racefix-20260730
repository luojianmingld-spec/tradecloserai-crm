        const patch = { pending: false };
        if (status === 'delivered') {
          patch.deliveredAt = m.deliveredAt || ts;
        } else if (status === 'read') {
          patch.deliveredAt = m.deliveredAt || ts;
          patch.readAt = ts;
          patch.read = true;
        } else if (status === 'error') {
          patch.ackError = 'error';
        }
        newList[idx] = { ...m, ...patch };
        messages.value[jid] = newList;
        break;
      }
    }

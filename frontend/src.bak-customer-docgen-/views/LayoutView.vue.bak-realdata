}
.ai-mini-cards {
  flex: 1; overflow-y: auto; padding: 10px;
  display: flex; flex-direction: column; gap: 8px;
}
.ai-suggest-card {
  background: #202c33; border-radius: 8px; padding: 10px;
  font-size: 12px; color: #d1d7db; line-height: 1.5;
  border-left: 3px solid #00a884;
}
.sc-use {
  margin-top: 8px; background: #00a88430;
  border: 1px solid #00a884; color: #00a884;
  padding: 4px 10px; border-radius: 4px;
  font-size: 11px; cursor: pointer;
}
.sc-use:hover { background: #00a884; color: #fff; }

/* ⑦ 功能切换栏 */
.col-functools {
  width: 44px; background: #202c33;
  display: flex; flex-direction: column; align-items: center;
  padding: 10px 0; gap: 4px;
  flex-shrink: 0; border-left: 1px solid #222d34;
}
.ft-btn {
  width: 34px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  background: none; border: none; color: #8696a0;
  border-radius: 6px; cursor: pointer;
  font-size: 16px; position: relative; transition: all 0.15s;
}
.ft-btn:hover { background: #364147; color: #e9edef; }
.ft-btn.active { background: #00a88430; color: #00a884; }

/* ========== 设置全屏弹窗 ========== */
.settings-modal {
  position: fixed; inset: 0; background: rgba(0,0,0,0.6);
  z-index: 1000; display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
.settings-dialog {
  width: 90%; max-width: 1000px; height: 80vh;
  background: #111b21; border-radius: 12px;
  display: flex; overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.settings-sidebar {
  width: 220px; background: #202c33;
  padding: 20px 0; display: flex; flex-direction: column; flex-shrink: 0;
}
.settings-title {
  font-size: 18px; font-weight: 700;
  padding: 0 20px 16px; color: #e9edef;
  border-bottom: 1px solid #222d34; margin-bottom: 8px;
}
.settings-nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 20px; cursor: pointer;
  color: #8696a0; font-size: 13px; transition: all 0.15s;
}
.settings-nav-item:hover { background: #2a3942; color: #e9edef; }
.settings-nav-item.active { background: #00a88430; color: #00a884; }
.settings-close {
  margin-top: auto; margin: auto 20px 0; padding: 8px;
  background: none; border: 1px solid #364147;
  color: #8696a0; border-radius: 6px; cursor: pointer; font-size: 13px;
}
.settings-close:hover { background: #ea433520; color: #ea4335; border-color: #ea4335; }
.settings-content { flex: 1; padding: 24px; overflow-y: auto; }
.settings-placeholder h2 { color: #e9edef; margin-bottom: 8px; }
.settings-placeholder p { color: #8696a0; }

/* ========== 动画 ========== */
.fade-enter-active, .fade-leave-active { transition: opacity 0.2s; }
.fade-enter-from, .fade-leave-to { opacity: 0; }

/* ========== 移动端 ========== */
.mobile-tabbar { display: none; }
.mobile-ai-fab { display: none; }
.mobile-header { display: none; }
.mobile-overlay { display: none; }

@media (max-width: 768px) {
  html, body, #app { height: 100%; overflow: hidden; }

  .crm-layout { flex-direction: column; height: 100vh; }

  /* 移动端顶部栏 */
  .mobile-header {
    display: flex; align-items: center; gap: 8px;
    height: 52px; padding: 0 12px;
    background: #202c33; border-bottom: 1px solid #222d34;
    flex-shrink: 0; z-index: 50; position: relative;
  }
  .mh-btn {
    width: 40px; height: 40px; display: flex;
    align-items: center; justify-content: center;
    background: none; border: none; color: #e9edef;
    cursor: pointer; border-radius: 50%;
  }
  .mh-btn:active { background: #2a3942; }
  .mh-title {
    flex: 1; font-size: 16px; font-weight: 600;
    color: #e9edef; text-align: left; padding-left: 4px;
  }

  /* 遮罩 */
  .mobile-overlay {
    display: block; position: fixed; inset: 0;
    background: rgba(0,0,0,0.5); z-index: 25;
  }

  .platform-nav { display: none; }
  .workspace {
    flex: 1; min-height: 0; position: relative;
    overflow: hidden; height: 0; /* 让flex:1实际控制高度 */
  }
  .workspace.has-mheader { /* 配合mobile-header占高度 */ }
  .comm-module {
    position: relative; width: 100%; height: 100%;
    overflow: hidden;
  }

  /* ② 账号栏 - 左侧抽屉 */
  .col-accounts {
    position: absolute !important; left: 0; top: 0; bottom: 0;
    z-index: 35; width: 82vw !important; max-width: 320px !important;
    transform: translateX(-100%);
    transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 2px 0 16px rgba(0,0,0,0.4);
  }
  .col-accounts.collapsed {
    transform: translateX(-100%) !important; width: 82vw !important;
  }
  .col-accounts.m-open { transform: translateX(0) !important; }

  /* ③ 状态栏隐藏 */
  .col-status { display: none !important; width: 0 !important; }

  /* ④ 聊天列表 - 默认全宽，进入对话时隐藏 */
  .col-chatlist {
    width: 100% !important; max-width: none !important;
    border-right: none !important; position: relative;
    transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
  }
  .col-chatlist.collapsed { width: 0 !important; overflow: hidden; }
  .col-chatlist.m-hidden { transform: translateX(-100%); }

  /* ⑤ 对话主区 - 右侧滑入 */
  .col-conversation {
    position: absolute !important; left: 0; right: 0; top: 0; bottom: 0;
    z-index: 45; background: #0b141a;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
    display: flex !important; flex-direction: column !important;
  }
  .col-conversation.m-in { transform: translateX(0) !important; }
  /* 对话页内部要撑满 */
  .col-conversation > * { height: 100%; }

  /* ⑥ ⑦ 功能栏隐藏 */
  .col-functools { display: none !important; }
  .col-aipanel { display: none !important; }

  .mobile-tabbar {
    display: flex; height: 56px;
    background: #202c33; border-top: 1px solid #222d34;
    flex-shrink: 0; z-index: 50;
  }
  .m-tab {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 2px;
    background: none; border: none; color: #8696a0;
    font-size: 10px; cursor: pointer;
  }
  .m-tab.active { color: #00a884; }

  .mobile-ai-fab {
    display: flex; position: fixed;
    right: 16px; bottom: 72px;
    width: 52px; height: 52px; border-radius: 50%;
    background: #00a884; color: #fff; border: none;
    align-items: center; justify-content: center;
    font-size: 24px; box-shadow: 0 4px 16px rgba(0,168,132,0.4);
    cursor: pointer; z-index: 60;
  }

  .settings-dialog { width: 100%; height: 100%; max-width: none; border-radius: 0; }

  /* 账号栏/聊天列表内部滚动适配 */
  .col-accounts, .col-chatlist { height: 100%; }
  .comm-module { display: flex; }

  /* 隐藏桌面端折叠按钮（手机端用顶部汉堡/返回） */
  .col-accounts .col-header .col-toggle,
  .col-status .col-header .col-toggle,
  .col-chatlist .col-header .col-toggle,
  .col-aipanel .col-header .col-toggle,
  .col-functools { display: none !important; }

  /* 手机端account栏col-header标题显示 */
  .col-accounts .col-header .col-title { display: block !important; }

  /* 确保col-header在手机端能看到 */
  .col-accounts .col-header { justify-content: space-between !important; padding: 10px 12px !important; }
  .col-chatlist .col-header { padding: 8px 10px !important; }

  /* 搜索框在手机端适配 */
  .col-chatlist .search-box { flex: 1; }

  /* AI面板在手机端改为浮层 */
  .col-aipanel.m-panel {
    display: flex !important; position: fixed;
    right: 0; top: 52px; bottom: 56px; width: 86vw !important;
    max-width: 360px; z-index: 55;
    transform: translateX(100%); transition: transform 0.28s;
    box-shadow: -2px 0 16px rgba(0,0,0,0.4);
  }
  .col-aipanel.m-panel.show { transform: translateX(0); }
}

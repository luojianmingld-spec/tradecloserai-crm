<template>
  <div class="crm-layout" :class="{ 'platform-collapsed': platformCollapsed, 'mobile-view': isMobile }">
    <!-- ① 平台导航栏 -->
    <aside class="platform-nav">
      <div class="platform-nav-top">
        <div class="logo-wrap" @click="router.push('/')">
          <span class="logo-icon">🤖</span>
          <transition name="fade">
            <span v-if="!platformCollapsed" class="logo-text">TradeAgent</span>
          </transition>
        </div>
        <nav class="platform-menu">
          <div
            v-for="item in platformItems"
            :key="item.key"
            class="platform-item"
            :class="{ active: isPlatformActive(item.key) }"
            @click="switchPlatform(item)"
          >
            <span class="p-icon" v-html="item.icon"></span>
            <transition name="fade">
              <span v-if="!platformCollapsed" class="p-label">{{ item.label }}</span>
            </transition>
            <span v-if="item.badge && !platformCollapsed" class="p-badge">{{ item.badge }}</span>
            <div v-if="platformCollapsed" class="p-tooltip">{{ item.label }}</div>
          </div>
        </nav>
      </div>

      <div class="platform-nav-bottom">
        <div class="wa-status-mini" :class="waStatus">
          <span class="status-dot"></span>
          <transition name="fade">
            <span v-if="!platformCollapsed" class="status-label">{{ waStatusText }}</span>
          </transition>
          <div v-if="platformCollapsed" class="p-tooltip">{{ waStatusText }}</div>
        </div>
        <button class="p-setting" @click="showSettings = true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
            <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94 0 .31.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
          </svg>
          <transition name="fade">
            <span v-if="!platformCollapsed">设置</span>
          </transition>
          <div v-if="platformCollapsed" class="p-tooltip">设置</div>
        </button>
        <button class="p-collapse" @click="togglePlatform">
          <svg v-if="!platformCollapsed" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
          <svg v-else viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
        <button class="p-logout" @click="handleLogout">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
          </svg>
          <transition name="fade">
            <span v-if="!platformCollapsed">退出</span>
          </transition>
          <div v-if="platformCollapsed" class="p-tooltip">退出登录</div>
        </button>
      </div>
    </aside>

    <!-- 移动端遮罩（账号抽屉打开、进入对话、AI面板打开时显示） -->
    <div
      class="mobile-overlay"
      v-if="isMobile && (mobileAccountsOpen || mobileInConv || mobileAIOpen)"
      @click="mobileAccountsOpen = false; mobileInConv = false; mobileAIOpen = false;"
    ></div>

    <!-- 移动端顶部栏 -->
    <header class="mobile-header" v-if="isMobile && activePlatform === 'communication'">
      <button class="mh-btn" v-if="!mobileInConv" @click="mobileAccountsOpen = !mobileAccountsOpen">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
      </button>
      <button class="mh-btn" v-else @click="mobileInConv = false">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <div class="mh-title">
        <template v-if="mobileInConv">
          {{ conversations.find(c => c.id === activeConv)?.name || '对话' }}
        </template>
        <template v-else>{{ currentChannel.name }}</template>
      </div>
      <button class="mh-btn" v-if="mobileInConv" @click="mobileAIOpen = !mobileAIOpen">
        🤖
      </button>
    </header>

    <!-- 工作区 -->
    <div class="workspace" :class="{ 'has-mheader': isMobile && activePlatform === 'communication' }">
      <!-- 沟通模块 -->
      <div v-if="activePlatform === 'communication'" class="comm-module">
        <!-- ② 账号/渠道栏 -->
        <aside class="col-accounts" :class="{ collapsed: !isMobile && accountsCollapsed, 'm-open': isMobile && mobileAccountsOpen }">
          <div class="col-header">
            <span v-if="!accountsCollapsed" class="col-title">沟通渠道</span>
            <button class="col-toggle" @click="accountsCollapsed = !accountsCollapsed" :title="accountsCollapsed ? '展开' : '收起'">
              <svg v-if="accountsCollapsed" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
              <svg v-else viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
          </div>

          <template v-if="!accountsCollapsed">
            <!-- 渠道下拉选择器 -->
            <div class="channel-selector">
              <button class="ch-select-btn" @click="channelDropdown = !channelDropdown">
                <span class="ch-select-icon" v-html="currentChannel.icon"></span>
                <span class="ch-select-name">{{ currentChannel.name }}</span>
                <span v-if="currentChannel.unread" class="ch-unread">{{ currentChannel.unread }}</span>
                <svg class="ch-select-arrow" :class="{ open: channelDropdown }" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
              </button>
              <div class="ch-dropdown" v-if="channelDropdown">
                <div
                  v-for="ch in channels"
                  :key="ch.id"
                  class="ch-dd-item"
                  :class="{ active: activeChannel === ch.id, [ch.status]: true }"
                  @click="selectChannel(ch.id)"
                >
                  <span v-html="ch.icon"></span>
                  <span>{{ ch.name }}</span>
                  <span v-if="ch.unread" class="ch-unread">{{ ch.unread }}</span>
                  <span v-if="activeChannel === ch.id" class="ch-check">✓</span>
                </div>
                <div class="ch-dd-divider"></div>
                <button class="ch-dd-add" @click="channelDropdown = false">
                  <span class="ch-add-icon">+</span>
                  <span>添加渠道</span>
                </button>
              </div>
            </div>

            <!-- 添加账号 -->
            <button class="add-account-btn">
              <span class="add-icon">+</span>
              <span>添加账号</span>
            </button>

            <!-- 账号列表 -->
            <div class="account-list">
              <div
                v-for="acc in currentChannelAccounts"
                :key="acc.id"
                class="account-card"
                :class="{ active: activeAccount === acc.id, [acc.status]: true }"
                @click="activeAccount = acc.id"
              >
                <div class="acc-avatar" :style="{background: acc.color}">
                  {{ acc.name[0] }}
                  <span class="acc-online-dot" v-if="acc.status === 'online'"></span>
                </div>
                <div class="acc-info">
                  <div class="acc-name">{{ acc.name }}</div>
                  <div class="acc-meta">{{ acc.phone || acc.email }}</div>
                </div>
              </div>
            </div>
          </template>

          <!-- 折叠态：图标竖排 -->
          <div class="channel-icons" v-else>
            <div
              v-for="ch in channels"
              :key="ch.id"
              class="ch-icon-btn"
              :class="{ active: activeChannel === ch.id, [ch.status]: true }"
              @click="activeChannel = ch.id"
              :title="ch.name"
            >
              <span v-html="ch.icon"></span>
              <span v-if="ch.unread" class="ch-icon-badge">{{ ch.unread }}</span>
              <div class="p-tooltip">{{ ch.name }}</div>
            </div>
            <button class="ch-icon-add" title="添加渠道">+</button>
          </div>
        </aside>

        <!-- ③ 渠道状态栏 -->
        <aside class="col-status" :class="{ collapsed: statusCollapsed }">
          <div class="col-header">
            <button class="col-toggle" @click="statusCollapsed = !statusCollapsed">
              <svg v-if="statusCollapsed" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
            <span v-if="!statusCollapsed" class="col-title">{{ statusColTitle }}</span>
            <button v-if="!statusCollapsed" class="col-toggle" @click="statusCollapsed = true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
          </div>
          <div class="status-body" v-if="!statusCollapsed">
            <template v-if="activeChannel === 'whatsapp'">
              <div class="status-group">
                <div class="status-item active" @click="closeAllPanels">
                  <span>💬</span><span>全部会话</span><span class="si-count">128</span>
                </div>
                <div class="status-item"><span>⭐</span><span>星标消息</span></div>
                <div class="status-item"><span>⏰</span><span>待跟进</span><span class="si-count warn">5</span></div>
                <div class="status-item"><span>👤</span><span>客户</span></div>
              </div>
              <div class="status-group">
                <div class="status-group-title">标签</div>
                <div class="status-item"><span class="tag-dot new"></span>新客户</div>
                <div class="status-item"><span class="tag-dot vip"></span>VIP</div>
                <div class="status-item"><span class="tag-dot hot"></span>意向高</div>
                <div class="status-item"><span class="tag-dot cold"></span>待培育</div>
              </div>
            </template>
            <template v-else-if="activeChannel === 'email'">
              <div class="status-group">
                <div class="status-item active">
                  <span>📥</span><span>收件箱</span><span class="si-count">24</span>
                </div>
                <div class="status-item"><span>⭐</span><span>星标</span></div>
                <div class="status-item"><span>📤</span><span>已发送</span></div>
                <div class="status-item"><span>📝</span><span>草稿</span><span class="si-count warn">2</span></div>
                <div class="status-item"><span>🗑️</span><span>回收站</span></div>
              </div>
            </template>
            <template v-else>
              <div class="status-group">
                <div class="status-item active"><span>💬</span><span>全部消息</span></div>
                <div class="status-item"><span>⭐</span><span>星标</span></div>
              </div>
            </template>
          </div>
        </aside>

        <!-- ④ 聊天列表栏 -->
        <aside class="col-chatlist" :class="{ collapsed: !isMobile && chatlistCollapsed, 'm-hidden': isMobile && mobileInConv }">
          <div class="col-header">
            <button v-if="chatlistCollapsed" class="col-toggle" @click="chatlistCollapsed = false">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
            <template v-else>
              <div class="search-box">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input type="text" placeholder="搜索客户/消息..." />
              </div>
              <button class="col-toggle" @click="chatlistCollapsed = true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
              </button>
            </template>
          </div>
          <div class="chatlist-body" v-if="!chatlistCollapsed">
            <div
              v-for="conv in conversations"
              :key="conv.id"
              class="conv-item"
              :class="{ active: activeConv === conv.id }"
              @click="activeConv = conv.id; if(isMobile) mobileInConv = true;"
            >
              <div class="conv-avatar" :style="{background: conv.color}">
                {{ conv.name[0] }}
                <span class="conv-status-dot" :class="conv.status || 'online'"></span>
              </div>
              <div class="conv-main">
                <div class="conv-row">
                  <span class="conv-name">{{ conv.name }}</span>
                  <span class="conv-time">{{ conv.time }}</span>
                </div>
                <div class="conv-row">
                  <span class="conv-preview">{{ conv.preview }}</span>
                  <span v-if="conv.unread" class="conv-unread">{{ conv.unread }}</span>
                </div>
              </div>
            </div>
          </div>
        </aside>

        <!-- ⑤ 对话主区 -->
        <main class="col-conversation" :class="{ 'm-in': isMobile && mobileInConv }">
          <router-view v-slot="{ Component }">
            <component :is="Component" v-if="Component" />
            <div v-else class="conv-placeholder">
              <div class="ph-icon">💬</div>
              <div class="ph-title">选择一个会话开始沟通</div>
              <div class="ph-desc">WhatsApp、邮箱等多渠道消息统一处理</div>
            </div>
          </router-view>
        </main>

        <!-- ⑥ AI面板 -->
        <aside class="col-aipanel" :class="{ collapsed: !isMobile && aiCollapsed, mini: !isMobile && aiMiniMode, 'm-panel': isMobile, show: isMobile && mobileAIOpen }">
          <div class="col-header">
            <template v-if="!aiCollapsed">
              <div class="ai-tabs">
                <button
                  v-for="tab in aiTabs"
                  :key="tab.key"
                  class="ai-tab"
                  :class="{ active: activeAITab === tab.key }"
                  @click="activeAITab = tab.key"
                  :title="tab.label"
                >
                  <span v-html="tab.icon"></span>
                </button>
              </div>
              <button class="col-toggle ai-mini-toggle" @click="aiMiniMode = !aiMiniMode" :title="aiMiniMode ? '展开AI' : '迷你话术'">
                <svg v-if="aiMiniMode" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
                <svg v-else viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
              </button>
              <button class="col-toggle" @click="aiCollapsed = true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12l-4.58 4.59z"/></svg>
              </button>
            </template>
            <button v-else class="col-toggle" @click="aiCollapsed = false" title="AI助手">
              <span style="font-size:18px">🤖</span>
            </button>
          </div>
          <div class="ai-body" v-if="!aiCollapsed">
            <div v-if="aiMiniMode" class="ai-mini-cards">
              <div class="ai-suggest-card" v-for="(s,i) in aiSuggestions" :key="i" @click="useSuggestion(s)">
                <div class="sc-text">{{ s }}</div>
                <button class="sc-use">一键填入</button>
              </div>
            </div>
            <div v-else class="ai-full">
              <div class="ai-chat-area">
                <div class="ai-msg ai">
                  <div class="ai-msg-avatar">🤖</div>
                  <div class="ai-msg-bubble">
                    你好！我已读取本次会话上下文。<br/>
                    <b>客户概要：</b>美国采购商，询盘钢化玻璃，报价未回复，已跟进3次。<br/>
                    <b>建议话术：</b>提供MOQ和交期信息，附工厂实拍视频。
                  </div>
                </div>
              </div>
              <div class="ai-input-bar">
                <input type="text" placeholder="问AI：翻译/写回复/总结/画像..." />
                <button>➤</button>
              </div>
            </div>
          </div>
        </aside>

        <!-- ⑦ 功能切换栏 -->
        <aside class="col-functools">
          <button
            v-for="ft in funcTools"
            :key="ft.key"
            class="ft-btn"
            :class="{ active: activeFuncTool === ft.key }"
            @click="activeFuncTool = ft.key"
            :title="ft.label"
          >
            <span v-html="ft.icon"></span>
            <div class="p-tooltip right">{{ ft.label }}</div>
          </button>
        </aside>
      </div>

      <!-- 其他模块占位：由 router-view 填充 -->
      <div v-else class="module-full">
        <router-view />
      </div>
    </div>

    <!-- 设置全屏弹窗 -->
    <div class="settings-modal" v-if="showSettings" @click.self="showSettings = false">
      <div class="settings-dialog">
        <div class="settings-sidebar">
          <div class="settings-title">设置</div>
          <div
            v-for="s in settingsTabs"
            :key="s.key"
            class="settings-nav-item"
            :class="{ active: activeSettingsTab === s.key }"
            @click="activeSettingsTab = s.key"
          >
            <span v-html="s.icon"></span>
            <span>{{ s.label }}</span>
          </div>
          <button class="settings-close" @click="showSettings = false">✕ 关闭</button>
        </div>
        <div class="settings-content">
          <div class="settings-placeholder">
            <h2>{{ currentSettingsName }}</h2>
            <p>设置模块开发中...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 移动端底部Tab Bar -->
    <nav class="mobile-tabbar" v-if="isMobile">
      <button
        v-for="tab in mobileTabs"
        :key="tab.key"
        class="m-tab"
        :class="{ active: (tab.key === 'settings' ? showSettings : activePlatform === tab.key) }"
        @click="handleMobileTab(tab)"
      >
        <span v-html="tab.icon"></span>
        <span>{{ tab.label }}</span>
      </button>
    </nav>

    <!-- 移动端AI悬浮按钮 -->
    <button class="mobile-ai-fab" v-if="isMobile && activePlatform === 'communication'" @click="mobileAIOpen = !mobileAIOpen">
      🤖
    </button>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted, watch } from 'vue';
import { useRouter, useRoute } from 'vue-router';
import { useAuthStore } from '../stores/auth.js';

const router = useRouter();
const route = useRoute();
const authStore = useAuthStore();

// ========== 折叠状态 ==========
const platformCollapsed = ref(localStorage.getItem('platform-collapsed') === 'true');
const accountsCollapsed = ref(localStorage.getItem('accounts-collapsed') === 'true');
const statusCollapsed = ref(false);
const chatlistCollapsed = ref(false);
const aiCollapsed = ref(localStorage.getItem('ai-collapsed') === 'true');
const aiMiniMode = ref(false);
const channelDropdown = ref(false);

watch(platformCollapsed, v => localStorage.setItem('platform-collapsed', v));
watch(accountsCollapsed, v => localStorage.setItem('accounts-collapsed', v));
watch(aiCollapsed, v => localStorage.setItem('ai-collapsed', v));

function togglePlatform() { platformCollapsed.value = !platformCollapsed.value; }
function closeAllPanels() { channelDropdown.value = false; }

// 点击外部关闭下拉
function handleDocClick(e) {
  if (!e.target.closest('.channel-selector')) channelDropdown.value = false;
}
onMounted(() => {
  document.addEventListener('click', handleDocClick);
  window.addEventListener('resize', checkMobile);
  checkMobile();
  checkWhatsAppStatus();
  statusTimer = setInterval(checkWhatsAppStatus, 30000);
});
onUnmounted(() => {
  document.removeEventListener('click', handleDocClick);
  window.removeEventListener('resize', checkMobile);
  if (statusTimer) clearInterval(statusTimer);
});

// ========== 平台导航 ==========
const activePlatform = ref('communication');
const showSettings = ref(false);
const activeSettingsTab = ref('account');

const platformItems = [
  { key: 'dashboard', label: '工作台', icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>' },
  { key: 'communication', label: '沟通', icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>', badge: '12' },
  { key: 'customers', label: '客户', icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>' },

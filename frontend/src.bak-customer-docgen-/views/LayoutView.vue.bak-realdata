  border-radius: 50%; background: #364147; font-size: 14px; font-weight: 700;
}

/* 添加账号 */
.add-account-btn {
  margin: 0 10px 8px;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  padding: 10px; background: none;
  border: 1.5px dashed #364147; border-radius: 10px;
  color: #8696a0; cursor: pointer; font-size: 13px;

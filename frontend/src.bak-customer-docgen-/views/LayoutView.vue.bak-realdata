<style scoped>
/* ========== 基础 ========== */
.crm-layout {
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background: #0b141a;
  color: #e9edef;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
}

/* ========== ① 平台导航栏 ========== */
.platform-nav {
  width: 200px;
  background: #111b21;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  border-right: 1px solid #222d34;
  transition: width 0.2s ease;
  z-index: 50;
}
.platform-nav.platform-collapsed { width: 56px; }
.platform-nav-top { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

.logo-wrap {
  display: flex; align-items: center; gap: 10px;
  padding: 14px 14px 10px;
  cursor: pointer; height: 56px;
}
.logo-icon { font-size: 22px; }
.logo-text { font-size: 16px; font-weight: 700; white-space: nowrap; color: #00a884; }

.platform-menu { flex: 1; padding: 4px 6px; overflow-y: auto; }
.platform-item {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 10px; margin: 2px 0;
  border-radius: 8px; color: #8696a0;
  cursor: pointer; transition: all 0.15s;
  position: relative; white-space: nowrap;
}
.platform-item:hover { background: #202c33; color: #e9edef; }
.platform-item.active { background: #00a88420; color: #00a884; }
.platform-collapsed .platform-item { justify-content: center; padding: 10px 0; }
.p-icon { display: flex; flex-shrink: 0; }
.p-label { font-size: 13px; font-weight: 500; }
.p-badge {
  margin-left: auto; background: #00a884; color: #fff;
  font-size: 11px; padding: 1px 7px; border-radius: 10px; font-weight: 600;
}

.platform-nav-bottom {
  border-top: 1px solid #222d34; padding: 8px 6px;
  display: flex; flex-direction: column; gap: 2px;
}
.wa-status-mini {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 10px; font-size: 12px; color: #8696a0;
  border-radius: 6px; cursor: pointer; position: relative;
}
.platform-collapsed .wa-status-mini { justify-content: center; padding: 8px 0; }
.wa-status-mini .status-dot {
  width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: #8696a0;
}
.wa-status-mini.connected .status-dot { background: #00a884; box-shadow: 0 0 6px #00a88480; }
.wa-status-mini.error .status-dot { background: #ea4335; }

.p-setting, .p-collapse, .p-logout {
  display: flex; align-items: center; gap: 12px;
  width: 100%; padding: 9px 10px;
  background: none; border: none; color: #8696a0;
  cursor: pointer; border-radius: 6px; font-size: 13px; transition: all 0.15s;
}
.p-setting:hover, .p-collapse:hover { background: #202c33; color: #e9edef; }
.p-logout:hover { background: #ea433520; color: #ea4335; }
.platform-collapsed .p-setting, .platform-collapsed .p-collapse, .platform-collapsed .p-logout {
  justify-content: center; padding: 9px 0;
}

/* tooltip */
.p-tooltip {
  position: absolute; left: calc(100% + 8px); top: 50%;
  transform: translateY(-50%);
  background: #233138; color: #e9edef;
  padding: 5px 10px; border-radius: 6px; font-size: 12px;
  white-space: nowrap; opacity: 0; pointer-events: none;
  transition: opacity 0.15s; z-index: 1000;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}
.p-tooltip::before {
  content: ''; position: absolute; left: -4px; top: 50%;
  transform: translateY(-50%);
  border: 4px solid transparent; border-right-color: #233138;
}
.p-tooltip.right { left: auto; right: calc(100% + 8px); }
.p-tooltip.right::before {
  left: auto; right: -4px;
  border-right-color: transparent; border-left-color: #233138;
}
.platform-item:hover > .p-tooltip,
.wa-status-mini:hover > .p-tooltip,
.p-setting:hover > .p-tooltip,
.p-logout:hover > .p-tooltip,
.ft-btn:hover > .p-tooltip,
.ch-icon-btn:hover > .p-tooltip { opacity: 1; }
.platform-nav:not(.platform-collapsed) .p-tooltip { display: none; }

/* ========== 工作区 ========== */
.workspace { flex: 1; display: flex; overflow: hidden; min-width: 0; }
.comm-module { flex: 1; display: flex; overflow: hidden; min-width: 0; }
.module-full { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

/* ② 账号/渠道栏 */
.col-accounts {
  width: 240px; background: #111b21;
  border-right: 1px solid #222d34;
  display: flex; flex-direction: column;
  flex-shrink: 0; transition: width 0.2s; overflow: hidden;
}
.col-accounts.collapsed { width: 54px; }

.col-header {
  height: 48px; display: flex; align-items: center;
  padding: 0 10px; border-bottom: 1px solid #222d34;
  gap: 6px; flex-shrink: 0; background: #202c33;
}
.col-title {
  flex: 1; font-size: 13px; font-weight: 600;
  color: #e9edef; white-space: nowrap;
}
.col-toggle {
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  background: none; border: none; color: #8696a0; cursor: pointer;
  border-radius: 6px;
}
.col-toggle:hover { background: #364147; color: #e9edef; }

/* 渠道下拉选择器 */
.channel-selector { padding: 10px; position: relative; }
.ch-select-btn {
  width: 100%; display: flex; align-items: center; gap: 8px;
  padding: 9px 12px; background: #202c33; border: 1.5px solid transparent;
  border-radius: 10px; color: #e9edef; cursor: pointer;
  font-size: 13px; font-weight: 500; transition: all 0.15s;
}
.ch-select-btn:hover { background: #2a3942; border-color: #00a88450; }
.ch-select-icon { display: flex; color: #00a884; }
.ch-select-name { flex: 1; text-align: left; }
.ch-select-arrow {
  color: #8696a0; transition: transform 0.2s;
}
.ch-select-arrow.open { transform: rotate(180deg); }
.ch-unread {
  background: #00a884; color: #fff; font-size: 10px;
  padding: 1px 6px; border-radius: 8px; font-weight: 600;
}

.ch-dropdown {
  position: absolute; top: calc(100% - 4px); left: 10px; right: 10px;
  background: #202c33; border: 1px solid #2a3942;
  border-radius: 10px; padding: 6px;
  z-index: 100; box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  animation: fadeIn 0.15s ease-out;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
.ch-dd-item {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 10px; border-radius: 6px;
  cursor: pointer; font-size: 13px; color: #d1d7db;
  transition: background 0.1s;
}
.ch-dd-item:hover { background: #2a3942; color: #e9edef; }
.ch-dd-item.active { color: #00a884; }
.ch-dd-item svg { color: #8696a0; }
.ch-dd-item.active svg { color: #00a884; }
.ch-check { margin-left: auto; color: #00a884; font-size: 14px; font-weight: 700; }
.ch-dd-divider { height: 1px; background: #2a3942; margin: 4px 0; }
.ch-dd-add {
  display: flex; align-items: center; gap: 10px;
  width: 100%; padding: 9px 10px; background: none;
  border: 1.5px dashed #364147; border-radius: 8px;
  color: #8696a0; cursor: pointer; font-size: 13px;
  transition: all 0.15s;
}
.ch-dd-add:hover { border-color: #00a884; color: #00a884; background: #00a88410; }
.ch-add-icon {
  width: 20px; height: 20px; display: flex;

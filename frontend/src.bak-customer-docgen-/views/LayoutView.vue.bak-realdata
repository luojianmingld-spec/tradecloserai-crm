  width: 42px; height: 42px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 600; font-size: 16px;
  flex-shrink: 0; position: relative;
}
.acc-online-dot {
  position: absolute; right: 0; bottom: 0;
  width: 12px; height: 12px; border-radius: 50%;
  background: #00a884; border: 2px solid #111b21;
}
.account-card.offline .acc-online-dot { background: #667781; }
.acc-info { flex: 1; min-width: 0; }
.acc-name { font-size: 13px; font-weight: 500; color: #e9edef; }
.acc-meta { font-size: 11px; color: #8696a0; margin-top: 2px; }

.channel-icons {
  display: flex; flex-direction: column; align-items: center;
  gap: 8px; padding: 10px 0; flex: 1;
}
.ch-icon-btn {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  background: #202c33; border-radius: 8px;
  color: #8696a0; cursor: pointer; position: relative;
  transition: all 0.15s;
}
.ch-icon-btn:hover { background: #2a3942; color: #e9edef; }
.ch-icon-btn.active { background: #00a88430; color: #00a884; }
.ch-icon-btn.online { box-shadow: inset 0 -3px 0 #00a884; }
.ch-icon-badge {
  position: absolute; top: -3px; right: -3px;
  background: #00a884; color: #fff;
  font-size: 9px; padding: 1px 4px; border-radius: 8px; font-weight: 600;
}
.ch-icon-add {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  background: #202c33; border: 1px dashed #364147;
  color: #8696a0; border-radius: 8px; cursor: pointer; font-size: 20px;
}

/* ③ 状态栏 */
.col-status {
  width: 180px; background: #111b21;
  border-right: 1px solid #222d34;
  display: flex; flex-direction: column;
  flex-shrink: 0; transition: width 0.2s; overflow: hidden;
}
.col-status.collapsed { width: 40px; }
.col-status.collapsed .col-header { justify-content: center; padding: 0 6px; }
.col-status .col-title { font-size: 12px; font-weight: 500; }
.status-body { flex: 1; overflow-y: auto; padding: 8px 0; }
.status-group { margin-bottom: 16px; }
.status-group-title {
  padding: 6px 16px; font-size: 11px; font-weight: 600;
  color: #8696a0; text-transform: uppercase; letter-spacing: 0.5px;
}
.status-item {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 14px; font-size: 13px;
  color: #d1d7db; cursor: pointer; transition: background 0.15s;
}
.status-item:hover { background: #202c33; }
.status-item.active { background: #2a3942; color: #e9edef; }
.si-count {
  margin-left: auto; background: #00a884; color: #fff;
  font-size: 10px; padding: 1px 6px; border-radius: 8px;
}
.si-count.warn { background: #f59e0b; }
.tag-dot { width: 10px; height: 10px; border-radius: 2px; }
.tag-dot.new { background: #00a884; }
.tag-dot.vip { background: #f59e0b; }
.tag-dot.hot { background: #ef4444; }
.tag-dot.cold { background: #6b7280; }

/* ④ 聊天列表 */
.col-chatlist {
  width: 300px; background: #111b21;
  border-right: 1px solid #222d34;
  display: flex; flex-direction: column;
  flex-shrink: 0; transition: width 0.2s; overflow: hidden;
}
.col-chatlist.collapsed { width: 40px; }
.col-chatlist.collapsed .col-header { justify-content: center; padding: 0 6px; }
.search-box {
  flex: 1; display: flex; align-items: center; gap: 8px;
  background: #202c33; padding: 6px 12px; border-radius: 8px;
}
.search-box input {
  flex: 1; background: transparent; border: none;
  color: #e9edef; font-size: 13px; outline: none;
}
.search-box svg { color: #8696a0; flex-shrink: 0; }
.chatlist-body { flex: 1; overflow-y: auto; }
.conv-item {
  display: flex; gap: 10px; padding: 10px 12px;
  cursor: pointer; border-bottom: 1px solid #222d3430;
  transition: background 0.15s;
}
.conv-item:hover { background: #202c33; }
.conv-item.active { background: #2a3942; }
.conv-avatar {
  width: 46px; height: 46px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 600; flex-shrink: 0; position: relative;
}
.conv-status-dot {
  position: absolute; right: 0; bottom: 0;
  width: 12px; height: 12px; border-radius: 50%;
  background: #00a884; border: 2px solid #111b21;
}
.conv-status-dot.offline { background: #667781; }
.conv-main { flex: 1; min-width: 0; }
.conv-row { display: flex; align-items: center; justify-content: space-between; }
.conv-row:last-child { margin-top: 3px; }
.conv-name { font-size: 14px; font-weight: 500; color: #e9edef; }
.conv-time { font-size: 11px; color: #8696a0; flex-shrink: 0; }
.conv-preview {
  font-size: 12px; color: #8696a0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  flex: 1; margin-right: 6px;
}
.conv-unread {
  background: #00a884; color: #fff;
  font-size: 10px; min-width: 18px; height: 18px;
  border-radius: 9px; display: flex; align-items: center; justify-content: center;
  font-weight: 600; padding: 0 5px;
}

/* ⑤ 对话区 */
.col-conversation {
  flex: 1; display: flex; flex-direction: column;
  min-width: 0; background: #0b141a; overflow: hidden;
}
.conv-placeholder {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #8696a0; gap: 8px;
}
.ph-icon { font-size: 64px; opacity: 0.3; }
.ph-title { font-size: 18px; color: #e9edef; }
.ph-desc { font-size: 13px; }

/* ⑥ AI面板 */
.col-aipanel {
  width: 320px; background: #111b21;
  border-left: 1px solid #222d34;
  display: flex; flex-direction: column;
  flex-shrink: 0; transition: width 0.2s; overflow: hidden;
}
.col-aipanel.collapsed {
  width: 44px;
}
.col-aipanel.collapsed .col-header { padding: 10px 6px; justify-content: center; }
.col-aipanel.mini { width: 260px; }
.ai-tabs { flex: 1; display: flex; gap: 2px; overflow-x: auto; }
.ai-tab {
  padding: 6px 7px; background: none; border: none;
  color: #8696a0; cursor: pointer; border-radius: 6px;
  font-size: 15px; transition: all 0.15s; flex-shrink: 0;
}
.ai-tab:hover { background: #2a3942; color: #e9edef; }
.ai-tab.active { background: #00a88430; color: #00a884; }
.ai-mini-toggle { margin-left: 2px; }

.ai-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.ai-full { flex: 1; display: flex; flex-direction: column; }
.ai-chat-area { flex: 1; overflow-y: auto; padding: 12px; }
.ai-msg { display: flex; gap: 8px; margin-bottom: 10px; }
.ai-msg-avatar { font-size: 22px; flex-shrink: 0; }
.ai-msg-bubble {
  background: #202c33; padding: 10px 12px; border-radius: 10px;
  font-size: 13px; line-height: 1.5; color: #e9edef;
  border-top-left-radius: 2px;
}
.ai-msg-bubble b { color: #00a884; }
.ai-input-bar {
  display: flex; gap: 6px; padding: 8px;
  border-top: 1px solid #222d34;
}
.ai-input-bar input {
  flex: 1; background: #2a3942; border: none; color: #e9edef;
  padding: 8px 12px; border-radius: 20px; font-size: 13px; outline: none;
}
.ai-input-bar button {
  width: 34px; height: 34px; border-radius: 50%;

.rp-switch {
  position: relative;
  width: 44px;
  height: 24px;
  flex-shrink: 0;
}

.rp-switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.rp-slider {
  position: absolute;
  cursor: pointer;
  inset: 0;
  background: #3a4555;
  border-radius: 24px;
  transition: 0.3s;
}

.rp-slider::before {
  content: '';
  position: absolute;
  width: 18px;
  height: 18px;
  left: 3px;
  top: 3px;
  background: #fff;
  border-radius: 50%;
  transition: 0.3s;
}

.rp-switch input:checked + .rp-slider {
  background: #22c55e;
}

.rp-switch input:checked + .rp-slider::before {
  transform: translateX(20px);
}

.rp-section {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.rp-section .rp-toggle-row {
  border-radius: 10px 10px 0 0;
}

.rp-fields {
  background: #1a2332;
  border-radius: 0 0 10px 10px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rp-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.rp-field-label {
  font-size: 12px;
  color: #667;
}

.rp-select {
  position: relative;
}

.rp-select select {
  width: 100%;
  padding: 10px 32px 10px 12px;
  background: #253342;
  border: 1px solid #2a3a4a;
  border-radius: 8px;
  color: #e0e0e0;
  font-size: 13px;
  appearance: none;
  cursor: pointer;
  outline: none;
}

.rp-select select:focus {
  border-color: #6c5ce7;
}

.rp-select::after {
  content: '';
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: #667;
  pointer-events: none;
  font-size: 12px;
}
/* ===== Tab System - TradeAgent Style ===== */
.rp-tabs { display: none !important; }

.email-right-panel {
  width: 336px;
  min-width: 336px;
  background: #0f1419;
  border-left: 1px solid #1e2a35;
  display: flex;
  flex-direction: row;
  padding: 0;
  overflow: hidden;
}

.rp-content {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  min-width: 0;
}

.rp-tab-body {
  display: flex;
  flex-direction: column;
}

/* Vertical Icon Bar */
.rp-icon-bar {
  width: 56px;
  min-width: 56px;
  background: #0d1117;
  border-left: 1px solid #1e2a35;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 0;
  gap: 4px;
  flex-shrink: 0;
}

.rp-icon-tab {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: transparent;
  border: none;
  color: #6b7b8d;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  cursor: pointer;
  transition: all 0.15s;
  flex-shrink: 0;
}

.rp-icon-tab span {
  font-size: 10px;
  line-height: 1;
  white-space: nowrap;
}

.rp-icon-tab:hover {
  background: #1a2332;
  color: #a0b0c0;
}

.rp-icon-tab.active {
  background: #1a3a4a;
  color: #22c55e;
}

/* Tab Content Cards */
.rp-card {
  background: #1a2332;
  border-radius: 10px;
  padding: 14px;
}

.rp-card-title {
  font-size: 14px;
  font-weight: 600;
  color: #fff;
}

.rp-card-desc {
  font-size: 12px;
  color: #6b7b8d;
  margin-top: 4px;
}

.rp-action-btn {
  width: 100%;

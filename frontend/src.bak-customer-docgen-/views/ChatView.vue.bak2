        </div>
        <div class="rp-section">
          <div class="rp-toggle-row">
            <span class="rp-toggle-label">接收翻译设置</span>
            <label class="rp-switch"><input type="checkbox" v-model="rpRecvEnabled"><span class="rp-slider"></span></label>
          </div>
          <div class="rp-fields" v-if="rpRecvEnabled">
            <div class="rp-field"><span class="rp-field-label">翻译线路</span><div class="rp-select"><select v-model="rpRecvLine"><option>AI大模型</option><option>Google翻译</option><option>DeepL</option></select></div></div>
            <div class="rp-field"><span class="rp-field-label">源语言</span><div class="rp-select"><select v-model="rpRecvSrc"><option>自动检测</option><option>英文</option><option>中文</option><option>日文</option><option>韩文</option></select></div></div>
            <div class="rp-field"><span class="rp-field-label">目标语言</span><div class="rp-select"><select v-model="rpRecvTarget"><option>中文（简体）</option><option>英文</option><option>日文</option><option>韩文</option></select></div></div>
          </div>
        </div>
        <div class="rp-section">
          <div class="rp-toggle-row">
            <span class="rp-toggle-label">发送翻译设置</span>
            <label class="rp-switch"><input type="checkbox" v-model="rpSendEnabled"><span class="rp-slider"></span></label>
          </div>
          <div class="rp-fields" v-if="rpSendEnabled">
            <div class="rp-field"><span class="rp-field-label">翻译线路</span><div class="rp-select"><select v-model="rpSendLine"><option>AI大模型</option><option>Google翻译</option><option>DeepL</option></select></div></div>
            <div class="rp-field"><span class="rp-field-label">语言</span><div class="rp-select"><select v-model="rpSendSrc"><option>自动检测</option><option>中文</option><option>英文</option></select></div></div>
            <div class="rp-field"><span class="rp-field-label">目标语言</span><div class="rp-select"><select v-model="rpSendTarget"><option>英文</option><option>中文（简体）</option><option>日文</option><option>韩文</option></select></div></div>
          </div>
        </div>
        <div class="rp-toggle-row rp-toggle-with-desc">
          <div><div class="rp-toggle-label">禁发中文</div><div class="rp-toggle-desc">防止误发中文消息</div></div>
          <label class="rp-switch"><input type="checkbox" v-model="rpBlockChinese"><span class="rp-slider"></span></label>
        </div>
        <div class="rp-toggle-row rp-toggle-with-desc">
          <div><div class="rp-toggle-label">翻译确认</div><div class="rp-toggle-desc">发送前确认翻译结果</div></div>
          <label class="rp-switch"><input type="checkbox" v-model="rpConfirmTranslate"><span class="rp-slider"></span></label>
        </div>
      </div>

      <div v-show="rpActiveTab === 2" class="rp-tab-body">
        <div class="rp-card">
          <div class="rp-card-title">AI 智能回复</div>
          <div class="rp-card-desc">根据聊天内容生成专业回复话术</div>
          <div class="rp-field" style="margin-top:12px">
            <span class="rp-field-label">回复风格</span>
            <div class="rp-select"><select v-model="rpAiStyle">
              <option value="formal">正式商务</option>
              <option value="friendly">友好亲切</option>
              <option value="brief">简洁直接</option>
            </select></div>
          </div>
          <div class="rp-field" style="margin-top:8px">
            <span class="rp-field-label">回复语言</span>
            <div class="rp-select"><select v-model="rpAiLang">
              <option value="en">英文</option>
              <option value="zh">中文</option>
              <option value="es">西班牙语</option>
              <option value="ar">阿拉伯语</option>
            </select></div>
          </div>
          <button class="rp-action-btn" @click="rpGenReply" :disabled="rpGenerating">
            {{ rpGenerating ? "生成中..." : "生成回复话术" }}
          </button>
          <div v-if="rpAiReplyText" class="rp-result-box">{{ rpAiReplyText }}</div>
        </div>
      </div>

      <div v-show="rpActiveTab === 3" class="rp-tab-body">
        <div class="rp-card">
          <div class="rp-card-title">客户需求分析</div>
          <div class="rp-card-desc">智能提取聊天中的关键需求信息</div>
          <button class="rp-action-btn" @click="rpGenSummary" :disabled="rpSummarizing" style="margin-top:12px">
            {{ rpSummarizing ? "分析中..." : "生成需求总结" }}
          </button>
          <div v-if="rpSummaryText" class="rp-result-box" style="white-space:pre-wrap">{{ rpSummaryText }}</div>
        </div>
      </div>

      <!-- Tab 4: 客户背调 -->
      <div v-show="rpActiveTab === 4" class="rp-tab-body">
        <div class="rp-card">
          <div class="rp-card-title">客户背景调查</div>
          <div class="rp-card-desc">通过全网搜索分析客户公司背景信息</div>
          <div class="rp-field" style="margin-top:12px">
            <span class="rp-field-label">公司名称/域名/手机号</span>
            <input class="rp-input" v-model="rpBgQuery" placeholder="输入公司名、域名或WhatsApp号" />
          </div>
          <button class="rp-action-btn" @click="rpGenBgCheck" :disabled="rpBgLoading" style="margin-top:10px">
            {{ rpBgLoading ? "全网搜索中..." : "开始背调" }}
          </button>
          <div v-if="rpBgReport" class="rp-result-box" style="white-space:pre-wrap; line-height:1.6">
            <div v-if="rpBgReport.companyName" style="font-size:14px; font-weight:600; color:#22c55e; margin-bottom:8px">
              {{ rpBgReport.companyName }}
            </div>
            <div v-if="rpBgReport.description" style="margin-bottom:8px">{{ rpBgReport.description }}</div>
            <div v-if="rpBgReport.industry"><strong>行业：</strong>{{ rpBgReport.industry }}</div>
            <div v-if="rpBgReport.country"><strong>国家/地区：</strong>{{ rpBgReport.country }}</div>
            <div v-if="rpBgReport.website"><strong>官网：</strong><a :href="rpBgReport.website" target="_blank" style="color:#60a5fa">{{ rpBgReport.website }}</a></div>
            <div v-if="rpBgReport.products"><strong>主要产品：</strong>{{ rpBgReport.products }}</div>
            <div v-if="rpBgReport.scale"><strong>公司规模：</strong>{{ rpBgReport.scale }}</div>
            <div v-if="rpBgReport.trustLevel" style="margin-top:8px">
              <strong>可信度：</strong>
              <span :style="{ color: rpBgReport.trustLevel === '高' ? '#22c55e' : rpBgReport.trustLevel === '中' ? '#f59e0b' : '#ef4444', fontWeight: 600 }">
                {{ rpBgReport.trustLevel }}
              </span>
            </div>
            <div v-if="rpBgReport.trustReasons" style="margin-top:4px; font-size:12px; color:#94a3b8">{{ rpBgReport.trustReasons }}</div>
            <div v-if="rpBgReport.riskFlags && rpBgReport.riskFlags.length" style="margin-top:8px">
              <strong style="color:#ef4444">风险信号：</strong>
              <span v-for="flag in rpBgReport.riskFlags" style="color:#fca5a5; margin-right:8px">{{ flag }}</span>
            </div>
            <div v-if="rpBgReport.marketFit" style="margin-top:8px"><strong>合作匹配度：</strong>{{ rpBgReport.marketFit }}</div>
            <div v-if="rpBgReport.suggestedApproach" style="margin-top:8px"><strong>跟进建议：</strong>{{ rpBgReport.suggestedApproach }}</div>
          </div>
          <div v-if="rpBgSources && rpBgSources.length" style="margin-top:8px; font-size:12px">
            <strong style="color:#94a3b8">信息来源：</strong>
            <div v-for="src in rpBgSources" style="margin-top:2px">
              <a :href="src.url" target="_blank" style="color:#60a5fa; text-decoration:none">{{ src.title }}</a>
            </div>
          </div>
        </div>
      </div>
      </div>

      <!-- Vertical Icon Bar -->
      <div class="rp-icon-bar">
        <button class="rp-icon-tab" :class="{ active: rpActiveTab === 1 }" @click="rpActiveTab = 1" title="翻译设置">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
          <span>翻译</span>
        </button>
        <button class="rp-icon-tab" :class="{ active: rpActiveTab === 2 }" @click="rpActiveTab = 2" title="AI话术">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          <span>AI话术</span>
        </button>
        <button class="rp-icon-tab" :class="{ active: rpActiveTab === 3 }" @click="rpActiveTab = 3" title="需求总结">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          <span>需求</span>
        </button>
        <button class="rp-icon-tab" :class="{ active: rpActiveTab === 4 }" @click="rpActiveTab = 4" title="客户背调">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span>背调</span>
        </button>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, watch } from 'vue';
import { Loading } from '@element-plus/icons-vue';
import { ElMessage, ElMessageBox } from 'element-plus';
import { useChatStore } from '../stores/chat.js';
import { initSocket } from '../utils/socket.js';
import ChatWindow from '../components/chat/ChatWindow.vue';
import CustomerPanel from '../components/chat/CustomerPanel.vue';

const chatStore = useChatStore();

const searchQuery = ref('');
const showQRDialog = ref(false);
const showMobileChat = ref(false);
const mobilePanel = ref('chat'); // 'chat' | 'customer' — mobile panel switch
const waTranslateTarget = ref("zh-CN");

// Right panel translation settings (TradeAgent style)
const rpStandalone = ref(true);
const rpRecvEnabled = ref(true);
const rpRecvLine = ref("AI大模型");
const rpRecvSrc = ref("自动检测");
const rpRecvTarget = ref("中文（简体）");
const rpSendEnabled = ref(true);
const rpSendLine = ref("AI大模型");
const rpSendSrc = ref("自动检测");
const rpSendTarget = ref("英文");
const rpBlockChinese = ref(true);
const rpConfirmTranslate = ref(false);
const rpActiveTab = ref(1);
const rpAiStyle = ref("formal");
const rpAiLang = ref("en");
const rpGenerating = ref(false);
const rpAiReplyText = ref("");
const rpSummarizing = ref(false);
const rpSummaryText = ref("");
const rpBgQuery = ref("");
const rpBgLoading = ref(false);
const rpBgReport = ref(null);
const rpBgSources = ref([]);

async function rpGenReply() {
  if (!chatStore.activeJid) return;
  rpGenerating.value = true;
  rpAiReplyText.value = "";
  try {
    await chatStore.generateAIReply(null, chatStore.activeJid, rpAiStyle.value);
    rpAiReplyText.value = "AI回复已生成，请在聊天窗口查看";
  } catch (e) { rpAiReplyText.value = "生成失败"; }
  rpGenerating.value = false;
}


async function rpGenBgCheck() {
  let query = rpBgQuery.value.trim();
  if (!query && chatStore.activeJid) {
    const jid = chatStore.activeJid;
    const phone = jid.split("@")[0] || "";
    const convs = chatStore.sortedConversations || [];
    const conv = convs.find(c => c.jid === jid);
    query = (conv && conv.name) ? conv.name : phone;
  }
  if (!query) { rpBgReport.value = { companyName: "\u8bf7\u8f93\u5165\u516c\u53f8\u540d\u79f0\u3001\u57df\u540d\u6216WhatsApp\u53f7" }; return; }
  
  rpBgLoading.value = true;
  rpBgReport.value = null;
  rpBgSources.value = [];
  try {
    const { data } = await api.post("/background-check", {
      query,
      context: ""
    });
    rpBgReport.value = data.report || {};
    rpBgSources.value = data.sources || [];
  } catch (e) {
    rpBgReport.value = { companyName: "\u80cc\u8c03\u5931\u8d25\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5", description: e.message || "" };
  }
  rpBgLoading.value = false;
}

async function rpGenSummary() {
  if (!chatStore.activeJid) return;
  rpSummarizing.value = true;
  rpSummaryText.value = "";
  try {
    await chatStore.generateNeedSummary(null, chatStore.activeJid);
    rpSummaryText.value = "需求总结已生成";
  } catch (e) { rpSummaryText.value = "分析失败"; }
  rpSummarizing.value = false;
}
const autoTranslateWa = ref(false);
const waStyle = ref("formal");
const waReplyLang = ref("en");

const qrDialogWidth = computed(() => {
  if (typeof window !== 'undefined' && window.innerWidth < 480) return '90%';
  return '420px';
});

const filteredConversations = computed(() => {
  const convs = chatStore.sortedConversations;
  if (!searchQuery.value) return convs;
  const q = searchQuery.value.toLowerCase();
  return convs.filter(
    c =>
      c.name?.toLowerCase().includes(q) ||
      c.phone?.toLowerCase().includes(q) ||
      c.jid?.toLowerCase().includes(q) ||
      c.lastMessage?.toLowerCase().includes(q)
  );
});

onMounted(async () => {
  initSocket();

  // Check current connection status
  const status = await chatStore.fetchConnectionStatus();

  // If connected, fetch conversations
  if (chatStore.isConnected) {
    await chatStore.fetchConversations();
  }

  // Fetch translation settings
  await chatStore.fetchTranslationSettings();
});

// Watch for connection status changes
watch(
  () => chatStore.connectionStatus,
  (newStatus) => {
    if (newStatus === 'connected') {
      showQRDialog.value = false;
      chatStore.fetchConversations();
    }
  }
);

function handleQROpen() {
  if (!chatStore.isConnected) {
    chatStore.requestQR();
  }
}

function handleQRClose() {
  // Don't disconnect - keep the connection attempt alive
}

async function handleDisconnect() {
  try {
    await ElMessageBox.confirm(
      '确定断开WhatsApp连接？断开后需要重新扫码登录。',
      '断开连接',
      { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning' }
    );
    await chatStore.disconnectWhatsApp();
    ElMessage.success('已断开连接');
  } catch {
    // User cancelled
  }
}

function selectConversation(conv) {
  chatStore.setActiveConversation(conv.jid);
  showMobileChat.value = true;
}

function onSendMessage(text) {
  if (!chatStore.activeJid || !chatStore.isConnected) return;
  chatStore.sendMessage(chatStore.activeJid, text);
}

async function handleAIReply() {
  if (!chatStore.activeJid) return;
  try {
    await chatStore.generateAIReply(null, chatStore.activeJid, 'formal');
  } catch (err) {
    console.error('AI reply failed:', err);
  }
}

async function translateLastMessage() {
  if (!chatStore.activeJid) return;
  const lastMsg = chatStore.activeMessages?.slice(-1)[0];
  if (!lastMsg) return;
  try {
    const { data } = await api.post("/messages/translate", {
      messageId: lastMsg.id,
      targetLang: waTranslateTarget.value
    });
    lastMsg.translation = data.translation;
    ElMessage.success("翻译完成");
  } catch (err) {
    ElMessage.error("翻译失败");
  }
}

async function handleAISummarize() {
  if (!chatStore.activeJid) return;
  try {
    await chatStore.generateNeedSummary(null, chatStore.activeJid);
  } catch (err) {
    console.error('AI summarize failed:', err);
  }
}

function getInitial(name) {
  if (!name) return '?';
  return name.charAt(0).toUpperCase();
}

function formatTime(dateStr) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now - date;

  if (diff < 60000) return '刚刚';
  if (diff < 3600000) return `${Math.floor(diff / 60000)}分钟前`;

  const isToday =
    date.getDate() === now.getDate() &&
    date.getMonth() === now.getMonth() &&
    date.getFullYear() === now.getFullYear();

  if (isToday) {
    return date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
  }

  const yesterday = new Date(now);
  yesterday.setDate(yesterday.getDate() - 1);
  const isYesterday =
    date.getDate() === yesterday.getDate() &&
    date.getMonth() === yesterday.getMonth();

  if (isYesterday) return '昨天';

  return date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
}

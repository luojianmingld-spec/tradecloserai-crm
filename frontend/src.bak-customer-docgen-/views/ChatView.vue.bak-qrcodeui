}
.qr-hint {
  font-size: 12px; color: #8696a0; text-align: center;
  max-width: 260px; line-height: 1.5;
}
.qr-retry {
  margin-top: 8px;
  padding: 8px 20px;
  background: #00a884; color: #fff;
  border: none; border-radius: 20px;
  font-size: 13px; cursor: pointer;
}
.qr-retry:hover { background: #06cf9c; }

@media (max-width: 768px) {
  .conv-messages { padding: 12px 12px; }
  .msg-bubble { max-width: 85%; }
  .back-btn { display: flex; }
  .ch-actions button:nth-child(1) { display: none; }
  .qr-dialog { width: 90vw; }
  .qr-img { width: 220px; height: 220px; }
}
</style>

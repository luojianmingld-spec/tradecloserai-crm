<template>
  <div class="conv-page">
    <!-- 对话头部 -->
    <div class="conv-header" v-if="chatStore.activeConversation">
      <button class="back-btn mobile-only" @click="goBack">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      </button>
      <div class="ch-avatar" :style="{background: avatarColor(chatStore.activeConversation.name)}">
        {{ (chatStore.activeConversation.name || '?')[0] }}
      </div>
      <div class="ch-info">
        <div class="ch-name">{{ chatStore.activeConversation.name }}</div>
        <div class="ch-status">
          <span class="online-dot offline"></span>
          {{ chatStore.activeConversation.phone ? chatStore.activeConversation.phone + ' · ' : '' }}最近在线
        </div>
      </div>
      <div class="ch-actions">
        <button title="搜索"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></button>
        <button title="更多"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg></button>
      </div>
    </div>

    <!-- 消息区 -->
    <div class="conv-messages" ref="msgArea">
      <!-- 未连接状态 -->
      <template v-if="!chatStore.isConnected">
        <div class="conv-placeholder">
          <div class="ph-icon">
            <svg viewBox="0 0 24 24" width="80" height="80" fill="currentColor"><path d="M12 21l-1.45-1.32C5.4 15.36 2 12.27 2 8.5 2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.18L12 21z" opacity="0.3"/></svg>
          </div>
          <div class="ph-title">连接 WhatsApp 开始聊天</div>
          <div class="ph-desc">扫码登录你的 WhatsApp 账号，与客户实时沟通</div>
          <button class="connect-btn" @click="openQrDialog">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M3 11h8V3H3v8zm2-6h4v4H5V5zm8-2v8h8V3h-8zm6 6h-4V5h4v4zM3 21h8v-8H3v8zm2-6h4v4H5v-4zm13-2h-2v3h-3v2h3v3h2v-3h3v-2h-3z"/></svg>
            扫码连接
          </button>
        </div>
      </template>

      <!-- 已连接但未选会话 -->
      <template v-else-if="!chatStore.activeConversation">
        <div class="conv-placeholder">
          <div class="ph-icon">💬</div>
          <div class="ph-title">从左侧列表选择一个会话开始聊天</div>
          <div class="ph-desc">选择一个 WhatsApp 会话开始沟通</div>
        </div>
      </template>

      <!-- 消息列表 -->
      <template v-else>
        <!-- Loading -->
        <div v-if="chatStore.loadingMessages" class="msgs-loading">
          <span class="loading-dots">加载消息中...</span>
        </div>

        <template v-for="(group, gIdx) in groupedMessages" :key="gIdx">
          <div class="msg-date-divider"><span>{{ group.label }}</span></div>
          <div
            v-for="msg in group.msgs"
            :key="msg.id"
            class="msg"
            :class="{ incoming: !msg.fromMe, outgoing: msg.fromMe }"
          >
            <div class="msg-bubble">
              <div class="msg-text">{{ msg.body || msg.content }}</div>
              <div v-if="msg.translation" class="msg-translation">
                翻译：{{ typeof msg.translation === 'string' ? msg.translation : (msg.translation.text || msg.translation.translated || '') }}
              </div>
              <div class="msg-time">
                {{ formatTime(msg.timestamp) }}
                <span v-if="msg.fromMe" class="msg-check">✓✓</span>
              </div>
            </div>
          </div>
        </template>

        <!-- AI建议条 -->
        <div v-if="chatStore.aiReplies && chatStore.aiReplies.length" class="ai-suggest-bar">
          <div class="ai-sb-label">🤖 AI建议</div>
          <div class="ai-sb-chips">
            <button
              v-for="(reply, i) in chatStore.aiReplies"
              :key="reply.id || i"
              class="ai-chip"
              @click="useAIReply(reply.text || reply)"
            >{{ (reply.text || reply).slice(0, 30) }}{{ (reply.text || reply).length > 30 ? '...' : '' }}</button>
            <button v-if="!chatStore.aiGenerating" class="ai-chip ai-refresh" @click="refreshAI">🔄 换一批</button>
          </div>
        </div>
        <div v-else-if="chatStore.activeConversation && !chatStore.loadingMessages" class="ai-suggest-bar" style="justify-content: center">
          <button class="ai-chip" @click="refreshAI">🤖 生成AI回复建议</button>
        </div>
      </template>
    </div>

    <!-- 输入区 -->
    <div class="conv-input-area" v-if="chatStore.isConnected && chatStore.activeConversation">
      <button class="input-action" title="添加">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
      </button>
      <div class="input-wrap">
        <input
          ref="inputEl"
          type="text"
          v-model="draftMsg"
          placeholder="输入消息... (Enter发送)"
          @keydown.enter="sendMsg"
        />
        <button class="emoji-btn" title="表情">😊</button>
      </div>
      <button class="send-btn" @click="sendMsg">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>
    </div>

    <!-- 扫码对话框 -->
    <div v-if="qrDialogVisible" class="qr-mask" @click.self="closeQrDialog">
      <div class="qr-dialog">
        <div class="qr-header">
          <span>扫码连接 WhatsApp</span>
          <button class="qr-close" @click="closeQrDialog">✕</button>
        </div>
        <div class="qr-body">
          <div v-if="chatStore.connectionStatus === 'connecting'" class="qr-status">
            <div class="qr-loading"></div>
            <div>正在连接，请稍候...</div>
          </div>
          <div v-else-if="chatStore.connectionStatus === 'waiting_qr' && chatStore.qrCode?.qr" class="qr-img-wrap">
            <img v-if="isDataUrl(chatStore.qrCode.qr)" :src="chatStore.qrCode.qr" class="qr-img" alt="QR Code" />
            <div v-else class="qr-text">{{ chatStore.qrCode.qr }}</div>
            <div class="qr-hint">请使用手机 WhatsApp → 已链接的设备 → 链接设备，扫描此二维码</div>
          </div>
          <div v-else-if="chatStore.connectionStatus === 'connected'" class="qr-status qr-success">
            <div class="qr-icon">✅</div>
            <div>连接成功！</div>
          </div>
          <div v-else-if="chatStore.connectionStatus === 'error' || chatStore.waError" class="qr-status qr-error">
            <div class="qr-icon">❌</div>
            <div>{{ chatStore.waError || '连接出错' }}</div>
            <button class="qr-retry" @click="retryQR">重试</button>
          </div>
          <div v-else class="qr-status">
            <div class="qr-loading"></div>
            <div>等待二维码...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted, nextTick, watch } from 'vue';
import { useChatStore } from '../stores/chat.js';

const emit = defineEmits(['go-back']);
const chatStore = useChatStore();

const draftMsg = ref('');
const msgArea = ref(null);
const inputEl = ref(null);
const qrDialogVisible = ref(false);

// Avatar color
const colorPalette = ['#00a884', '#4FC3F7', '#AB47BC', '#FF7043', '#66BB6A', '#FFA726', '#EC407A', '#26A69A', '#EF5350', '#5C6BC0'];
function avatarColor(name) {
  if (!name) return '#00a884';
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  return colorPalette[Math.abs(hash) % colorPalette.length];
}

// Time formatting
function formatTime(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  if (isNaN(d.getTime())) return '';
  const hh = String(d.getHours()).padStart(2, '0');
  const mm = String(d.getMinutes()).padStart(2, '0');
  return `${hh}:${mm}`;
}

function getDayLabel(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  if (isNaN(d.getTime())) return '';
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const msgDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  const diff = Math.round((today - msgDay) / (1000 * 60 * 60 * 24));
  if (diff === 0) return '今天';
  if (diff === 1) return '昨天';
  if (diff < 7) {
    const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
    return days[d.getDay()];
  }
  return `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

// Grouped messages
const groupedMessages = computed(() => {
  const msgs = chatStore.currentMessages || [];
  const groups = [];
  let lastLabel = null;
  for (const m of msgs) {
    const label = getDayLabel(m.timestamp);
    if (label !== lastLabel) {
      groups.push({ label, msgs: [m] });
      lastLabel = label;
    } else {
      groups[groups.length - 1].msgs.push(m);
    }
  }
  return groups;
});

// Auto scroll
function scrollToBottom() {
  nextTick(() => {
    if (msgArea.value) {
      msgArea.value.scrollTop = msgArea.value.scrollHeight;
    }
  });
}

watch(() => chatStore.currentMessages?.length, () => {
  scrollToBottom();
});

watch(() => chatStore.activeJid, () => {
  draftMsg.value = '';
  scrollToBottom();
});

// Watch insertText
watch(() => chatStore.insertText, (val) => {
  if (val) {
    draftMsg.value = (draftMsg.value ? draftMsg.value + ' ' : '') + val;
    chatStore.clearInsertText();
    nextTick(() => {
      if (inputEl.value) inputEl.value.focus();
    });
  }
});

// Watch connection to close QR dialog
watch(() => chatStore.connectionStatus, (s) => {
  if (s === 'connected' && qrDialogVisible.value) {
    setTimeout(() => { qrDialogVisible.value = false; }, 800);
  }
});

function sendMsg() {
  const text = draftMsg.value.trim();
  if (!text) return;
  if (!chatStore.activeJid) return;
  chatStore.sendMessage(chatStore.activeJid, text);
  draftMsg.value = '';
  scrollToBottom();
}

function goBack() {
  emit('go-back');
}

function useAIReply(text) {
  draftMsg.value = text;
  nextTick(() => { if (inputEl.value) inputEl.value.focus(); });
}

function refreshAI() {
  if (!chatStore.activeJid) return;
  // Single-account model: no accountId needed
  chatStore.generateAIReply(null, chatStore.activeJid, 'formal');
}

// QR dialog
function openQrDialog() {
  qrDialogVisible.value = true;
  chatStore.requestQR();
}
function closeQrDialog() { qrDialogVisible.value = false; }
function retryQR() { chatStore.requestQR(); }
function isDataUrl(s) {
  return typeof s === 'string' && (s.startsWith('data:') || s.startsWith('http'));
}

function onOpenQrEvent() {
  qrDialogVisible.value = true;
  chatStore.requestQR();
}

onMounted(() => {
  scrollToBottom();
  window.addEventListener('wa:open-qr', onOpenQrEvent);
  // Auto trigger AI if conversation exists
  if (chatStore.activeJid) {
    refreshAI();
  }
});

onUnmounted(() => {
  window.removeEventListener('wa:open-qr', onOpenQrEvent);
});
</script>

<style scoped>
.conv-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #0b141a;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(0,168,132,0.03) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(0,168,132,0.02) 0%, transparent 50%);
}

/* Header */
.conv-header {
  height: 56px;
  background: #202c33;
  border-bottom: 1px solid #222d34;
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 12px;
  flex-shrink: 0;
}
.back-btn {
  display: none;
  background: none; border: none; color: #e9edef;
  cursor: pointer; padding: 6px;
}
.ch-avatar {
  width: 38px; height: 38px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 600; flex-shrink: 0;
}
.ch-info { flex: 1; min-width: 0; }
.ch-name { font-size: 15px; font-weight: 500; color: #e9edef; }
.ch-status {
  font-size: 12px; color: #8696a0;
  display: flex; align-items: center; gap: 4px;
  margin-top: 1px;
}
.online-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #00a884;
}
.online-dot.offline { background: #667781; }
.ch-actions { display: flex; gap: 6px; }
.ch-actions button {
  width: 34px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  background: none; border: none; color: #8696a0;
  border-radius: 50%; cursor: pointer;
}
.ch-actions button:hover { background: #364147; color: #e9edef; }

/* Messages */
.conv-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px 8%;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.conv-placeholder {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #8696a0; gap: 12px;
  padding: 40px 20px;
}
.ph-icon { font-size: 64px; opacity: 0.5; color: #00a884; display: flex; align-items: center; justify-content: center; }
.ph-title { font-size: 18px; color: #e9edef; font-weight: 500; }
.ph-desc { font-size: 13px; text-align: center; max-width: 300px; }
.connect-btn {
  margin-top: 16px;
  display: flex; align-items: center; gap: 8px;
  padding: 10px 22px;
  background: #00a884; color: #fff;
  border: none; border-radius: 24px;
  font-size: 14px; font-weight: 500;
  cursor: pointer; transition: background 0.15s;
}
.connect-btn:hover { background: #06cf9c; }

.msgs-loading {
  display: flex; justify-content: center;
  padding: 20px; color: #8696a0; font-size: 12px;
}
.loading-dots::after {
  content: '';
  animation: dots 1.5s infinite;
}
@keyframes dots {
  0%, 20% { content: '.'; }
  40% { content: '..'; }
  60%, 100% { content: '...'; }
}

.msg-date-divider {
  display: flex; justify-content: center; margin: 12px 0;
}
.msg-date-divider span {
  background: #202c33; color: #8696a0;
  padding: 5px 12px; border-radius: 8px;
  font-size: 11px;
}
.msg { display: flex; margin-bottom: 2px; }
.msg.incoming { justify-content: flex-start; }
.msg.outgoing { justify-content: flex-end; }
.msg-bubble {
  max-width: 70%;
  padding: 6px 10px 8px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.45;
  position: relative;
  word-wrap: break-word;
}
.msg.incoming .msg-bubble {
  background: #202c33;
  color: #e9edef;
  border-top-left-radius: 2px;
}
.msg.outgoing .msg-bubble {
  background: #005c4b;
  color: #e9edef;
  border-top-right-radius: 2px;
}
.msg-text { padding-right: 50px; white-space: pre-wrap; word-break: break-word; }
.msg-translation {
  margin-top: 4px; padding-top: 4px;
  border-top: 1px dashed #364147;
  font-size: 12px; color: #8696a0;
  font-style: italic;
}
.msg-time {
  position: absolute;
  right: 8px; bottom: 3px;
  font-size: 10px; color: #8696a0;
  display: flex; align-items: center; gap: 2px;
}
.msg-check { color: #53bdeb; font-size: 11px; }

/* AI建议条 */
.ai-suggest-bar {
  margin: 8px 0;
  padding: 8px 10px;
  background: linear-gradient(135deg, #00a88420, #202c33);
  border: 1px solid #00a88440;
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.ai-sb-label {
  font-size: 12px;
  color: #00a884;
  font-weight: 600;
  flex-shrink: 0;
}
.ai-sb-chips { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; }
.ai-chip {
  padding: 4px 10px;
  background: #202c33;
  border: 1px solid #364147;
  color: #d1d7db;
  border-radius: 12px;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.15s;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-chip:hover { background: #00a88430; border-color: #00a884; color: #00a884; }
.ai-chip.ai-refresh { border-style: dashed; }

/* Input */
.conv-input-area {
  background: #202c33;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.input-action, .emoji-btn {
  background: none; border: none; color: #8696a0;
  cursor: pointer; padding: 6px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.input-action:hover, .emoji-btn:hover { color: #e9edef; }
.input-wrap {
  flex: 1;
  background: #2a3942;
  border-radius: 22px;
  display: flex;
  align-items: center;
  padding: 0 6px 0 16px;
}
.input-wrap input {
  flex: 1;
  background: transparent;
  border: none;
  color: #e9edef;
  padding: 10px 0;
  font-size: 14px;
  outline: none;
}
.send-btn {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: #00a884;
  color: #fff;
  border: none;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.15s;
}
.send-btn:hover { background: #06cf9c; }

/* QR Dialog */
.qr-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.6); z-index: 2000;
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
.qr-dialog {
  background: #202c33;
  border-radius: 12px;
  width: 340px; max-width: 90vw;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  overflow: hidden;
}
.qr-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px;
  background: #2a3942;
  font-size: 15px; font-weight: 600; color: #e9edef;
}
.qr-close {
  background: none; border: none; color: #8696a0;
  font-size: 18px; cursor: pointer; padding: 4px 8px;
}
.qr-close:hover { color: #e9edef; }
.qr-body {
  padding: 24px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  min-height: 280px;
}
.qr-status {
  display: flex; flex-direction: column;
  align-items: center; gap: 12px;
  color: #8696a0; font-size: 13px;
}
.qr-status.qr-success { color: #00a884; font-size: 16px; font-weight: 500; }
.qr-status.qr-error { color: #ea4335; }
.qr-icon { font-size: 48px; }
.qr-loading {
  width: 36px; height: 36px;
  border: 3px solid #364147;
  border-top-color: #00a884;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.qr-img-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 12px;
}
.qr-img {
  width: 240px; height: 240px;
  background: #fff;
  border-radius: 8px;
  padding: 8px;
}
.qr-text {
  width: 240px; height: 240px;

export async function extractCustomerInfo({ userId, accountId, jid, messages: directMessages }) {
  let messages = directMessages || [];
  if (messages.length === 0 && accountId && jid) {
    messages = await getRecentMessages(accountId, jid, 50);
  }
  if (messages.length === 0) {
    return { info: {}, error: '暂无消息记录' };
  }

  const contact = (accountId && jid) ? await getContactInfo(accountId, jid) : null;
  const contextStr = buildConversationContext(messages, contact);

  const systemPrompt = `你是一位外贸单证专家。请从以下聊天记录中提取客户信息，用于生成报价单/发票等单证。

已知客户信息（如果有）：
${contact ? `电话: ${contact.phone || '未知'}, 姓名: ${contact.name || '未知'}, 公司: ${contact.company || '未知'}` : '无'}

请提取以下字段，如果聊天中没提到就返回空字符串。严格按JSON格式返回：

{
  contactName: 联系人姓名,
  companyName: 公司名称,
  phone: 电话号码,
  email: 邮箱,
  address: 地址,
  country: 国家,
  products: 意向产品,
  quantity: 数量,
  price: 价格
}

仅返回JSON。`;

  const result = await aiChatComplete(
    [
      { role: 'system', content: systemPrompt },
      { role: 'user', content: contextStr },
    ],
    { temperature: 0.2, max_tokens: 512 }
  );

  try {
    const jsonMatch = result.match(/\{[\s\S]*\}/);
    if (jsonMatch) {
      const parsed = JSON.parse(jsonMatch[0]);
      return { info: parsed, source: 'ai' };
    }
  } catch (e) {
    console.error('[AI Service] extractCustomerInfo parse error:', e.message);
  }

  return { info: {}, source: 'fallback' };
}


    contract: `请根据以下聊天记录和客户信息，生成一份外贸销售合同模板。
要求：
1. 包含：合同编号、签约日期、买卖双方信息、产品描述及规格、数量、价格条款、付款方式、交货条款、质量保证、争议解决、不可抗力、合同生效条件
2. 用标准合同条款格式（第X条）
3. 关键待填项用[待填]标注`
  };

  const prompt = docPrompts[docType] || docPrompts.quotation;

  const systemPrompt = `${prompt}

${infoStr}

以下是聊天记录内容：`;

  const result = await aiChatComplete(
    [
      { role: "system", content: systemPrompt },
      { role: "user", content: contextStr },
    ],
    { temperature: 0.3, max_tokens: 2048 }
  );

  return { content: result, docType, engine: "active" };
}

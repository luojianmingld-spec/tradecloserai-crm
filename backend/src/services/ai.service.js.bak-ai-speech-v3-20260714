  email: 邮箱,
  address: 地址,
  country: 国家,
  products: 意向产品,
  quantity: 数量,
  price: 价格
}

仅返回JSON。`;

  const result = await aiChatComplete(
    [
      { role: 'system', content: systemPrompt },
      { role: 'user', content: contextStr },
    ],
    { temperature: 0.2, max_tokens: 512 }
  );

  try {
    const jsonMatch = result.match(/\{[\s\S]*\}/);
    if (jsonMatch) {
      const parsed = JSON.parse(jsonMatch[0]);
      return { info: parsed, source: 'ai' };
    }
  } catch (e) {
    console.error('[AI Service] extractCustomerInfo parse error:', e.message);
  }

  return { info: {}, source: 'fallback' };
}


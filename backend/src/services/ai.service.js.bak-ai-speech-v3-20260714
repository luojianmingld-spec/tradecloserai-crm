/**
 * 稳健JSON抽取：markdown代码块、首尾花括号兜底
 */
function safeParseJson(raw) {
  if (!raw || typeof raw !== "string") return null;
  let text = raw.trim();
  const fenceMatch = text.match(/```(?:json)?\s*([\s\S]*?)\s*```/i);
  if (fenceMatch) text = fenceMatch[1].trim();
  try { return JSON.parse(text); } catch (_) {}
  const first = text.indexOf("{");
  const last = text.lastIndexOf("}");
  if (first !== -1 && last !== -1 && last > first) {
    try { return JSON.parse(text.slice(first, last + 1)); } catch (_) {}
  }
  return null;
}

async function resolveProviderAndModel(modelKey) {
  let callProvider = null;
  let selectedModelId = null;
  if (modelKey) {
    callProvider = await getProviderById(modelKey);
    if (callProvider) selectedModelId = callProvider.model;
  }
  if (!callProvider) {
    callProvider = await getActiveProvider();
    selectedModelId = callProvider?.model || DOUBAO_PRO_MODEL;
  }
  return { provider: callProvider, modelId: selectedModelId };
}

/**
 * 深度分析会话 - 返回3版回复话术
 */
export async function analyzeConversation({ userId, accountId, jid, model: modelKey, messages: directMessages, targetLang: tLangOpt }) {
  let messages = Array.isArray(directMessages) ? directMessages : [];
  if (messages.length === 0 && accountId && jid) {
    messages = await getRecentMessages(accountId, jid, 20);
  }
  if (!messages || messages.length === 0) {
    return { success: false, error: "该会话暂无消息记录，请先与客户有过对话再使用AI分析" };
  }
  const contact = (accountId && jid) ? await getContactInfo(accountId, jid) : null;
  const contextStr = buildConversationContext(messages, contact);

  const { provider, modelId } = await resolveProviderAndModel(modelKey);
  if (!provider?.apiKey) {
    return { success: false, error: "未配置 AI 模型，请先在「设置-AI模型」添加 API Key" };
  }

  const callLLM = async (extraParams = {}) => aiChatComplete(
    [
      { role: "system", content: ANALYZE_SYSTEM_PROMPT_V2 + buildTargetLangDirective(tLangOpt) },
      { role: "user", content: "以下是聊天记录：\n\n" + contextStr },
    ],
    {
      temperature: 0.7,
      max_tokens: 2048,
      model: modelId,
      provider,
      timeout: 60000,
      ...extraParams,
    }
  );

  let raw = "";
  try {
    raw = await callLLM({ response_format: { type: "json_object" } });
  } catch (err) {
    console.warn("[AI analyze] json_object mode failed, retry plain:", err.message);
    try {
      raw = await callLLM({});
    } catch (err2) {
      return { success: false, error: "AI响应超时或调用失败，请检查网络或换个模型重试" };
    }
  }

  const parsed = safeParseJson(raw);
  if (!parsed || !Array.isArray(parsed.replies)) {
    return { success: false, error: "AI返回格式异常，请重试" };
  }

  const replies = parsed.replies
    .filter(r => r && (r.foreign || r.chinese))
    .slice(0, 3)
    .map((r, i) => ({
      name: typeof r.name === "string" && r.name.trim() ? r.name.trim() : ["标准友好版", "简洁专业版", "热情推进版"][i],
      desc: typeof r.desc === "string" ? r.desc.trim() : "",
      foreign: typeof r.foreign === "string" ? r.foreign.trim() : "",
      chinese: typeof r.chinese === "string" ? r.chinese.trim() : "",
    }));

  if (replies.length === 0) {
    return { success: false, error: "AI返回格式异常，请重试" };
  }

  return {
    success: true,
    data: { replies },
    provider: provider?.name || provider?.provider || "",
    model: modelKey || "",
  };
}

/**
 * 多轮AI对话 - 把WhatsApp聊天记录作为system context，前端传对话历史
 * @param {{userId:number, accountId:number, jid:string, model?:string, history?:Array<{role:string,content:string}>}} opts
 */
export async function chatWithContext({ userId, accountId, jid, model: modelKey, history = [], targetLang: tLangOpt }) {
  // 获取context
  let contextStr = "（暂无聊天记录）";
  if (accountId && jid) {
    const messages = await getRecentMessages(accountId, jid, 20);
    if (messages && messages.length > 0) {
      const contact = await getContactInfo(accountId, jid);
      contextStr = buildConversationContext(messages, contact);
    }
  }

  const chatSysBase = CHAT_SYSTEM_PROMPT.replace("{CONTEXT}", contextStr);
  const targetDirective = buildTargetLangDirective(tLangOpt);
  let systemPrompt = chatSysBase;
  if (targetDirective) {
    const langCn = LANG_CODE_TO_CN[tLangOpt] || tLangOpt;
    // Replace the generic line with explicit target language directive
    const replLine =
      "- 【强制】外文回复必须使用【" + langCn + "】，无论客户用什么语言，都不要用英语或其他语言输出外文。" +
      " 若用户只是在提问或让你分析（不是生成外文话术），正常中文回答即可；只有外文回复/话术部分必须是【" + langCn + "】。";
    systemPrompt = chatSysBase.replace(
      "- 外文内容使用客户使用的语言（阿拉伯语/英语/西语等，与聊天记录中客户的语言一致）。",
      replLine
    );
  }

  const msgs = [{ role: "system", content: systemPrompt }];
  for (const m of history || []) {
    if (m && (m.role === "user" || m.role === "assistant") && typeof m.content === "string") {
      msgs.push({ role: m.role, content: m.content });
    }
  }

  const { provider, modelId } = await resolveProviderAndModel(modelKey);
  if (!provider?.apiKey) {
    return { success: false, error: "未配置 AI 模型，请先在「设置-AI模型」添加 API Key" };
  }

  try {
    const reply = await aiChatComplete(msgs, {
      temperature: 0.7,
      max_tokens: 2048,
      model: modelId,
      provider,
      timeout: 60000,
    });
    return {
      success: true,
      data: { reply: (reply || "").trim() },
      provider: provider?.name || provider?.provider || "",
      model: modelKey || "",
    };
  } catch (err) {
    console.error("[AI chatWithContext] error:", err.message);
    const isTimeout = /timeout|abort/i.test(err.message || "");
    return {
      success: false,
      error: isTimeout ? "AI响应超时，请检查网络或换个模型重试" : ("AI调用失败: " + err.message),
    };
  }
}

export async function getAvailableModels() {
  // 动态从 providers 表读取所有已配置的 AI 模型
  const { getProviders: getAllProviders } = await import('./ai-client.js');
  let providers = [];
  try {
    providers = await getAllProviders();
  } catch (e) {
    console.error('[AI] getProviders failed:', e.message);
  }

  // 构建展示列表：每个 provider 作为一个可选模型
  const providerLabels = {
    doubao: '豆包',
    deepseek: 'DeepSeek',
    openai: 'OpenAI',
    custom: '自定义',
  };

  const models = providers
    .filter(p => p.apiKey && p.model)
    .map(p => {
      const label = providerLabels[p.provider] || p.provider || '自定义';
      const isLite = p.model.includes('lite');
      return {
        key: p.id,
        id: p.model,
        name: `${p.name || label}`,

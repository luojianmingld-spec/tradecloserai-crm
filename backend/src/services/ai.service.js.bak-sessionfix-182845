import { generatePdf } from '../utils/simple-pdf.js';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const DOC_LABELS = {
  quotation: '报价单',
  pi: '形式发票',
  ci: '商业发票',
  packing: '装箱单',
  contract: '销售合同',
  customs: '报关单',
};

export async function generateDocPdfBuffer({ docType, content, lang }) {
  const label = DOC_LABELS[docType] || 'Document';
  const title = label + (lang && lang !== 'zh' ? ` (${lang.toUpperCase()})` : '');
  return generatePdf({ title, content });
}

export function generateDocFileName(docType) {
  const label = DOC_LABELS[docType] || 'Doc';
  const now = new Date();
  const pad = n => String(n).padStart(2,'0');
  const ts = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}${pad(now.getHours())}${pad(now.getMinutes())}`;
  return `${label}_${ts}.pdf`;
}

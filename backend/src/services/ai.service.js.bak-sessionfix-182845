      inquiryType = {
        category: cat,
        label: String(parsed.inquiryType.label || cat).trim(),
        tip: String(parsed.inquiryType.tip || "").trim(),
      };
    }
  }
  if (!inquiryType) {
    inquiryType = { category: "信息型", label: "信息咨询", tip: "针对客户问题清晰专业回答即可" };
  }

  return {
    success: true,
    data: { replies, analysis, designThinking, suggestions, inquiryType },
    provider: provider?.name || provider?.provider || "",
    model: modelKey || "",
  };
}


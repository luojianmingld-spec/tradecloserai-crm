    ],
    {
      temperature: 0.7,
      max_tokens: 4000,
      model: modelId,
      provider,
      timeout: 90000,
      ...extraParams,
    }
  );

  let raw = "";
  try {
    raw = await callLLM({ response_format: { type: "json_object" } });
  } catch (err) {
    console.warn("[AI analyze] json_object mode failed, retry plain:", err.message);
    try {
      raw = await callLLM({});
    } catch (err2) {
      return { success: false, error: "AI响应超时或调用失败，请检查网络或换个模型重试" };
    }
  }

  const parsed = safeParseJson(raw);
  if (!parsed || !Array.isArray(parsed.replies)) {
    return { success: false, error: "AI返回格式异常，请重试" };
  }

  let replies = parsed.replies
    .filter(r => r && (r.foreign || r.chinese))
    .slice(0, 3)
    .map((r, i) => ({
      name: typeof r.name === "string" && r.name.trim() ? r.name.trim() : ["标准友好版", "简洁专业版", "热情推进版"][i],
      desc: typeof r.desc === "string" ? r.desc.trim() : "",
      foreign: typeof r.foreign === "string" ? r.foreign.trim() : "",
      chinese: typeof r.chinese === "string" ? r.chinese.trim() : "",
    }));
  // 兜底：AI没返回chinese时用google补翻译
  try {
    for (const r of replies) {
      if (r.foreign && !r.chinese) {
        const det = await googleDetect(r.foreign).catch(() => 'auto');
        if (det && det !== 'zh' && !String(det).startsWith('zh-')) {
          const tr = await googleTranslate(r.foreign, det, 'zh');
          if (tr && tr.translated) r.chinese = tr.translated.trim();
        }
      }
    }
  } catch(_) {}

  if (replies.length === 0) {
    return { success: false, error: "AI返回格式异常，请重试" };
  }

  // 新字段兼容：如果AI没返回就给空值
  const analysis = typeof parsed.analysis === "string" ? parsed.analysis.trim() : "";
  const designThinking = Array.isArray(parsed.designThinking)
    ? parsed.designThinking
        .filter(d => d && (typeof d.customerPsych === "string" || typeof d.strategy === "string"))
        .slice(0, 6)
        .map(d => ({
          customerPsych: (typeof d.customerPsych === "string" ? d.customerPsych : "").trim(),
          strategy: (typeof d.strategy === "string" ? d.strategy : "").trim(),
        }))
        .filter(d => d.customerPsych || d.strategy)
    : [];
  const suggestions = Array.isArray(parsed.suggestions)
    ? parsed.suggestions
        .filter(s => typeof s === "string" && s.trim())
        .slice(0, 6)
        .map(s => s.trim())
    : [];

  // 询盘7分类解析
  const validCats = ["信息型","价格型","样品型","资质型","合作型","拒绝型","转介绍型"];
  let inquiryType = null;
  if (parsed.inquiryType && typeof parsed.inquiryType === "object") {
    const cat = String(parsed.inquiryType.category || "").trim();

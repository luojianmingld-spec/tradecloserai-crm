/**
 * Fast regex-based language detection — covers the most common scripts
 * to avoid an LLM round-trip.  Returns 'zh' for CJK-heavy (ja/ko/zh all fall
 * back to zh in MVP since users mostly translate between Chinese & other
 * languages), 'ja' for hiragana/katakana, 'ko' for hangul,
 * 'ar' for Arabic, 'ru' for Cyrillic, 'en' for Latin-heavy text that looks
 * like English.  Returns null when undecided.
 */
function fastDetect(text) {
  if (!text || typeof text !== 'string') return null;
  const sample = text.slice(0, 200);
  const hasJapanese = /[\u3040-\u309f\u30a0-\u30ff]/.test(sample);
  const hasKorean = /[\uac00-\ud7af]/.test(sample);
  const hasCJK = /[\u4e00-\u9fff]/.test(sample);
  const hasArabic = /[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff]/.test(sample);
  const hasCyrillic = /[\u0400-\u04ff\u0500-\u052f]/.test(sample);
  const hasLatin = /[A-Za-z]/.test(sample);

  if (hasJapanese) return 'ja';
  if (hasKorean) return 'ko';
  if (hasCJK) return 'zh';
  if (hasArabic) return 'ar';
  if (hasCyrillic) return 'ru';
  if (hasLatin) {
    // Distinguish Latin-script languages before falling back to 'en'
    const lowerSample = sample.toLowerCase();

    // Spanish: ñ, ¿, ¡, or high frequency of Spanish-only words
    if (/[ñ¿¡]/.test(sample)) return 'es';
    const esWords = (lowerSample.match(/\b(el|la|los|las|de|del|que|como|pero|más|está|están|tengo|tiene|bien|hola|gracias|mucho|para|cuando|todo|nada|donde|porque|siempre|entonces|también|socio|viajando|reuniría|encuentres|interesado|importar|módulos|viviendas|feria|puedes|mándame|pasarlo|desde|abrazo|buenos|días|buenas|noches|tarde|favor|algo|nadie|alguien|ahora|mismo|mucho|poco|casa|tiempo|vida|hombre|mujer|cosa|forma|parte|lugar|camino|momento|ejemplo|gobierno|país|mundo|historia|trabajo|problema|número|idea|general|tanto|grande|nuevo|bueno|malo|primero|último|largo|segundo|mayor|mejor|menor|cada|propio|otro|tanto|cierto|propio|según|aunque|después|antes|durante|mediante|hacia|entre|sobre|hasta|desde|durante|según|tras|cabe|so|cabe)\b/g) || []);
    const latin = (sample.match(/[A-Za-z]/g) || []).length;
    const totalNoSpace = sample.replace(/\s+/g, '').length;
    if (latin > 4 && latin / totalNoSpace > 0.6) {
      // French: ç, œ, æ, or high frequency of French words
      if (/[çœæ]/.test(sample)) return 'fr';
      const frWords = (lowerSample.match(/\b(je|tu|il|elle|nous|vous|ils|elles|le|les|un|une|des|du|au|aux|ce|cette|ces|mon|ma|mes|ton|ta|tes|son|sa|ses|qui|que|quoi|dont|où|comment|pourquoi|quand|comment|bonjour|merci|oui|non|peut-être|avec|sans|pour|dans|sur|sous|entre|vers|chez|avant|après|pendant|depuis|très|bien|mal|aussi|toujours|déjà|encore|ensemble|maintenant|alors|comment|pourquoi|parce|chose|homme|femme|monde|temps|vie|maison|travail|problème|pays|ville|route|exemple)\b/g) || []);
      if (frWords.length >= 3) return 'fr';

      // German: ü, ö, ä, ß, or high frequency of German words
      if (/[üöä]/.test(sample) || /ß/.test(sample)) return 'de';
      const deWords = (lowerSample.match(/\b(ich|du|er|sie|wir|ihr|der|die|das|ein|eine|und|oder|aber|nicht|auch|nur|noch|schon|sehr|gut|schlecht|groß|klein|neu|alt|erste|letzte|hallo|danke|bitte|ja|nein|vielleicht|mit|ohne|für|auf|in|an|zu|bei|nach|vor|über|unter|zwischen|seit|während|weil|wenn|dass|ob|wie|warum|was|wer|wo|wann|welche|welcher|welches)\b/g) || []);
      if (deWords.length >= 3) return 'de';

      // Portuguese: ã, õ, ç, or high frequency of Portuguese words
      if (/[ãõç]/.test(sample)) return 'pt';
      const ptWords = (lowerSample.match(/\b(eu|você|ele|ela|nós|eles|elas|o|a|os|as|um|uma|uns|umas|de|do|da|dos|das|que|como|mas|mais|está|estou|tenho|tem|bem|olá|obrigado|obrigada|muito|para|quando|tudo|nada|onde|porque|sempre|então|também|com|sem|por|em|no|na|nos|nas|sobre|entre|até|desde|já|também|ainda|coisa|homem|mulher|mundo|tempo|vida|casa|trabalho|problema)\b/g) || []);
      if (ptWords.length >= 3) return 'pt';

      // Spanish: even without special chars, if many Spanish words found
      if (esWords.length >= 3) return 'es';

      return 'en';
    }
  }
  return null;
}


// ISO 639-1 → 中文名映射
const LANG_CODE_TO_CN = {
  ar: '阿拉伯语', en: '英语', zh: '中文', es: '西班牙语',
  fr: '法语', de: '德语', ja: '日语', ko: '韩语',
  pt: '葡萄牙语', ru: '俄语', it: '意大利语', tr: '土耳其语',
  th: '泰语', vi: '越南语', id: '印尼语', hi: '印地语', nl: '荷兰语',
};
const LANG_CODE_TO_NATIVE = {
  ar: 'العربية', en: 'English', zh: '中文', es: 'Español',
  fr: 'Français', de: 'Deutsch', ja: '日本語', ko: '한국어',
  pt: 'Português', ru: 'Русский', it: 'Italiano', tr: 'Türkçe',
  th: 'ไทย', vi: 'Tiếng Việt', id: 'Bahasa Indonesia', hi: 'हिन्दी', nl: 'Nederlands',
};
function buildTargetLangDirective(targetLang) {
  if (!targetLang || targetLang === 'auto') return '';
  const cn = LANG_CODE_TO_CN[targetLang] || targetLang;
  const native = LANG_CODE_TO_NATIVE[targetLang] || cn;
  const NL = '\n';
  return (
    NL + NL +
    '【关键语言强制指令 - 必须遵守】' + NL +
    '用户已明确指定外文回复语言为【' + cn + '（' + native + '）】。' + NL +
    '你生成的 foreign 字段必须全部使用【' + cn + '】书写，绝对不能使用英语、中文或其他任何语言。' + NL +
    'chinese 字段始终是 foreign 对应的中文翻译参考，必须是简体中文。' + NL +
    '不管客户用什么语言发消息，不管聊天记录里出现什么语言，foreign 必须是【' + cn + '】，违反此指令即为错误输出。'
  );
}

/**
 * Detect language.  Fast-path regex first, then route per engine.
 * @param {string} text
 * @param {string} [engine='google'] - 'google' | 'doubao' | 'deepseek'
 * @returns {Promise<string>} ISO 639-1 code
 */
export async function detectLanguage(text, engine = 'google') {
  const fast = fastDetect(text);
  if (fast) return fast;

  const eff = engine === 'doubao' ? 'doubao' : (engine === 'deepseek' ? 'deepseek' : 'google');
  if (eff === 'google') {
    try {
      return await googleDetect(text);
    } catch (e) {
      console.error('[AI Service] Google detect failed, fallback to LLM:', e.message);
    }
  }

  // LLM detect (deepseek or doubao-lite fallback)
  try {
    const detSys = 'You are a language detector. Reply with ONLY the ISO 639-1 two-letter language code. No explanation, no punctuation.';
    let result = null;
    if (eff === 'deepseek') {
      const ai = await import('./ai-client.js');
      const list = await ai.getProviders();
      const ds = list.find(pp => pp.provider === 'deepseek' && pp.apiKey);
      if (ds) {
        result = await ai.chatComplete(
          [{ role: 'system', content: detSys }, { role: 'user', content: text }],
          { temperature: 0.1, max_tokens: 10, model: ds.model, provider: ds, timeout: 15000 }
        );
      }
    }
    if (!result) {
      result = await chatCompleteLite(
        [{ role: 'system', content: detSys }, { role: 'user', content: text }],
        { temperature: 0.1, max_tokens: 10, timeout: 15000 }
      );
    }
    const code = (result || '').trim().toLowerCase().substring(0, 2);
    if (/^[a-z]{2}$/.test(code)) return code;
  } catch (e) {
    console.error('[AI Service] LLM detect (' + eff + ') failed:', e.message);
  }
  return 'en';
}

/**
 * Translate text. Routes per engine, with doubao fallback when google fails.
 *
 * @param {string} text
 * @param {string} sourceLang - ISO 639-1 or 'auto'
 * @param {string} targetLang - ISO 639-1
 * @param {string} [engine='google'] - 'google' | 'doubao' | 'deepseek'
 * @param {number} [userId]
 * @returns {Promise<{translated:string, sourceLang:string, targetLang:string, cached:boolean, engine:string, detectedSourceLang?:string}>}
 */
export async function translateText(text, sourceLang, targetLang, engine = 'google', userId) {
  if (!text) return { translated: text || '', sourceLang: sourceLang || 'auto', targetLang, cached: false, engine };
  const effectiveTarget = targetLang === 'auto' ? 'zh' : (targetLang || 'zh');
  let effectiveSource = sourceLang === 'auto' || !sourceLang ? 'auto' : sourceLang;
  const effectiveEngine = engine === 'doubao' ? 'doubao' : (engine === 'deepseek' ? 'deepseek' : 'google');

  // Cache key (sourceLang may be 'auto', actual detected is not known yet)
  const cacheKey = `${text}|${effectiveSource}|${effectiveTarget}|${effectiveEngine}`;
  if (memoryCache.has(cacheKey)) {
    return { translated: memoryCache.get(cacheKey), sourceLang: effectiveSource, targetLang: effectiveTarget, cached: true, engine: effectiveEngine };
  }

  const dbCache = await prisma.translationCache.findUnique({
    where: { sourceText_sourceLang_targetLang_engine: { sourceText: text, sourceLang: effectiveSource, targetLang: effectiveTarget, engine: effectiveEngine } },
  }).catch(() => null);
  if (dbCache) {
    memoryCache.set(cacheKey, dbCache.translated);
    return { translated: dbCache.translated, sourceLang: effectiveSource, targetLang: effectiveTarget, cached: true, engine: effectiveEngine };
  }

  let translated = '';
  let detectedSourceLang;
  let usedEngine = effectiveEngine;

  // ── google path ──
  if (effectiveEngine === 'google') {
    try {
      const r = await googleTranslate(text, effectiveSource, effectiveTarget);
      translated = r.translated;
      detectedSourceLang = r.detectedSourceLang;
      if (effectiveSource === 'auto' && detectedSourceLang) effectiveSource = detectedSourceLang;
    } catch (e) {
      console.error('[AI Service] Google translate failed, falling back to LLM:', e.message);
      usedEngine = effectiveEngine !== 'google' ? effectiveEngine : 'doubao';
    }
  }

  // ── LLM translate path (deepseek or doubao-lite fallback, also reached when google fails) ──
  if (!translated && (effectiveEngine === 'deepseek' || effectiveEngine === 'doubao' || usedEngine !== 'google')) {
    if (effectiveSource === 'auto') {
      const fast = fastDetect(text);
      if (fast) effectiveSource = fast;
    }
    const srcName = LANGUAGE_NAMES[effectiveSource] || (effectiveSource === 'auto' ? '自动检测' : effectiveSource);
    const tgtName = LANGUAGE_NAMES[effectiveTarget] || effectiveTarget;
    const systemPrompt = `Translate the user's text from ${srcName} into ${tgtName}. Output ONLY the translation, no explanations, no quotes, no markdown. If source and target are the same, return the text unchanged.`;
    try {
      if (effectiveEngine === 'deepseek' || usedEngine === 'deepseek') {
        const ai = await import('./ai-client.js');
        const list = await ai.getProviders();
        const ds = list.find(pp => pp.provider === 'deepseek' && pp.apiKey);
        if (ds) {
          usedEngine = 'deepseek';
          translated = await ai.chatComplete(
            [
              { role: 'system', content: systemPrompt },
              { role: 'user', content: text },
            ],
            { temperature: 0.2, max_tokens: 1024, model: ds.model, provider: ds, timeout: 20000 }
          );
          translated = (translated || '').trim();
        }
      }
      if (!translated) {
        usedEngine = 'doubao';
        translated = await chatCompleteLite(
          [
            { role: 'system', content: systemPrompt },
            { role: 'user', content: text },
          ],
          { temperature: 0.2, max_tokens: 1024, timeout: 15000 }
        );
        translated = (translated || '').trim();
      }
    } catch (e) {
      console.error('[AI Service] LLM translate (' + usedEngine + ') failed:', e.message);
      throw e;
    }
  }

  if (!translated) {
    throw new Error('Translation returned empty');
  }

  memoryCache.set(cacheKey, translated);
  try {
    await prisma.translationCache.upsert({
      where: { sourceText_sourceLang_targetLang_engine: { sourceText: text, sourceLang: effectiveSource, targetLang: effectiveTarget, engine: usedEngine } },
      create: { sourceText: text, sourceLang: effectiveSource, targetLang: effectiveTarget, engine: usedEngine, translated },
      update: { translated },
    });
  } catch (e) {
    console.error('[AI Service] Cache save error:', e.message);
  }

  return { translated, sourceLang: effectiveSource, targetLang: effectiveTarget, cached: false, engine: usedEngine, detectedSourceLang };
}

/**
 * Translate outgoing (user→foreign).  Default engine = google (fast).
 * Uses fast regex detection to skip explicit detect step for the common CJK/Latin case.
 * On any failure returns null so the caller can silently fall back to sending original.
 */
export async function translateOutgoing(text, contactLang, userId, opts = {}) {
  if (!text) return null;
  try {
    const settingsPath = userId ? await getAISettings(userId) : null;
    const engine = opts.engine || settingsPath?.sendEngine || 'google';
    const sourceLangSetting = opts.sendSourceLang || settingsPath?.sendSourceLang || 'auto';
    const targetLang = contactLang || opts.targetLang || 'en';

    let sourceLang = sourceLangSetting;
    if (sourceLang === 'auto') {
      // fast regex path avoids extra API round-trip entirely
      const fast = fastDetect(text);
      sourceLang = fast || 'auto';
    }

    // When engine is google and source is auto, we send auto and let Google return detectedSourceLang.
    const result = await translateText(text, sourceLang, targetLang, engine, userId);
    return result;
  } catch (e) {
    console.error('[AI Service] translateOutgoing failed, will send original:', e.message);
    return null;
  }
}


async function getRecentMessages(accountId, jid, limit = 20) {
  // Determine which session(s) to query based on jid suffix
  const sessionIds = [`user_${accountId}`]; // WA default session
  if (jid && jid.endsWith('@telegram')) {
    sessionIds.length = 0;
    sessionIds.push(`tg_${accountId}`); // fallback
    // Find actual TG session(s) for this user
    // We'll query by jid in from/to regardless of sessionId
  }
  try {
    const where = {
      OR: [
        { from: jid },
        { to: jid },
        
      ],
    };
    // For TG jids, don't filter by sessionId to catch all TG messages
    if (!jid || !jid.endsWith('@telegram')) {
      where.sessionId = { in: sessionIds };
    }
    return await prisma.wAMessage.findMany({
      where,
      orderBy: { timestamp: 'desc' },
      take: limit,
    });
  } catch (e) {
    console.warn('[AI] getRecentMessages wAMessage fallback failed:', e.message);
    return [];
  }
}

async function getContactInfo(accountId, jid) {
  try {
    const phone = (jid || '').split('@')[0];
    const customer = await prisma.customer.findFirst({
      where: { userId: accountId, OR: [{ phone }, { jid }] },
    });
    if (customer) {
      return {
        name: customer.name,
        country: customer.country || '',
        language: '',
        phone,
      };
    }
  } catch (e) {
    console.warn('[AI] getContactInfo failed:', e.message);
  }
  return null;
}

function buildConversationContext(messages, contact) {
  const contactInfo = contact ? `客户: ${contact.name || contact.phone || '未知'}, 国家: ${contact.country || '未知'}, 语言: ${contact.language || '未知'}` : '';
  const msgLines = messages.slice().reverse().map(m => {
    const isFromMe = m.fromMe === true || m.direction === 'outbound' || m.direction === 'outgoing';
    const role = isFromMe ? '我方' : '客户';
    const content = m.body || m.content || '';
    const time = new Date(m.timestamp).toLocaleString('zh-CN');
    return `[${time}] ${role}: ${content}`;
  });
  return (contactInfo ? contactInfo + '\n\n' : '') + msgLines.join('\n');
}

export async function generateReply({ userId, accountId, jid, style = 'formal', model: modelKey = 'doubao-lite', messages: directMessages, length = 'medium', includeContext = false, extraPrompt } = {}) {
  let messages = directMessages || [];
  if (messages.length === 0 && accountId && jid) {
    messages = await getRecentMessages(accountId, jid, 20);
  }
  if (messages.length === 0) {
    return { replies: [], error: '暂无消息记录，无法生成回复' };
  }

  const contact = (accountId && jid) ? await getContactInfo(accountId, jid) : null;
  const contextStr = buildConversationContext(messages, contact);
  const stylePrompt = STYLE_PROMPTS[style] || STYLE_PROMPTS.formal;

  // ── Phase 5: Context injection from conversation-manager ──
  let contextBlock = '';
  let convStatusData = null;
  if (includeContext && jid) {
    try {
      const convMgr = await import('../routes/conversation-manager.js');
      convStatusData = await convMgr.getConversationStatus(jid);
      if (convStatusData && !convStatusData.error) {
        const bg = convStatusData.backgroundCheck;
        const bant = convStatusData.bantScore;
        const parts = [];
        if (bg) parts.push(`客户背调: ${bg.companyName || ''} (${bg.country || ''}, ${bg.industry || ''}, 规模: ${bg.companySize || '未知'})`);
        if (bant) parts.push(`BANT评分: Budget=${bant.budgetScore}/10, Authority=${bant.authorityScore}/10, Need=${bant.needScore}/10, Timeline=${bant.timelineScore}/10, 总评=${bant.totalScore}/10 (${bant.level || ''})`);
        parts.push(`信息完整度: ${Math.round((convStatusData.completeness || 0) * 100)}%`);
        parts.push(`当前策略: ${convStatusData.strategy === 'PROVIDE_QUOTE' ? '报价阶段(PROVIDE_QUOTE)' : '信息收集阶段(ASK_FOR_INFO)'}`);
        parts.push(`对话阶段: ${convStatusData.stage || '首次询盘'}`);
        if (convStatusData.requiredQuestions?.length) {
          const answered = convStatusData.requiredQuestions.filter(q => q.answered);
          const unanswered = convStatusData.requiredQuestions.filter(q => !q.answered);
          if (answered.length) parts.push(`已获取信息: ${answered.map(q => q.questionEn + '=' + (q.answer || 'Yes')).join('; ')}`);
          if (unanswered.length) parts.push(`待获取信息: ${unanswered.map(q => q.questionEn).join(', ')}`);
        }
        if (convStatusData.productName) parts.push(`产品: ${convStatusData.productName}`);
        contextBlock = '\n\n## 客户上下文信息\n' + parts.join('\n');
      }
    } catch (e) {
      console.warn('[generateReply] Phase5 context injection failed:', e.message);
    }
  }

  // ── Phase 6: Attitude context injection ──
  let attitudeBlock = '';
  let attitudeData = null;
  if (jid) {
    try {
      const { getAttitude } = await import('../routes/attitude-analysis.js');
      attitudeData = await getAttitude(jid);
      if (attitudeData && attitudeData.hasAnalysis) {
        const parts = [];
        parts.push(`客户意向: ${attitudeData.intentLevel} (${attitudeData.intentLevel === 'HIGH' ? '高' : attitudeData.intentLevel === 'LOW' ? '低' : '中'})`);
        parts.push(`情绪: ${attitudeData.sentiment} (${attitudeData.sentiment === 'POSITIVE' ? '积极' : attitudeData.sentiment === 'NEGATIVE' ? '消极' : '中性'})`);
        parts.push(`紧急度: ${attitudeData.urgency} (${attitudeData.urgency === 'URGENT' ? '紧急' : attitudeData.urgency === 'PATIENT' ? '不急' : '正常'})`);
        if (attitudeData.focusPoints && attitudeData.focusPoints.length > 0) {
          parts.push(`关注焦点: ${attitudeData.focusPoints.join('、')}`);
        }
        if (attitudeData.trend) {
          parts.push(`趋势: ${attitudeData.trend === 'IMPROVING' ? '↗ 改善中' : attitudeData.trend === 'DECLINING' ? '↘ 下降中' : '→ 稳定'}`);
        }
        attitudeBlock = '\n\n## 客户态度分析\n' + parts.join('\n');
      }
    } catch (e) {
      console.warn('[generateReply] Phase6 attitude injection failed:', e.message);
    }
  }

  // ── Phase 7: Action suggestions context ──
  let suggestionsBlock = '';
  if (jid) {
    try {
      const { getActiveSuggestions } = await import('../routes/action-suggestions.js');
      const sugData = await getActiveSuggestions(jid);
      if (sugData && sugData.success && sugData.suggestions && sugData.suggestions.length > 0) {
        const highPriority = sugData.suggestions.filter(s => s.priority === 'HIGH');
        if (highPriority.length > 0) {
          const sugParts = highPriority.slice(0, 2).map(s => `- [${s.actionType}] ${s.suggestion}`);
          suggestionsBlock = '\n\n## 行动建议\n' + sugParts.join('\n') + '\n请在回复中自然地体现这些建议方向。';
        }
      }
    } catch (e) {
      console.warn('[generateReply] Phase7 suggestions injection failed:', e.message);
    }
  }

  // ── Phase 5: Length control ──
  const lengthGuidance = {
    short: '每条回复控制在2-3句话，简洁快速回复风格。',
    medium: '每条回复5-8句话，标准商务话术长度。',
    long: '每条回复10-15句话，正式邮件风格，内容详细完整。'
  }[length] || '每条回复5-8句话，标准商务话术长度。';

  // ── Phase 5: Strategy-aware directive ──
  let strategyDirective = '';
  if (convStatusData?.strategy === 'PROVIDE_QUOTE') {
    strategyDirective = '\n\n【策略指示】当前已进入报价阶段，请在话术中包含报价相关内容（如价格、MOQ、交期、付款条件等）。';
  } else if (convStatusData?.strategy === 'ASK_FOR_INFO') {
    const unans = convStatusData?.requiredQuestions?.filter(q => !q.answered) || [];
    if (unans.length > 0) {
      const topQs = unans.slice(0, 3).map(q => q.questionEn).join(', ');
      strategyDirective = `\n\n【策略指示】当前仍在信息收集阶段，请自然地融入以下问题的询问: ${topQs}。不要像问卷，要自然融入对话。`;
    }
  }

  // ── Phase 5: Extra prompt from user ──
  let extraBlock = '';
  if (extraPrompt) {
    extraBlock = `\n\n【用户额外要求】${extraPrompt}`;
  }

  const systemPrompt = `${stylePrompt}

根据以下对话历史，生成3个不同的回复选项。${contextBlock}${attitudeBlock}${strategyDirective}${suggestionsBlock}${extraBlock}

【长度要求】${lengthGuidance}

【双语输出 - 最高优先级】
严格按以下JSON格式输出（纯JSON，不要markdown代码块，不要其他文字）：
{
  "replies": [
    {"foreign": "客户语言的回复1（可直接发送的外文原文）", "chinese": "对应的中文翻译1"},
    {"foreign": "客户语言的回复2", "chinese": "对应的中文翻译2"},
    {"foreign": "客户语言的回复3", "chinese": "对应的中文翻译3"}
  ]
}
- foreign: 使用客户的语言（客户用英文就英文，用阿文就阿文）
- chinese: foreign 的准确中文翻译，供业务员对照，必须填写不能留空
- 3个回复各有侧重，风格明显不同
- 回复直接可发送，不要额外解释`;

  // modelKey 是 providerId，按 id 路由到对应 provider
  let callProvider = null;
  let selectedModelId = null;
  if (modelKey) {
    callProvider = await getProviderById(modelKey);
    if (callProvider) selectedModelId = callProvider.model;
  }
  if (!callProvider) {
    // 降级到激活的 provider
    callProvider = await getActiveProvider();
    selectedModelId = callProvider?.model || DOUBAO_LITE_MODEL;
  }
  if (!callProvider?.apiKey) {
    return { replies: [], error: '未配置 AI 模型，请先在「设置-AI模型」添加 API Key', style };
  }

  const result = await aiChatComplete(
    [
      { role: 'system', content: systemPrompt },
      { role: 'user', content: contextStr },
    ],
    { temperature: 0.8, max_tokens: 2048, model: selectedModelId, provider: callProvider, timeout: 60000 }
  );

  // ── Phase 5: Parse bilingual JSON response ──
  let replies = [];
  try {
    let jsonStr = (result || '').trim();
    const fenceMatch = jsonStr.match(/```(?:json)?\s*([\s\S]*?)```/);
    if (fenceMatch) jsonStr = fenceMatch[1].trim();
    const first = jsonStr.indexOf('{');
    const last = jsonStr.lastIndexOf('}');
    if (first !== -1 && last > first) jsonStr = jsonStr.slice(first, last + 1);
    const parsed = JSON.parse(jsonStr);
    const arr = Array.isArray(parsed?.replies) ? parsed.replies : [];
    for (const r of arr.slice(0, 3)) {
      if (r && typeof r === 'object') {
        replies.push({ foreign: String(r.foreign || '').trim(), zh: String(r.chinese || r.zh || '').trim() });
      } else if (typeof r === 'string' && r.trim()) {
        replies.push({ foreign: r.trim(), zh: '' });
      }
    }
  } catch (_) {
    // Fallback: old-style text splitting
    const rawReplies = (result || '')
      .split(/---|\n[123][.、)）]\s*/)
      .map(s => s.trim())
      .filter(s => s.length > 5);
    for (const t of rawReplies.slice(0, 3)) {
      const hasZh = /[\u4e00-\u9fff]/.test(t);
      if (hasZh) {
        replies.push({ foreign: t, zh: '' });
      } else {
        try {
          const tr = await translateText(t, 'auto', 'zh', 'google', userId);
          replies.push({ foreign: t, zh: (tr?.translated || '').trim() });
        } catch (e) {
          replies.push({ foreign: t, zh: '' });
        }
      }
    }
  }

  // ── Phase 5: Build context summary for frontend ──
  const contextSummary = convStatusData && !convStatusData.error ? {
    backgroundCheck: convStatusData.backgroundCheck || null,
    bantScore: convStatusData.bantScore || null,
    completeness: convStatusData.completeness || 0,
    stage: convStatusData.stage || '首次询盘',
    strategy: convStatusData.strategy || 'ASK_FOR_INFO',
  } : null;

  return {
    replies,
    engine: 'active',
    style,
    length,
    model: modelKey,
    provider: callProvider?.name || callProvider?.provider || '',
    context: contextSummary,
  };
}


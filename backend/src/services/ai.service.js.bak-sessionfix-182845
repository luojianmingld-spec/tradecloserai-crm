/**
 * Transcribe audio file using Whisper API (via configured OpenAI-compatible endpoint)
 * @param {string} audioFilePath - Local path to audio file
 * @param {string} [model] - Whisper model name
 * @returns {Promise<string>} Transcribed text
 */
export async function transcribeAudio(audioFilePath, model = 'whisper-1') {
  const fs = await import('fs');
  const pathMod = await import('path');
  const https = await import('https');
  const http = await import('http');
  const { URL: URLCls } = await import('url');

  if (!fs.default.existsSync(audioFilePath)) {
    throw new Error('Audio file not found: ' + audioFilePath);
  }

  const audioBuffer = fs.default.readFileSync(audioFilePath);
  const fileName = pathMod.default.basename(audioFilePath);

  // Get API key from providers (prefer OpenAI-compatible endpoint)
  const providers = await getProviders();
  let apiKey = null;
  let baseUrl = 'https://oa.api2d.net/v1';

  for (const p of providers) {
    if (p.baseUrl && (p.baseUrl.includes('api2d') || p.provider === 'openai')) {
      apiKey = p.apiKey;
      baseUrl = p.baseUrl;
      break;
    }
  }
  if (!apiKey && providers.length > 0) {
    apiKey = providers[0].apiKey;
    if (providers[0].baseUrl) baseUrl = providers[0].baseUrl;
  }
  if (!apiKey) throw new Error('No API key found for transcription');

  // Build multipart form data
  const boundary = '----WhisperBoundary' + Date.now().toString(36);
  const CRLF = '\r\n';

  const textBefore = Buffer.from(
    `--${boundary}${CRLF}` +
    `Content-Disposition: form-data; name="model"${CRLF}${CRLF}` +
    `whisper-1${CRLF}` +
    `--${boundary}${CRLF}` +
    `Content-Disposition: form-data; name="file"; filename="${fileName}"${CRLF}` +
    `Content-Type: audio/ogg${CRLF}${CRLF}`,
    'utf8'
  );
  const textAfter = Buffer.from(`${CRLF}--${boundary}--${CRLF}`, 'utf8');
  const body = Buffer.concat([textBefore, audioBuffer, textAfter]);

  const urlObj = new URLCls(baseUrl.replace(/\/$/, '') + '/audio/transcriptions');
  const lib = urlObj.protocol === 'https:' ? https.default : http.default;

  return new Promise((resolve, reject) => {
    const req = lib.request({
      hostname: urlObj.hostname,
      port: urlObj.port,
      path: urlObj.pathname,
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': `multipart/form-data; boundary=${boundary}`,
        'Content-Length': body.length,
      },
      timeout: 60000,
    }, (res) => {
      const chunks = [];
      res.on('data', c => chunks.push(c));
      res.on('end', () => {
        try {
          const text = Buffer.concat(chunks).toString('utf8');
          const json = JSON.parse(text);
          if (json.text) {
            resolve(json.text.trim());
          } else if (json.error) {
            reject(new Error(`Whisper API: ${json.error.message || JSON.stringify(json.error)}`));
          } else {
            reject(new Error('Whisper unexpected: ' + text.slice(0, 200)));
          }
        } catch (e) {
          reject(new Error('Whisper parse error: ' + e.message));
        }
      });
    });
    req.on('timeout', () => req.destroy(new Error('Whisper timeout')));
    req.on('error', reject);
    req.write(body);
    req.end();
  });
}


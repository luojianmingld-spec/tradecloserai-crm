
/**
 * Product Import Service - 产品智能导入
 * 支持从URL抓取和文件上传，通过AI提取结构化产品数据
 */
import { chatComplete } from './ai-client.js';

// ── HTML → 纯文本 ──
function stripHtml(html) {
  return html
    .replace(/<(script|style|nav|footer|header)[^>]*>[\s\S]*?<\/\1>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<').replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"').replace(/&#39;/g, "'")
    .replace(/&mdash;/g, '-').replace(/&ndash;/g, '-')
    .replace(/&hellip;/g, '...')
    .replace(/&pound;/g, '£').replace(/&euro;/g, '€')
    .replace(/&yen;/g, '¥').replace(/&dollar;/g, '$')
    .replace(/\s+/g, ' ')
    .trim();
}

// ── 从URL抓取页面内容 ──
export async function scrapeUrl(url) {
  console.log('[ProductImport] Scraping URL:', url);
  
  const resp = await fetch(url, {
    headers: {
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
      'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
      'Accept-Language': 'en-US,en;q=0.9,zh-CN;q=0.8,zh;q=0.7',
    },
    signal: AbortSignal.timeout(30000),
  });
  
  if (!resp.ok) {
    throw new Error(`HTTP ${resp.status}: ${resp.statusText}`);
  }
  
  const html = await resp.text();
  const text = stripHtml(html);
  
  // Find product links for deeper crawling
  const productLinks = [];
  const linkRegex = /<a\s+[^>]*href=["']([^"']+)["'][^>]*>/gi;
  let match;
  while ((match = linkRegex.exec(html)) !== null) {
    const href = match[1];
    if (/product|item|detail|goods|catalog/i.test(href) && !href.startsWith('#')) {
      const absUrl = href.startsWith('http') ? href : new URL(href, url).href;
      if (!productLinks.includes(absUrl)) {
        productLinks.push(absUrl);
      }
    }
  }
  
  // Crawl sub-pages (limit 10)
  const subTexts = [];
  for (const link of productLinks.slice(0, 10)) {
    try {
      const subResp = await fetch(link, {
        headers: {
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
          'Accept': 'text/html,application/xhtml+xml',
        },
        signal: AbortSignal.timeout(15000),
      });
      if (subResp.ok) {
        const subHtml = await subResp.text();
        const subText = stripHtml(subHtml);
        if (subText.length > 100) {
          subTexts.push(subText.slice(0, 3000));
        }
      }
    } catch (e) {
      console.warn('[ProductImport] Sub-page failed:', link, e.message);
    }
  }
  
  const combinedText = text.slice(0, 8000) + '\n\n--- SUB PAGES ---\n\n' + subTexts.join('\n---\n');
  
  return {
    text: combinedText.slice(0, 25000),
    productLinkCount: productLinks.length,
    scannedPages: subTexts.length + 1,
  };
}

// ── AI提取产品数据 ──
export async function extractProductsFromText(text, sourceType = 'url', userNote = '') {
  console.log('[ProductImport] Extracting products, text length:', text.length, 'source:', sourceType, 'hasNote:', !!userNote);
  
  const noteSection = userNote 
    ? `\n\n【业务员备注】\n${userNote}\n\n请特别注意以上备注中的信息，如目标市场、产品定位、价格策略等，据此调整提取的产品信息和生成的问题。`
    : '';
  
  const systemPrompt = `你是一个专业的B2B外贸产品分析师。你需要从给定的文本中提取产品信息，输出严格的JSON格式。

对于每个识别到的产品，提取以下字段：
- productNameCn: 中文产品名（如果有）
- productNameEn: 英文产品名（必填）
- productDesc: 产品描述（1-3句话，突出卖点、材质、应用场景）
- specs: 产品规格参数（JSON对象，如 {"材质": "304不锈钢", "厚度": "0.5mm"} ），没有则留空对象
- pricingUnit: 计价单位（如 kg, piece, set, roll, meter, ton）
- basePrice: 基础价格数字（如果没有则null）
- moq: 最小起订量（文本描述，如 "1000 pcs", "1 ton"）
- deliveryDays: 交期（如 "15-20天", "2-3 weeks"）
- paymentTerms: 付款条件（如 "30% T/T advance", "L/C at sight"）
- questions: 需要向客户了解的问题清单，数组，每个元素包含:
  - questionCn: 中文问题
  - questionEn: 英文问题  
  - questionType: "text" | "number" | "single_choice" | "multiple_choice"
  - priority: 1(必问) 或 2(进阶)
  - optionsJson: 如果是选择题，提供选项数组，否则null

注意：
1. 如果文本中某信息缺失，对应字段填null或空字符串
2. productNameEn 是必填的，如果只有中文名就翻译为英文
3. 产品描述应专业、简洁、适合外贸B2B场景
4. 每个产品应生成3-5个必问问题和2-3个进阶问题
5. 问题应有针对性，帮助销售了解客户需求
6. 如有业务员备注，应结合备注来优化产品描述和问题

输出格式（严格JSON，不要markdown代码块）：
{"products": [{...}, {...}]}

如果文本中没有识别到任何产品，返回：{"products": [], "message": "未识别到产品信息"}`;

  const maxLen = 12000;
  const truncatedText = text.length > maxLen ? text.slice(0, maxLen) + '\n[...内容已截断...]' : text;
  const sourceLabel = sourceType === 'url' ? '网站' : '文档';
  
  const userPrompt = `以下是从${sourceLabel}中提取的文本内容，请分析并提取所有产品信息：${noteSection}\n\n${truncatedText}`;
  
  const result = await chatComplete(
    [
      { role: 'system', content: systemPrompt },
      { role: 'user', content: userPrompt },
    ],
    {
      temperature: 0.3,
      max_tokens: 8000,
    }
  );
  
  let cleaned = result.trim();
  if (cleaned.startsWith('```')) {
    cleaned = cleaned.replace(/^```(?:json)?\s*\n?/, '').replace(/\n?```\s*$/, '');
  }
  
  try {
    const parsed = JSON.parse(cleaned);
    return parsed.products || [];
  } catch (e) {
    console.error('[ProductImport] AI parse failed:', e.message, '\nRaw:', cleaned.slice(0, 500));
    throw new Error('AI返回格式异常，请重试');
  }
}

// ── 从URL导入 ──
export async function importFromUrl(url, userNote = '') {
  const scraped = await scrapeUrl(url);
  const products = await extractProductsFromText(scraped.text, 'url', userNote);
  return {
    products,
    meta: {
      source: url,
      productLinkCount: scraped.productLinkCount,
      scannedPages: scraped.scannedPages,
    }
  };
}

// ── 从文件导入 ──
export async function importFromFile(buffer, mimetype, filename, userNote = '') {
  let text = '';
  const ext = (filename || '').split('.').pop()?.toLowerCase();
  
  if (mimetype === 'application/pdf' || ext === 'pdf') {
    try {
      const pdfParse = (await import('pdf-parse')).default;
      const result = await pdfParse(buffer);
      text = result.text;
    } catch (e) {
      console.error('[ProductImport] PDF parse error:', e.message);
      throw new Error('PDF解析失败: ' + e.message);
    }
  } else if (mimetype === 'text/plain' || ext === 'txt' || mimetype === 'text/csv' || ext === 'csv') {
    text = buffer.toString('utf-8');
  } else if (
    mimetype?.includes('word') || ext === 'docx' || ext === 'doc'
  ) {
    // Basic Word .docx text extraction (it's a zip containing XML)
    const raw = buffer.toString('utf-8');
    const strings = [];
    const strRegex = />([^<]{3,})</g;
    let m;
    while ((m = strRegex.exec(raw)) !== null) {
      const s = m[1].trim();
      if (s && !/^[\d.]+$/.test(s)) strings.push(s);
    }
    text = strings.join('\n');
    if (text.length < 50) {
      throw new Error('暂不支持此Word格式，请导出为PDF后重试');
    }
  } else if (
    mimetype?.includes('spreadsheet') || mimetype?.includes('excel') || ext === 'xlsx' || ext === 'xls'
  ) {
    const raw = buffer.toString('utf-8');
    const strings = [];
    const strRegex = />([^<]{2,})</g;
    let m;
    while ((m = strRegex.exec(raw)) !== null) {
      const s = m[1].trim();
      if (s) strings.push(s);
    }
    text = strings.join('\n');
    if (text.length < 50) {
      throw new Error('暂不支持此Excel格式，请导出为CSV或PDF后重试');
    }
  } else {
    throw new Error('不支持的文件格式: ' + (mimetype || ext || 'unknown'));
  }
  
  const products = await extractProductsFromText(text, 'file', userNote);
  return {
    products,
    meta: {
      source: filename || '上传文件',
      fileSize: buffer.length,
    }
  };
}

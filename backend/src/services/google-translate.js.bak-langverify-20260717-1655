/**
 * Google Translate free adapter
 * Uses the public translate.googleapis.com/translate_a/single endpoint (no API key needed)
 * Node v22 global fetch available.
 */

const ENDPOINT = 'https://translate.googleapis.com/translate_a/single';
const DEFAULT_TIMEOUT_MS = 8000;

/**
 * Translate text via Google Translate public endpoint.
 * @param {string} text - source text
 * @param {string} from - source lang ISO 639-1 code, or 'auto'
 * @param {string} to   - target lang ISO 639-1 code
 * @returns {Promise<{ translated: string, detectedSourceLang?: string }>}
 */
export async function googleTranslate(text, from, to) {
  if (!text || typeof text !== 'string') {
    throw new Error('text is required');
  }
  const sl = from === 'auto' || !from ? 'auto' : from;
  const tl = to || 'en';

  const url = `${ENDPOINT}?client=gtx&sl=${encodeURIComponent(sl)}&tl=${encodeURIComponent(tl)}&dt=t&q=${encodeURIComponent(text)}`;

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), DEFAULT_TIMEOUT_MS);

  let resp;
  try {
    resp = await fetch(url, {
      method: 'GET',
      signal: controller.signal,
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; WhatsApp-CRM/1.0)',
        'Accept': 'application/json',
      },
    });
  } catch (e) {
    clearTimeout(timer);
    if (e.name === 'AbortError') {
      throw new Error('Google Translate request timed out');
    }
    throw new Error(`Google Translate network error: ${e.message}`);
  }
  clearTimeout(timer);

  if (!resp.ok) {
    throw new Error(`Google Translate HTTP ${resp.status}`);
  }

  let data;
  try {
    data = await resp.json();
  } catch (e) {
    throw new Error(`Google Translate parse error: ${e.message}`);
  }

  if (!Array.isArray(data) || !Array.isArray(data[0])) {
    throw new Error('Google Translate returned unexpected response shape');
  }

  // data[0] is an array of segments; each segment is [translated, original, ...]
  let translated = '';
  for (const seg of data[0]) {
    if (seg && typeof seg[0] === 'string') {
      translated += seg[0];
    }
  }

  if (!translated) {
    throw new Error('Google Translate returned empty translation');
  }

  // detected source lang when sl=auto is in data[2]
  const detectedSourceLang = sl === 'auto' && typeof data[2] === 'string' ? data[2] : undefined;

  return { translated, detectedSourceLang };
}

/**
 * Detect language using Google Translate (translate from auto -> en, grab detectedSourceLang).
 * @param {string} text
 * @returns {Promise<string>} ISO 639-1 code
 */
export async function googleDetect(text) {
  const { detectedSourceLang } = await googleTranslate(text, 'auto', 'en');
  if (!detectedSourceLang) {
    throw new Error('Google Translate did not return detected language');
  }
  return detectedSourceLang;
}

export async function generateDocument({ userId, accountId, jid, messages: directMessages, docType, customerInfo }) {
  let messages = directMessages || [];
  if (messages.length === 0 && accountId && jid) {
    messages = await getRecentMessages(accountId, jid, 50);
  }
  if (messages.length === 0) {
    return { content: "", error: "暂无消息记录，无法生成单证" };
  }

  const contact = (accountId && jid) ? await getContactInfo(accountId, jid) : null;
  const contextStr = buildConversationContext(messages, contact);

  const infoStr = customerInfo ? `
已确认的客户信息：
- 联系人：${customerInfo.contactName || "未知"}
- 公司：${customerInfo.companyName || "未知"}
- 电话：${customerInfo.phone || "未知"}
- 邮箱：${customerInfo.email || "未知"}
- 地址：${customerInfo.address || "未知"}
- 国家：${customerInfo.country || "未知"}
- 产品：${customerInfo.products || "未知"}
- 数量：${customerInfo.quantity || "未知"}
- 价格：${customerInfo.price || "未知"}
` : "";

  const docPrompts = {
    quotation: `请根据以下聊天记录和客户信息，生成一份专业的外贸报价单(Quotation)。
要求：
1. 包含：卖方信息(待填)、买方信息(从聊天提取)、产品明细表(产品名、规格、单价、数量、金额)、付款条件、交货期、报价有效期

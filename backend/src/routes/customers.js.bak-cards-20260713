    if (!/^\d+$/.test(req.params.id)) return next('route');
    const id = parseInt(req.params.id);
    const customer = await prisma.customer.findUnique({ where: { id } });
    if (!customer) return res.status(404).json({ error: 'Customer not found' });
    if (!customer.jid) return res.status(400).json({ error: '该客户无WhatsApp JID，无法生成' });

    const limit = Math.min(parseInt(req.body.limit) || 300, 800);
    const messages = await prisma.wAMessage.findMany({
      where: { OR: [{ from: customer.jid }, { to: customer.jid }] },
      orderBy: { timestamp: 'asc' },
      take: limit,
    });
    if (!messages.length) {
      return res.status(400).json({ error: '暂无聊天记录，无法生成跟进' });
    }

    // Group into daily segments
    const segments = []; // { date: YYYY-MM-DD, msgs: [] }
    for (const m of messages) {
      if (!m.body || !m.timestamp) continue;
      const d = new Date(m.timestamp);
      const key = d.toISOString().slice(0, 10);
      let seg = segments.find(s => s.date === key);
      if (!seg) { seg = { date: key, msgs: [] }; segments.push(seg); }
      seg.msgs.push(m);
    }

    const modelId = await resolveModelId();
    const systemPrompt = `你是一个外贸业务跟进记录总结助手。根据与客户的WhatsApp聊天记录（按天分段），用中文总结当天的关键沟通要点，100字以内，包含：客户需求/询盘内容、报价情况、异议/问题、承诺的下一步动作。只输出中文总结文本，不要任何JSON/格式。如果当天无实质沟通内容，回复"无实质沟通"。`;

    const generated = [];
    for (const seg of segments) {
      const context = seg.msgs.slice(-30).map(m => {
        const who = (m.direction === 'outbound' || m.direction === 'outgoing') ? '我' : '客户';
        const ts = new Date(m.timestamp).toISOString().slice(11, 16);
        return `[${ts}] ${who}: ${(m.body || '').slice(0, 500)}`;
      }).join('\n');
      let summary = '';
      try {
        summary = await chatComplete(modelId, systemPrompt,
          `日期：${seg.date}，共${seg.msgs.length}条消息\n聊天记录：\n${context}\n\n请总结：`,
          { temperature: 0.3, maxTokens: 220 });
        summary = (summary || '').trim();
      } catch (e) {
        console.error('[Customers] generate-followups segment error:', e.message);
        summary = '（AI总结失败）';
      }
      if (summary && !/无实质沟通/.test(summary)) {
        const content = `${seg.date}：${summary.replace(/^["""]|["""]$/g, '')}`;
        generated.push({
          date: seg.date,
          content,
          msgCount: seg.msgs.length,
        });
      }
    }

    // Replace existing ai_summary entries for this customer
    await prisma.customerFollowUp.deleteMany({ where: { customerId: id, source: 'ai_summary' } });
    const created = [];
    for (const g of generated) {
      const fu = await prisma.customerFollowUp.create({
        data: {
          customerId: id,
          content: g.content,
          source: 'ai_summary',
          metadata: JSON.stringify({ date: g.date, msgCount: g.msgCount, generatedAt: new Date().toISOString() }),
          createdAt: new Date(g.date + 'T12:00:00Z'),
        },
      });
      created.push(fu);
    }

    res.json({ success: true, generated: created.length, items: created });
  } catch (err) {
    console.error('[Customers] generate-followups error:', err);
    res.status(500).json({ error: 'AI总结失败: ' + err.message });
  }
});


// ─── Documents for a customer ───
router.get('/:id/documents', async (req, res, next) => {
  try {
    if (!/^\d+$/.test(req.params.id)) return next('route');
    const id = parseInt(req.params.id);
    const { type } = req.query;
    const where = { customerId: id };
    if (type) where.type = type.toUpperCase();
    const docs = await prisma.document.findMany({
      where,
      include: { items: true },
      orderBy: { createdAt: 'desc' },
    });
    // Stats
    const [total, totalAmt, pending] = await Promise.all([
      prisma.document.count({ where: { customerId: id } }),
      prisma.document.aggregate({ where: { customerId: id, status: { not: 'DRAFT' } }, _sum: { totalAmount: true } }),
      prisma.document.count({ where: { customerId: id, status: 'DRAFT' } }),
    ]);
    res.json({
      items: docs.map(d => ({
        ...d,
        sellerInfo: typeof d.sellerInfo === 'string' ? JSON.parse(d.sellerInfo) : d.sellerInfo,
        buyerInfo: typeof d.buyerInfo === 'string' ? JSON.parse(d.buyerInfo) : d.buyerInfo,
      })),
      stats: { total, totalAmount: totalAmt._sum.totalAmount || 0, pending },
    });
  } catch (err) {
    console.error('[Customers] documents error:', err);
    res.status(500).json({ error: 'Failed to load documents' });
  }
});


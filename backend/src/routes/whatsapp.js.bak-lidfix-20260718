/**
 * WhatsApp API 路由 — 修复版
 * POST /api/whatsapp/send 修复：
 *  - 不再做自动翻译，只发送原文
 *  - 落库后只 emit 一次 whatsapp:message_sent（provider 不再 emit 'sent'，避免重复）
 */

import { Router } from 'express';
import { authMiddleware } from '../middleware/auth.js';
import whatsappProvider from '../services/whatsapp-provider.js';
import { PrismaClient } from '@prisma/client';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { translateText, detectLanguage } from '../services/ai.service.js';

// Per-customer translation settings (merged with global)
import { getTranslationSettings } from './translation.js';

// 严格的语言文字判定：非拉丁语用字符集判断，拉丁语用字符占比判断
function isAlreadyInLang(text, targetLang) {
  if (!text) return false;
  const sample = text.slice(0, 500);
  const hasJapanese = /[\u3040-\u309f\u30a0-\u30ff]/.test(sample);
  const hasKorean = /[\uac00-\ud7af]/.test(sample);
  const hasCJK = /[\u4e00-\u9fff]/.test(sample);
  const hasArabic = /[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff]/.test(sample);
  const hasCyrillic = /[\u0400-\u04ff\u0500-\u052f]/.test(sample);
  if (targetLang === 'ja') return hasJapanese;
  if (targetLang === 'ko') return hasKorean;
  if (targetLang === 'zh') return hasCJK && !hasJapanese && !hasKorean;
  if (targetLang === 'ar') return hasArabic;
  if (targetLang === 'ru') return hasCyrillic;
  // Latin-script languages: must NOT contain non-latin scripts
  if (['en','es','fr','de','pt','it','nl','tr','id','vi'].includes(targetLang)) {
    if (hasCJK || hasArabic || hasCyrillic || hasJapanese || hasKorean) return false;
    const latin = (sample.match(/[A-Za-zÀ-ÿ]/g) || []).length;
    const total = sample.replace(/\s+/g, '').length;
    return total > 0 && (latin / total) > 0.5;
  }
  return false;
}

const router = Router();
const prisma = new PrismaClient();
router.use(authMiddleware);

/** POST /api/whatsapp/qr — 生成二维码，开始连接 */
router.post('/qr', async (req, res) => {
  try {
    const userId = req.userId;
    const sessionId = `user_${userId}`;
    const result = await whatsappProvider.connect(sessionId, userId);
    if (result.status === 'unavailable') {
      return res.status(503).json({ error: result.message, status: 'unavailable' });
    }
    res.json({ ...result, sessionId });
  } catch (err) {
    console.error('[WA QR Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** POST /api/whatsapp/send — 发送消息（发送前强制按翻译设置转换为目标语言，失败回退原文） */
router.post('/send', async (req, res) => {
  try {
    const body = req.body || {};
    const { to, message, skipTranslate } = body;
    if (!to || !message) {
      return res.status(400).json({ error: 'to and message are required' });
    }

    const sessionId = `user_${req.userId}`;
    let toJid = to;
    if (!toJid.includes('@')) toJid = `${toJid}@s.whatsapp.net`;

    // 1. 发送前强制翻译：正文译成sendTargetLang发出，虚线译文永远是中文
    let outgoingText = String(message);
    let translatedMeta = null;
    try {
      const ts = await getTranslationSettings(toJid, req.userId);
      let targetLang = ts.sendTargetLang || null;
      const engine = ts.sendEngine || 'google';
      if (!skipTranslate && ts.sendEnabled && targetLang && targetLang !== 'auto') {
        const fastOk = isAlreadyInLang(outgoingText, targetLang);
        // 检测源语言
        let sourceLang = 'auto';
        try {
          const detected = await detectLanguage(outgoingText, engine);
          if (detected && detected !== 'unknown') sourceLang = detected;
        } catch (_) { sourceLang = 'auto'; }
        if (!fastOk && sourceLang !== targetLang) {
          // 需要翻译到目标语发出
          const tr = await translateText(outgoingText, sourceLang, targetLang, engine, req.userId);
          if (tr && tr.translated && tr.translated.trim() && !tr.error) {
            outgoingText = tr.translated.trim();
            // 虚线永远是中文：若原文不是中文则回译中文
            let zhOriginal = String(message);
            if (sourceLang !== 'zh') {
              try {
                const zhTr = await translateText(String(message), sourceLang, 'zh', engine, req.userId);
                if (zhTr && zhTr.translated && zhTr.translated.trim() && !zhTr.error) {
                  zhOriginal = zhTr.translated.trim();
                }
              } catch (_) {}
            }
            translatedMeta = { sourceLang, targetLang, original: zhOriginal };
          }
        } else {
          // 已是目标语（或fastOk命中）：正文不变，但目标语非中文时补中文虚线
          if (targetLang !== 'zh') {
            try {
              const srcForZh = sourceLang === 'auto' ? targetLang : sourceLang;
              const zhTr = await translateText(outgoingText, srcForZh, 'zh', engine, req.userId);
              if (zhTr && zhTr.translated && zhTr.translated.trim() && !zhTr.error) {
                translatedMeta = { sourceLang: srcForZh, targetLang, original: zhTr.translated.trim() };
              }
            } catch (_) {}
          }
        }
      }
    } catch (te) {
      console.warn('[WA Send] pre-translate failed, sending original:', te.message);
    }

    // 2. 通过 provider 发送（可能是已翻译文本）
    const result = await whatsappProvider.sendMessage(sessionId, toJid, outgoingText);



    // 2. 查出我方连接信息
    const conn = await prisma.wAConnection.findUnique({ where: { sessionId } });
    const meFrom = conn?.phone ? `${conn.phone}@s.whatsapp.net` : 'me';

    // 3. 落库保存消息
    let saved = null;
    try {
      saved = await prisma.wAMessage.create({
        data: {
          sessionId,
          from: meFrom,
          to: toJid,
          body: outgoingText,
          type: 'text',
          direction: 'outbound',
          timestamp: new Date(),
          waMessageId: result.messageId || null,
        },
      });
    } catch (e) {
      console.warn('[WA] save outgoing via REST failed:', e.message);
    }

    // 3b. If translation happened, persist translation JSON so history loads correctly
    if (translatedMeta && saved?.id) {
      const transJson = JSON.stringify({
        original: translatedMeta.original || String(message),
        translated: outgoingText,
        sourceLang: translatedMeta.sourceLang || "auto",
        targetLang: translatedMeta.targetLang || targetLang,
      });
      try {
        await prisma.wAMessage.update({ where: { id: saved.id }, data: { translation: transJson, sourceLang: translatedMeta.sourceLang || null } });
      } catch (pe) { console.warn("[WA Send] persist translation failed:", pe.message); }
    }

    // 4. 自动创建/更新客户
    try {
      const phone = toJid.split('@')[0];
      const existing = await prisma.customer.findFirst({ where: { userId: req.userId, phone } });
      if (!existing) {
        await prisma.customer.create({
          data: { userId: req.userId, phone, name: phone, source: 'whatsapp', status: 'potential', lastContactAt: new Date() },
        });
      } else {
        await prisma.customer.update({ where: { id: existing.id }, data: { lastContactAt: new Date() } });
      }
    } catch (e) { /* ignore */ }

    // 5. 只 emit 一次 whatsapp:message_sent（带真实 savedId，前端据此替换 tmp- 条目）
    try {
      const io = req.app.get('io');
      if (io) {
        io.to(`user_${req.userId}`).emit('whatsapp:message_sent', {
          id: saved?.id || ('tmp-' + Date.now()),
          waMessageId: result.messageId || null,
          to: toJid,
          from: meFrom,
          body: outgoingText,
          content: outgoingText,
          direction: 'outbound',
          translation: translatedMeta,
          fromMe: true,
          messageType: 'text',
          timestamp: saved?.timestamp || new Date(),
        });
      }
    } catch (e) { /* ignore */ }

    res.json({ savedId: saved?.id, messageId: result.messageId, key: result.key, success: result.success, translation: translatedMeta, body: outgoingText });
  } catch (err) {
    console.error('[WA Send Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});


});

/** POST /api/whatsapp/conversations/:jid/block  切换封锁（封锁时清未读） */
router.post('/conversations/:jid/block', async (req, res) => {
  try {
    const jid = decodeURIComponent(req.params.jid);
    const accountId = 1;
    let conv = await prisma.conversation.findUnique({
      where: { accountId_jid: { accountId, jid } },
    });
    if (!conv) conv = await ensureConversation(accountId, jid);
    if (!conv) return res.status(404).json({ error: 'conversation not found' });
    const newBlocked = !conv.blocked;
    const updated = await prisma.conversation.update({
      where: { id: conv.id },
      data: {
        blocked: newBlocked,
        unreadCount: newBlocked ? 0 : conv.unreadCount,
        updatedAt: new Date(),
      },
    });
    res.json({ success: true, jid, blocked: updated.blocked });
  } catch (err) {
    console.error('[WA Block Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** DELETE /api/whatsapp/conversations/:jid  删除聊天（清WAMessage，不删Conversation/Customer） */
router.delete('/conversations/:jid', async (req, res) => {
  try {
    const jid = decodeURIComponent(req.params.jid);
    const sessionId = `user_${req.userId}`;
    // 删除该会话所有消息：方向是对方发来(from=jid) 或 我方发往(to=jid)
    const result = await prisma.wAMessage.deleteMany({
      where: {
        sessionId,
        OR: [
          { from: jid, direction: 'inbound' },
          { to: jid, direction: 'outbound' },
        ],
      },
    });
    // 同时清unread计数
    try {
      const accountId = 1;
      const conv = await prisma.conversation.findUnique({
        where: { accountId_jid: { accountId, jid } },
      });
      if (conv) {
        await prisma.conversation.update({
          where: { id: conv.id },
          data: { unreadCount: 0, lastMessage: null, lastMessageAt: null, updatedAt: new Date() },
        });
      }
    } catch (_) { /* ignore */ }
    res.json({ success: true, jid, deletedCount: result.count });
  } catch (err) {
    console.error('[WA Delete Conv Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

export default router;

/** POST /api/whatsapp/pairing-code — 通过手机号获取8位配对码登录 */
router.post('/pairing-code', async (req, res) => {
  try {
    const { phone } = req.body || {};
    if (!phone) return res.status(400).json({ error: 'phone number is required' });
    const sessionId = `user_${req.userId}`;
    // 确保连接已建立
    let status = whatsappProvider.getStatus(sessionId);
    if (status.status !== 'waiting_qr' && status.status !== 'connecting') {
      // 自动发起连接
      await whatsappProvider.connect(sessionId, req.userId);
      // 等2秒让QR/socket就绪
      await new Promise(r => setTimeout(r, 2500));
    }
    const result = await whatsappProvider.requestPairingCode(sessionId, phone);
    res.json({ success: true, ...result });
  } catch (err) {
    console.error('[WA Pairing Code Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});


/** GET /api/whatsapp/connections */
router.get('/connections', async (req, res) => {
  try {
    const connections = whatsappProvider.getActiveConnections();
    const dbConns = await prisma.wAConnection.findMany();
    const merged = connections.map(c => {
      const db = dbConns.find(d => d.sessionId === c.sessionId);
      return { ...c, lastConnectedAt: db?.lastConnectedAt };
    });
    res.json(merged);
  } catch (err) {
    console.error('[WA Connections Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** GET /api/whatsapp/messages */
router.get('/messages', async (req, res) => {
  try {
    const { jid, limit = 50, before } = req.query;
    if (!jid) return res.status(400).json({ error: 'jid is required' });

    const sessionId = `user_${req.userId}`;
    const where = { sessionId, OR: [{ from: jid }, { to: jid }] };
    if (before) where.timestamp = { lt: new Date(before) };

    const messages = await prisma.wAMessage.findMany({
      where, orderBy: { timestamp: 'desc' }, take: parseInt(limit),
    });
    res.json(messages.reverse());
  } catch (err) {
    console.error('[WA Messages Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** Helper: ensure a Conversation record exists for (accountId, jid); also creates Contact if needed */
async function ensureConversation(accountId, jid) {
  try {
    if (!jid || !jid.includes('@')) return null;
    // find or create contact
    let contact = await prisma.contact.findUnique({
      where: { accountId_jid: { accountId, jid } },
    });
    if (!contact) {
      const phone = jid.split('@')[0];
      try {
        contact = await prisma.contact.create({
          data: { accountId, jid, phone },
        });
      } catch (e) {
        contact = await prisma.contact.findUnique({
          where: { accountId_jid: { accountId, jid } },
        });
      }
    }
    let conv = await prisma.conversation.findUnique({
      where: { accountId_jid: { accountId, jid } },
    });
    if (!conv && contact) {
      try {
        conv = await prisma.conversation.create({
          data: {
            accountId,
            contactId: contact.id,
            jid,
            pinned: false, starred: false, blocked: false,
          },
        });
      } catch (e) {
        conv = await prisma.conversation.findUnique({
          where: { accountId_jid: { accountId, jid } },
        });
      }
    }
    return conv;
  } catch (e) {
    console.warn('[ensureConversation] error', e.message);
    return null;
  }
}

/** GET /api/whatsapp/conversations — 聚合WAMessage, 读取Conversation标记 */
router.get('/conversations', async (req, res) => {
  try {
    const sessionId = `user_${req.userId}`;
    const search = (req.query.search || '').toString().trim();
    const filter = (req.query.filter || 'all').toString();
    const showBlocked = req.query.showBlocked === '1';

    // 取默认accountId=1（单账号部署）
    const accountId = 1;

    const allMsgs = await prisma.wAMessage.findMany({
      where: { sessionId }, orderBy: { timestamp: 'desc' }, take: 500,
    });

    const contactMap = new Map();
    for (const msg of allMsgs) {
      const contactJid = msg.direction === 'inbound' ? msg.from : msg.to;
      if (!contactJid || contactJid === 'me' || !contactJid.includes('@')) continue;
      if (contactJid.includes('@g.us')) continue; // 跳过群组
      if (!contactMap.has(contactJid)) {
        contactMap.set(contactJid, {
          lastMsg: msg,
          unread: (msg.direction === 'inbound' && !msg.read) ? 1 : 0,
        });
      } else {
        const entry = contactMap.get(contactJid);
        if (msg.direction === 'inbound' && !msg.read) entry.unread += 1;
      }
    }

    const phones = [...contactMap.keys()].map(j => j.split('@')[0]);
    const customers = phones.length
      ? await prisma.customer.findMany({
          where: { userId: req.userId, phone: { in: phones } },
          select: { id: true, phone: true, name: true },
        })
      : [];
    const custMap = new Map(customers.map(c => [c.phone, c]));

    // 批量获取所有jid对应的Conversation记录
    const jids = [...contactMap.keys()];
    const convRecords = jids.length
      ? await prisma.conversation.findMany({
          where: { accountId, jid: { in: jids } },
        })
      : [];
    const convMap = new Map(convRecords.map(c => [c.jid, c]));

    // 确保每个jid都有Conversation记录（异步，不阻塞响应）
    for (const jid of jids) {
      if (!convMap.has(jid)) {
        const c = await ensureConversation(accountId, jid);
        if (c) convMap.set(jid, c);
      }
    }

    const conversations = [];
    for (const [jid, entry] of contactMap) {
      const phone = jid.split('@')[0];
      const cust = custMap.get(phone);
      const name = cust?.name || phone;
      const conv = convMap.get(jid) || { pinned: false, starred: false, blocked: false };

      // 默认过滤blocked
      if (conv.blocked && !showBlocked) continue;

      // 筛选器
      if (filter === 'unread' && entry.unread === 0) continue;
      if (filter === 'starred' && !conv.starred) continue;

      if (search && !name.includes(search) && !phone.includes(search) && !(entry.lastMsg.body || '').includes(search)) continue;

      conversations.push({
        jid, phone, name,
        lastMessage: entry.lastMsg.body,
        lastMessageTime: entry.lastMsg.timestamp,
        direction: entry.lastMsg.direction,
        unreadCount: entry.unread,
        pinned: !!conv.pinned,
        starred: !!conv.starred,
        blocked: !!conv.blocked,
      });
    }

    // 排序：pinned优先，其次按lastMessageTime降序
    conversations.sort((a, b) => {
      if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
      return new Date(b.lastMessageTime) - new Date(a.lastMessageTime);
    });

    res.json(conversations);
  } catch (err) {
    console.error('[WA Conversations Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** Helper: toggle boolean field on Conversation, upsert if missing */
async function toggleConversationField(jid, field) {
  const accountId = 1;
  let conv = await prisma.conversation.findUnique({
    where: { accountId_jid: { accountId, jid } },
  });
  if (!conv) {
    conv = await ensureConversation(accountId, jid);
  }
  if (!conv) throw new Error('conversation not found');
  const newVal = !conv[field];
  const updated = await prisma.conversation.update({
    where: { id: conv.id },
    data: { [field]: newVal, updatedAt: new Date() },
  });
  return updated;
}

/** POST /api/whatsapp/conversations/:jid/pin  切换置顶 */
router.post('/conversations/:jid/pin', async (req, res) => {
  try {
    const jid = decodeURIComponent(req.params.jid);
    const updated = await toggleConversationField(jid, 'pinned');
    res.json({ success: true, jid, pinned: updated.pinned });
  } catch (err) {
    console.error('[WA Pin Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** POST /api/whatsapp/conversations/:jid/star  切换特别关注 */
router.post('/conversations/:jid/star', async (req, res) => {
  try {
    const jid = decodeURIComponent(req.params.jid);
    const updated = await toggleConversationField(jid, 'starred');
    res.json({ success: true, jid, starred: updated.starred });
  } catch (err) {
    console.error('[WA Star Error]', err.message);

/**
 * WhatsApp API 路由
 * POST /api/whatsapp/qr       — 生成二维码
 * POST /api/whatsapp/send     — 发送消息
 * GET  /api/whatsapp/status   — 获取连接状态
 * POST /api/whatsapp/disconnect — 断开连接
 * GET  /api/whatsapp/connections — 获取所有连接
 * GET  /api/whatsapp/messages   — 获取聊天消息
 * GET  /api/whatsapp/conversations — 获取会话列表
 */

import { Router } from 'express';
import { authMiddleware } from '../middleware/auth.js';
import whatsappProvider from '../services/whatsapp-provider.js';
import { PrismaClient } from '@prisma/client';

const router = Router();
const prisma = new PrismaClient();

// 所有路由需要认证
router.use(authMiddleware);

/** POST /api/whatsapp/qr — 生成二维码，开始连接 */
router.post('/qr', async (req, res) => {
  try {
    const userId = req.userId;
    const sessionId = `user_${userId}`;

    const result = await whatsappProvider.connect(sessionId, userId);
    if (result.status === 'unavailable') {
      return res.status(503).json({ error: result.message, status: 'unavailable' });
    }
    res.json({ ...result, sessionId });
  } catch (err) {
    console.error('[WA QR Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** POST /api/whatsapp/send — 发送消息 */
router.post('/send', async (req, res) => {
  try {
    const body = req.body || {};
    const { to, message, sessionId: customSessionId } = body;
    if (!to || !message) {
      return res.status(400).json({ error: 'to and message are required' });
    }

    const sessionId = customSessionId || `user_${req.userId}`;

    // 先把我方JID规范化
    let toJid = to;
    if (!toJid.includes('@')) toJid = `${toJid}@s.whatsapp.net`;

    const result = await whatsappProvider.sendMessage(sessionId, toJid, message);

    // 查出连接，拿到 from
    const conn = await prisma.wAConnection.findUnique({ where: { sessionId } });
    const meFrom = conn?.phone ? `${conn.phone}@s.whatsapp.net` : 'me';
    const saved = await prisma.wAMessage.create({
      data: {
        sessionId,
        from: meFrom,
        to: toJid,
        body: message,
        type: 'text',
        direction: 'outbound',
        timestamp: new Date(),
        waMessageId: result.messageId || null,
      },
    }).catch(e => { console.warn('[WA] save outgoing via REST failed:', e.message); return null; });

    // 自动创建/更新客户
    try {
      const phone = toJid.split('@')[0];
      const existing = await prisma.customer.findFirst({ where: { userId: req.userId, phone } });
      if (!existing) {
        await prisma.customer.create({
          data: { userId: req.userId, phone, name: phone, source: 'whatsapp', status: 'potential', lastContactAt: new Date() },
        });
      } else {
        await prisma.customer.update({ where: { id: existing.id }, data: { lastContactAt: new Date() } });
      }
    } catch (e) { /* ignore */ }

    // 实时推送到前端
    try {
      const io = req.app.get('io');
      if (io) {
        io.to(`user_${req.userId}`).emit('whatsapp:message_sent', {
          id: saved?.id || Date.now(),
          to: toJid,
          from: meFrom,
          body: message,
          direction: 'outbound',
          timestamp: saved?.timestamp || new Date(),
        });
      }
    } catch (e) { /* ignore */ }

    res.json({ ...result, savedId: saved?.id });
  } catch (err) {
    console.error('[WA Send Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** GET /api/whatsapp/status — 获取连接状态 */
router.get('/status', async (req, res) => {
  try {
    const sessionId = req.query.sessionId || `user_${req.userId}`;
    const status = whatsappProvider.getStatus(sessionId);

    // 从数据库补充信息
    const conn = await prisma.wAConnection.findUnique({ where: { sessionId } });

    res.json({
      ...status,
      sessionId,
      lastConnectedAt: conn?.lastConnectedAt,
    });
  } catch (err) {
    console.error('[WA Status Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** POST /api/whatsapp/disconnect — 断开连接 */
router.post('/disconnect', async (req, res) => {
  try {
    const body = req.body || {};
    const sessionId = body.sessionId || `user_${req.userId}`;
    await whatsappProvider.disconnect(sessionId);
    res.json({ success: true });
  } catch (err) {
    console.error('[WA Disconnect Error]', err.stack || err.message);
    res.status(500).json({ error: err.message });
  }
});

/** GET /api/whatsapp/connections — 获取所有连接 */
router.get('/connections', async (req, res) => {
  try {
    const connections = whatsappProvider.getActiveConnections();
    // 补充数据库信息
    const dbConns = await prisma.wAConnection.findMany();
    const merged = connections.map(c => {
      const db = dbConns.find(d => d.sessionId === c.sessionId);
      return { ...c, lastConnectedAt: db?.lastConnectedAt };
    });
    res.json(merged);
  } catch (err) {
    console.error('[WA Connections Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** GET /api/whatsapp/messages — 获取与某个联系人的聊天消息 */
router.get('/messages', async (req, res) => {
  try {
    const { jid, limit = 50, before } = req.query;
    if (!jid) {
      return res.status(400).json({ error: 'jid is required' });
    }

    const sessionId = `user_${req.userId}`;
    const where = {
      sessionId,
      OR: [
        { from: jid },
        { to: jid },
      ],
    };

    if (before) {
      where.timestamp = { lt: new Date(before) };
    }

    const messages = await prisma.wAMessage.findMany({
      where,
      orderBy: { timestamp: 'desc' },
      take: parseInt(limit),
    });

    res.json(messages.reverse());
  } catch (err) {
    console.error('[WA Messages Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

/** GET /api/whatsapp/conversations — 获取会话列表 */
router.get('/conversations', async (req, res) => {
  try {
    const sessionId = `user_${req.userId}`;
    const search = (req.query.search || '').toString().trim();

    // 取最近 500 条消息，按联系人聚合（SQLite 不支持 distinct 多列可靠行为，手动聚合）
    const allMsgs = await prisma.wAMessage.findMany({
      where: { sessionId },
      orderBy: { timestamp: 'desc' },
      take: 500,
    });

    const contactMap = new Map(); // jid -> { lastMsg, unread }
    for (const msg of allMsgs) {
      const contactJid = msg.direction === 'inbound' ? msg.from : msg.to;
      if (!contactJid || contactJid === 'me' || !contactJid.includes('@')) continue;

      if (!contactMap.has(contactJid)) {
        contactMap.set(contactJid, { lastMsg: msg, unread: (msg.direction === 'inbound' && !msg.read) ? 1 : 0 });
      } else {
        const entry = contactMap.get(contactJid);
        if (msg.direction === 'inbound' && !msg.read) entry.unread += 1;
      }
    }

    // 客户名称批量查
    const phones = [...contactMap.keys()].map(j => j.split('@')[0]);
    const customers = phones.length
      ? await prisma.customer.findMany({
          where: { userId: req.userId, phone: { in: phones } },
          select: { id: true, phone: true, name: true },
        })
      : [];
    const custMap = new Map(customers.map(c => [c.phone, c]));

    const conversations = [];
    for (const [jid, entry] of contactMap) {
      const phone = jid.split('@')[0];
      const cust = custMap.get(phone);
      const name = cust?.name || phone;
      if (search && !name.includes(search) && !phone.includes(search) && !(entry.lastMsg.body || '').includes(search)) continue;
      conversations.push({
        jid,
        phone,
        name,
        lastMessage: entry.lastMsg.body,
        lastMessageTime: entry.lastMsg.timestamp,
        direction: entry.lastMsg.direction,
        unreadCount: entry.unread,
      });
    }

    conversations.sort((a, b) => new Date(b.lastMessageTime) - new Date(a.lastMessageTime));

    res.json(conversations);
  } catch (err) {
    console.error('[WA Conversations Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});

export default router;

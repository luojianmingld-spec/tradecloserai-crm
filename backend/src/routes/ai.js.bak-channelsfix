import { Router } from 'express';
import { authMiddleware as auth } from '../middleware/auth.js';
import {
  translateText,
  translateOutgoing,
  detectLanguage,
  generateReply,
  summarizeNeed,
  extractCustomerInfo,
  getAvailableModels,
  generateDocument,
} from '../services/ai.service.js';
import { chatComplete as rawChatComplete, getActiveProvider } from '../services/ai-client.js';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

// Helpers for building conversation context (mirrors ai.service.js internal helpers)
async function getRecentMessagesForChat(accountId, jid, limit = 20) {
  return prisma.message.findMany({
    where: { accountId, remoteJid: jid },
    orderBy: { timestamp: 'desc' },
    take: limit,
  });
}
async function getContactForChat(accountId, jid) {
  return prisma.contact.findUnique({
    where: { accountId_jid: { accountId, jid } },
  });
}
function buildContextForChat(messages, contact) {
  const contactInfo = contact ? `客户: ${contact.name || '未知'}, 国家: ${contact.country || '未知'}, 语言: ${contact.language || '未知'}` : '';
  const lines = messages.slice().reverse().map(m => {
    const role = m.fromMe ? '我方' : '客户';
    const t = new Date(m.timestamp).toLocaleString('zh-CN');
    return `[${t}] ${role}: ${m.content}`;
  });
  return (contactInfo ? contactInfo + '\n\n' : '') + lines.join('\n');
}

const router = Router();

router.post('/translate', auth, async (req, res) => {
  try {
    const { text, sourceLang, targetLang, engine } = req.body;
    if (!text) return res.status(400).json({ error: 'text is required' });

    const src = sourceLang || 'auto';
    const tgt = targetLang || 'zh';
    const eng = engine || 'doubao';

    let detectedLang = src;
    if (src === 'auto') {
      detectedLang = await detectLanguage(text, eng);
    }

    const result = await translateText(text, detectedLang, tgt, eng, req.userId);
    res.json(result);
  } catch (err) {
    console.error('[AI Translate Error]', err);
    res.status(500).json({ error: '翻译失败: ' + err.message });
  }
});

// ─── POST /api/ai/reply — AI 话术生成 ───
router.post('/reply', auth, async (req, res) => {
  try {
    const { accountId, jid, style, messages } = req.body;
    // Support either direct messages array or accountId+jid to fetch from DB
    if (!messages?.length && (!accountId || !jid)) {
      return res.status(400).json({ error: 'Provide either messages array or accountId+jid' });
    }

    const result = await generateReply({
      userId: req.userId,
      accountId: accountId ? parseInt(accountId) : null,
      jid: jid || null,
      style: style || 'formal',
      messages,
    });
    res.json(result);
  } catch (err) {
    console.error('[AI Reply Error]', err);
    res.status(500).json({ error: '话术生成失败: ' + err.message });
  }
});


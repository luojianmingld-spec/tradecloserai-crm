// ─── POST /api/ai/chat — 通用单轮AI对话（自动拼接会话上下文） ───
router.post('/chat', auth, async (req, res) => {
  try {
    const { prompt, jid, accountId, systemPrompt } = req.body;
    if (!prompt || typeof prompt !== 'string') {
      return res.status(400).json({ error: 'prompt is required' });
    }
    const acctId = accountId ? parseInt(accountId) : 1;

    const defaultSystem = `你是外贸业务AI助手，帮用户处理WhatsApp客户沟通。
规则：
1. 如果是写回复/话术请求，直接给可发送文本，不要客套前缀，不要解释。
2. 涉及翻译直接输出翻译结果，不加解释。
3. 总结需求/画像时结构化输出，使用emoji小标题：📋产品、📦数量、💰价格敏感度、🚚交期、🎯关注点、👤客户风格、✅下一步、⭐意向度(1-10星)。
4. 默认用客户的语言回复（客户用英文就英文，中文就中文）；如果用户用中文提问且不是写外文回复的任务，就用中文回答。
5. 回复简洁实用，不啰嗦。`;

    const sys = systemPrompt || defaultSystem;
    const msgs = [{ role: 'system', content: sys }];

    if (jid) {
      try {
        const recent = await getRecentMessagesForChat(acctId, jid, 20);
        const contact = await getContactForChat(acctId, jid);
        if (recent && recent.length > 0) {
          const ctx = buildContextForChat(recent, contact);
          msgs.push({ role: 'system', content: '以下是当前客户的最近聊天记录作为上下文：\n' + ctx });
        }
      } catch (e) {
        console.warn('[AI Chat] context fetch failed:', e.message);
      }
    }

    msgs.push({ role: 'user', content: prompt });

    const provider = await getActiveProvider();
    const reply = await rawChatComplete(msgs, {
      temperature: 0.7,
      max_tokens: 1024,
      provider,
    });
    res.json({ reply: (reply || '').trim() });
  } catch (err) {
    console.error('[AI Chat Error]', err);
    res.status(500).json({ error: 'AI对话失败: ' + err.message });
  }
});


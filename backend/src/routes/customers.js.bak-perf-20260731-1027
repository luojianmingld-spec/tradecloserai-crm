// Helper: compute KPIs
async function computeKPIs(userId) {
  const now = new Date();
  const firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
  const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

  const [total, active, aLevel, bLevel, dLevel, pending, newThisMonth] = await Promise.all([
    prisma.customer.count({ where: { userId } }),
    prisma.customer.count({ where: { userId, status: { in: ['active', 'following'] }, lastContactAt: { gte: thirtyDaysAgo } } }),
    prisma.customer.count({ where: { userId, customerLevel: 'A' } }),
    prisma.customer.count({ where: { userId, customerLevel: 'B' } }),
    prisma.customer.count({ where: { userId, customerLevel: 'D' } }),
    prisma.customer.count({ where: { userId, status: 'potential' } }),
    prisma.customer.count({ where: { userId, createdAt: { gte: firstDayOfMonth } } }),
  ]);
  const cLevel = Math.max(0, total - aLevel - bLevel - dLevel);
  return { total, active, aLevel, bLevel, cLevel, dLevel, pending, newThisMonth };
}

// List customers with filter/search/pagination + KPI
router.get('/', async (req, res) => {
  try {
    const userId = req.userId;
    const { level, status: statusQ, source, country, search, page, pageSize, sort, order } = req.query;
    // 排除自己的WA号（不把自己当客户）
    const where = { userId };
    // Self-exclusion using notIn (avoids Prisma NOT+NULL bug)
    let selfJid = null;
    try {
      selfJid = await getEvolutionConnector().getOwnerJid?.();
    } catch (e) { /* 不阻塞 */ }
    if (selfJid) {
      const otherDomain = selfJid.includes("@s.whatsapp.net")
        ? selfJid.replace("@s.whatsapp.net", "@c.us")
        : selfJid.replace("@c.us", "@s.whatsapp.net");
      where.jid = { notIn: [selfJid, otherDomain] };
    }
    where.source = { not: "self" };
    if (level && ['A', 'B', 'C', 'D'].includes(level.toUpperCase())) where.customerLevel = level.toUpperCase();
    if (statusQ) where.status = statusQ;
    if (source) where.source = source;
    if (country) where.country = { contains: country, mode: 'insensitive' };
    if (search) {
      where.OR = [
        { name: { contains: search } }, { phone: { contains: search } },
        { email: { contains: search } }, { company: { contains: search } },
        { companyName: { contains: search } }, { country: { contains: search } },
        { contactName: { contains: search } }, { jid: { contains: search } },
      ];
    }

    // "最近联系"快捷筛选
    if (req.query.recent === '1') {
      where.lastContactAt = { not: null };
    }

    const _page = Math.max(parseInt(page) || 1, 1);
    const _size = Math.min(parseInt(pageSize) || 50, 200);
    const orderBy = sort ? { [sort]: order === 'asc' ? 'asc' : 'desc' } : { updatedAt: 'desc' };

    const [customers, total, kpis] = await Promise.all([
      prisma.customer.findMany({
        where, orderBy, skip: (_page - 1) * _size, take: _size,
        include: {
          _count: { select: { documents: true, followUps: true } },
        },
      }),
      prisma.customer.count({ where }),
      computeKPIs(userId),
    ]);

    // Enrich with last message preview / pending doc / follow-up counts
    const jidSet = [...new Set(customers.map(c=>c.jid).filter(Boolean))];
    const lastMsgMap = new Map();
    // For performance: one query per 20 jids batched via findFirst in Promise.all (limited concurrency)
    async function fetchLastForJid(jid) {
      try {
        return await prisma.wAMessage.findFirst({
          where: { OR: [{ from: jid }, { to: jid }] },
          orderBy: { timestamp: 'desc' },
          select: { body: true, timestamp: true, direction: true },
        });
      } catch { return null; }
    }
    // batch to avoid N+1 blowup but still simple; cap if more than 80 customers we skip
    if (jidSet.length && jidSet.length <= 120) {
      const concurrency = 8;
      const results = [];
      let idx = 0;
      async function worker() {
        while (true) {
          const cur = idx++;
          if (cur >= jidSet.length) return;
          const r = await fetchLastForJid(jidSet[cur]);
          if (r) lastMsgMap.set(jidSet[cur], r);
        }
      }
      await Promise.all(Array.from({length: concurrency}, () => worker()));
    }

    // Pending doc counts (per customer)
    const idList = customers.map(c=>c.id);
    const pendingMap = new Map();
    try {
      const docs = await prisma.document.findMany({
        where: { customerId: { in: idList } },
        select: { customerId: true, status: true },
      });
      for (const d of docs) {
        const ent = pendingMap.get(d.customerId) || { count:0, pending:0 };
        ent.count++;
        if (d.status === 'DRAFT') ent.pending++;
        pendingMap.set(d.customerId, ent);
      }
    } catch(e) { console.error('docAgg err', e.message); }

    const list = customers.map(c => serializeCustomer(c)).map(c => {
      const docEnt = pendingMap.get(c.id) || { count: c._count?.documents||0, pending:0 };
      const lastMsg = c.jid ? lastMsgMap.get(c.jid) : null;
      let lastMessage = null;
      if (lastMsg && lastMsg.body) {
        const b = String(lastMsg.body).replace(/\s+/g,' ').trim();
        lastMessage = b.length > 40 ? b.slice(0,40)+'…' : b;
      }
      return {
        ...c,
        _docCount: Number(docEnt.count || 0),
        _pendingDocCount: Number(docEnt.pending || 0),
        _followUpCount: Number(c._count?.followUps || 0),
        _lastMessage: lastMessage,
        _lastMessageAt: lastMsg?.timestamp || c.lastContactAt || null,
        _lastMessageDir: lastMsg?.direction || null,
      };
    });

    res.json({
      items: list,
      total,
      page: _page,
      pageSize: _size,
      stats: kpis,
    });
  } catch (err) {
    console.error('[Customers] List error:', err);
    res.status(500).json({ error: 'Failed to list customers' });
  }
});

// Get single customer by numeric id (with stats) - must come AFTER /by-jid & /by-phone etc.
router.get('/:id', async (req, res, next) => {
  try {
    if (!/^\d+$/.test(req.params.id)) return next('route');
    const id = parseInt(req.params.id);
    const customer = await prisma.customer.findUnique({ where: { id } });
    if (!customer) return res.status(404).json({ error: 'Customer not found' });

    const [docCount, followUpCount, messageCount, lastMessages] = await Promise.all([
      prisma.document.count({ where: { customerId: id } }),
      prisma.customerFollowUp.count({ where: { customerId: id } }),
      customer.jid ? prisma.wAMessage.count({ where: { OR: [{ from: customer.jid }, { to: customer.jid }] } }) : 0,
      customer.jid ? prisma.wAMessage.findMany({
        where: { OR: [{ from: customer.jid }, { to: customer.jid }] },
        orderBy: { timestamp: 'desc' }, take: 20,
      }) : [],
    ]);

    // Latest pending doc hint
    const pendingDoc = await prisma.document.findFirst({
      where: { customerId: id, status: 'DRAFT' },
      orderBy: { updatedAt: 'desc' },
      select: { id: true, docNumber: true, type: true, updatedAt: true, totalAmount: true },
    });

    res.json({
      ...serializeCustomer(customer),
      _stats: { documentCount: docCount, followUpCount, messageCount },
      _pendingDoc: pendingDoc,
      _lastMessages: lastMessages.map(m => ({
        id: m.id, direction: m.direction, body: m.body, timestamp: m.timestamp, type: m.type,
      })),
    });
  } catch (err) {
    console.error('[Customers] Get error:', err);
    res.status(500).json({ error: 'Failed to get customer' });
  }
});


          });
        } catch (bgcErr) { console.warn('[bg-check] save CBC failed:', bgcErr.message); }
      }
    } catch (dbErr) {
      console.warn('[bg-check] save bgReport to DB failed:', dbErr.message);
    }

    res.json({
      report,
      missingInfo,
      askReply: (askReply || '').trim(),
      bgUpdatedAt: now.toISOString(),
      isNew,
      searchUsed: !(searchFailed || noHit),
    });
  } catch (err) {
    console.error('[Customers] bg-check error:', err);
    res.status(500).json({ error: '背调失败: ' + err.message });

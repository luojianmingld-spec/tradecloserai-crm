      console.error('[AI-Doc] JSON parse error:', e.message);
      return res.status(500).json({ error: 'AI返回格式异常，请重试' });
    }

    const items = (parsed.items || []).map((it, idx) => ({
      sortOrder: idx,
      productName: it.productName || it.description || 'Product',
      model: it.model || '',
      spec: it.spec || '',
      quantity: Number(it.quantity) || 0,
      unit: it.unit || 'pcs',
      unitPrice: Number(it.unitPrice) || 0,
      amount: Math.round((Number(it.quantity)||0) * (Number(it.unitPrice)||0) * 100)/100,
      remark: it.remark || '',
    }));

    const total = Math.round(items.reduce((s,i)=>s+i.amount,0) * 100)/100;
    if (total <= 0 || items.length === 0) {
      return res.status(400).json({ error: 'AI未能识别到有效产品明细，请先完善需求总结或在编辑器手动添加' });
    }

    // Generate doc number
    const prefix = type === 'PI' ? 'PI' : 'QT';
    const today = new Date();
    const datePrefix = `${today.getFullYear()}${String(today.getMonth()+1).padStart(2,'0')}${String(today.getDate()).padStart(2,'0')}`;
    const startWith = `${prefix}${datePrefix}`;
    const lastDoc = await prisma.document.findFirst({
      where: { docNumber: { startsWith: startWith } },
      orderBy: { docNumber: 'desc' },
      select: { docNumber: true },
    });
    let seq = 1;
    if (lastDoc?.docNumber) {
      const mm = lastDoc.docNumber.match(new RegExp('^' + startWith.replace(/[-]/g,'\\-') + '(\\d+)$'));
      if (mm) seq = parseInt(mm[1]) + 1;
    }
    const docNumber = `${startWith}${String(seq).padStart(3,'0')}`;

    const issueDate = new Date();
    let validUntil = null;
    if (type === 'QUOTATION') { validUntil = new Date(issueDate); validUntil.setDate(validUntil.getDate()+30); }

    const currency = parsed.currency || 'USD';
    const sellerInfo = loadSellerInfo();

    const buyerInfo = {
      companyName: parsed.buyerName || customer.companyName || customer.name || '',
      address: parsed.buyerAddress || customer.address || '',
      contactName: parsed.buyerContact || customer.contactName || '',
      phone: parsed.buyerPhone || customer.phone || '',
      email: parsed.buyerEmail || customer.email || '',
      country: customer.country || '',
    };

    const created = await prisma.document.create({
      data: {
        userId: req.userId || 1,
        customerId: id,
        customerJid: customer.jid || null,
        type,
        docNumber,
        title: type === 'PI' ? 'Proforma Invoice' : 'Quotation',
        issueDate,
        validUntil,
        currency,
        totalAmount: total,
        amountInWords: numberToWords(total, currency),
        status: 'DRAFT',
        sellerInfo,
        buyerInfo,
        tradeTerm: parsed.tradeTerm || 'FOB',
        paymentTerm: parsed.paymentTerm || 'T/T 30% deposit, 70% before shipment',
        portOfLoading: parsed.portOfLoading || 'Shenzhen, China',
        portOfDest: '',
        shipDate: '',
        remarks: parsed.remarks || (type === 'PI'
          ? 'Please confirm this PI and arrange the deposit.'
          : 'This quotation is valid for 30 days from the date of issue.'),
        items: { create: items },
      },
      include: { items: true },
    });

    res.status(201).json({ docId: created.id, document: { id: created.id, docNumber: created.docNumber, type, totalAmount: total } });
  } catch (err) {
    console.error('[Customers] ai-document error:', err);
    res.status(500).json({ error: 'AI生成单证失败: ' + err.message });
  }
});


function guessCountryByPhone(phone) {
  if (!phone) return '';
  const p = String(phone);
  // 3位优先
  for (let len = 3; len >= 1; len--) {
    const cc = p.substring(0, len);
    if (CC_COUNTRY[cc]) return CC_COUNTRY[cc];
  }
  return '';
}

// DuckDuckGo HTML 搜索（10秒超时，无新依赖，原生https）
function duckSearch(query, timeoutMs = 10000) {
  return new Promise((resolve, reject) => {
    const q = encodeURIComponent(query);
    const url = `https://html.duckduckgo.com/html/?q=${q}`;
    const req = https.get(url, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36',
        'Accept': 'text/html,application/xhtml+xml',
        'Accept-Language': 'en-US,en;q=0.9',
      },
      timeout: timeoutMs,
    }, (res) => {
      // 处理重定向
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        res.resume();
        // 简化：忽略重定向，直接返回空
        return resolve([]);
      }
      let data = '';
      res.setEncoding('utf8');
      res.on('data', (chunk) => { data += chunk; });
      res.on('end', () => {
        try {
          const results = [];
          // 提取 result__a title 和 result__snippet
          const resultRegex = /<a[^>]*class="result__a"[^>]*href="([^"]*)"[^>]*>([\s\S]*?)<\/a>[\s\S]*?<a[^>]*class="result__snippet"[^>]*>([\s\S]*?)<\/a>/g;
          let m;
          while ((m = resultRegex.exec(data)) !== null && results.length < 5) {
            const href = m[1];
            const title = m[2].replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#x27;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();
            const snippet = m[3].replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#x27;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();
            if (title) results.push({ title, snippet, href });
          }
          resolve(results);
        } catch (e) {
          resolve([]);
        }
      });
    });
    req.on('error', (e) => reject(e));
    req.on('timeout', () => { req.destroy(); reject(new Error('timeout')); });
  });
}

async function performWebSearch(customer) {
  const phone = extractPhoneFromJid(customer.jid || customer.phone);
  const companyName = customer.companyName || '';
  const contactName = customer.contactName || '';
  const country = customer.country || guessCountryByPhone(phone);

  const queries = [];
  if (phone) {
    queries.push(`${phone} whatsapp`);
    queries.push(`${phone} company`);
  }
  if (companyName) {
    queries.push(`"${companyName}" official website`);
    if (country) queries.push(`"${companyName}" ${country} business`);
  }
  if (contactName && companyName) {
    queries.push(`"${contactName}" "${companyName}" linkedin`);
  }

  const allResults = [];
  let failedQueryCount = 0;
  for (let i = 0; i < queries.length; i++) {
    const q = queries[i];
    try {
      const rs = await duckSearch(q, 10000);
      if (rs.length) {
        allResults.push({ query: q, results: rs });
      }
    } catch (e) {
      failedQueryCount++;
      console.warn('[bg-check] search failed for:', q, e.message);
    }
    // Add random delay between searches to avoid DDG rate limiting (3-5 seconds)
    if (i < queries.length - 1) {
      const delay = 3000 + Math.random() * 2000;
      await new Promise(r => setTimeout(r, delay));
    }
  }
  return { allResults, failedQueryCount, totalQueries: queries.length };
}



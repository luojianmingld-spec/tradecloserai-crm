router.get('/by-jid/:jid', async (req, res) => {
  try {
    const jid = decodeJid(req.params.jid);
    if (!jid) return res.status(400).json({ error: 'jid required' });
    const userId = req.userId;

    let customer = await findCustomerByJid(prisma, userId, jid);

    if (!customer) {
      const firstMsg = await prisma.wAMessage.findFirst({
        where: { OR: [{ from: jid }, { to: jid }] },
        orderBy: { timestamp: 'asc' },
      });
      const lastMsg = await prisma.wAMessage.findFirst({
        where: { OR: [{ from: jid }, { to: jid }] },
        orderBy: { timestamp: 'desc' },
      });
      const phone = jid.split('@')[0] || null;
      let defaultName = phone || '';
      try {
        const contact = await prisma.contact?.findFirst?.({ where: { jid } });
        if (contact?.name || contact?.pushName) defaultName = contact.name || contact.pushName || defaultName;
      } catch {}

      customer = await prisma.customer.create({
        data: {
          userId, jid, name: defaultName, phone, customerLevel: 'C',
          source: 'whatsapp', status: 'potential', intentLevel: 5, assignedTo: userId,
          firstContactAt: firstMsg?.timestamp || new Date(),
          lastContactAt: lastMsg?.timestamp || new Date(),
        },
      });
    } else {
      const patch = {};
      if (!customer.firstContactAt || !customer.lastContactAt) {
        const firstMsg = await prisma.wAMessage.findFirst({
          where: { OR: [{ from: jid }, { to: jid }] },
          orderBy: { timestamp: 'asc' },
        });
        const lastMsg = await prisma.wAMessage.findFirst({
          where: { OR: [{ from: jid }, { to: jid }] },
          orderBy: { timestamp: 'desc' },
        });
        if (!customer.firstContactAt && firstMsg) patch.firstContactAt = firstMsg.timestamp;
        if (!customer.lastContactAt && lastMsg) patch.lastContactAt = lastMsg.timestamp;
        if (Object.keys(patch).length) {
          customer = await prisma.customer.update({ where: { id: customer.id }, data: patch });
        }
      }
    }

    res.json(serializeCustomer(customer));
  } catch (err) {
    console.error('[Customers] by-jid GET error:', err);
    res.status(500).json({ error: 'Failed to get customer' });
  }
});

router.put('/by-jid/:jid', async (req, res) => {
  try {
    const jid = decodeJid(req.params.jid);
    if (!jid) return res.status(400).json({ error: 'jid required' });
    const userId = req.userId;

    let customer = await findCustomerByJid(prisma, userId, jid);
    if (!customer) {
      const phone = jid.split('@')[0] || null;
      customer = await prisma.customer.create({
        data: {
          userId, jid, name: phone || '', phone, customerLevel: 'C', source: 'whatsapp',
          status: 'potential', intentLevel: 5, assignedTo: userId,
          firstContactAt: new Date(), lastContactAt: new Date(),
        },
      });
    }

    const data = {};
    for (const field of JID_WRITABLE_FIELDS) {
      if (req.body[field] !== undefined) {
        if (field === 'tags') {
          const v = req.body[field];
          data[field] = Array.isArray(v) ? JSON.stringify(v) : String(v);
        } else {
          data[field] = req.body[field];
        }
      }
    }
    // Auto-set requirement timestamps
    const reqFields = ['requirementSummary','requirementProducts','requirementBudget','requirementQuantity','requirementDelivery','requirementSource'];
    if (reqFields.some(f => data[f] !== undefined)) {
      data.requirementUpdatedAt = new Date();
      if (!data.requirementSource) data.requirementSource = 'manual';
    }
    if (data.companyName !== undefined) data.company = data.companyName;

    const updated = await prisma.customer.update({ where: { id: customer.id }, data });
    res.json(serializeCustomer(updated));
  } catch (err) {
    console.error('[Customers] by-jid PUT error:', err);
    res.status(500).json({ error: 'Failed to update customer' });
  }
});


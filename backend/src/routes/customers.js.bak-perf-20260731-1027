// ===== AI 自动补全客户信息（入站消息后异步调用） =====
// 规则：只填空字段，不覆盖已有值；24h冷却；不阻塞主流程
const AUTO_FILL_FIELDS = ['companyName','contactName','country','title','email','website','address','industry','requirementProducts'];

async function extractCustomerInfoFromChat(jid, limit = 20) {
  const messages = await prisma.wAMessage.findMany({
    where: { OR: [{ from: jid }, { to: jid }] },
    orderBy: { timestamp: 'desc' },
    take: limit,
  });
  if (!messages.length) return null;
  const context = messages.slice().reverse().map(m => {
    const who = (m.direction === 'outbound' || m.direction === 'outgoing') ? '我(业务员)' : '客户';
    const ts = m.timestamp ? new Date(m.timestamp).toISOString().slice(0, 16).replace('T', ' ') : '';
    const body = (m.body || '').replace(/```[\s\S]*?```/g, '[图片]').slice(0, 500);
    return `[${ts}] ${who}: ${body}`;
  }).join('\n');
  if (!context.trim()) return null;

  const modelId = await resolveModelId();
  const systemPrompt = `你是一个外贸客户信息抽取助手。根据以下WhatsApp聊天记录，抽取客户关键信息。

## 抽取字段
- companyName: 客户公司名（英文/原文），没有则null
- contactName: 客户联系人名/称呼，没有则null
- country: 客户国家/地区，没有则null
- title: 客户职位/头衔，没有则null
- email: 邮箱地址，没有则null
- website: 网址，没有则null
- address: 客户地址/城市，没有则null
- industry: 行业，没有则null
- requirementProducts: 客户提到的采购产品/意向产品（英文关键词，逗号分隔），没有则null

要求：
- 严格只输出JSON，不要markdown代码块，不要其他文字
- 不确定的字段设null，不要瞎猜
- 邮箱/网址/国家要精确，宁可null不要猜测
- 产品字段只记录客户明确提到要买的产品，不要把我方推销的产品算进去
- 格式：{"companyName":"...","contactName":"...","country":"...","title":"...","email":"...","website":"...","address":"...","industry":"...","requirementProducts":"..."}`;

  const userPrompt = `聊天记录（最近${messages.length}条）：\n${context}\n\n请抽取：`;
  const raw = await chatComplete(modelId, systemPrompt, userPrompt, { temperature: 0.2, maxTokens: 600 });
  let parsed = null;
  try {
    const m = raw.match(/\{[\s\S]*\}/);
    if (m) parsed = JSON.parse(m[0]);
  } catch (e) {
    console.error('[autoFill] JSON parse error:', e.message, raw);
    return null;
  }
  if (!parsed || typeof parsed !== 'object') return null;
  const result = {};
  for (const f of AUTO_FILL_FIELDS) {
    const v = parsed[f];
    if (v && typeof v === 'string' && v.trim() && v.trim().toLowerCase() !== 'null' && v.trim() !== '未知') {
      result[f] = v.trim();
    }
  }
  return Object.keys(result).length ? result : null;
}

/**
 * 异步自动填充客户空字段。fire-and-forget，不抛异常。
 * @param {string} jid - 客户jid
 * @param {number} [userId=1]
 * @returns {Promise<{filled: string[], customerId: number}|null>}
 */
// ============ 销售漏斗 API ============
const DEAL_STAGES = ['new','qualified','quoting','negotiating','won','completed','lost'];
const STAGE_META = {
  new:        { label:'新询盘', color:'#6b7280', icon:'🆕' },
  qualified:  { label:'需求确认', color:'#3b82f6', icon:'🔍' },
  quoting:    { label:'报价中',   color:'#f59e0b', icon:'💰' },
  negotiating:{ label:'谈判/寄样',color:'#8b5cf6', icon:'🤝' },
  won:        { label:'成交待付款',color:'#10b981', icon:'🎉' },
  completed:  { label:'已完成',   color:'#059669', icon:'✅' },
  lost:       { label:'已流失',   color:'#ef4444', icon:'❌' },
};

// GET /pipeline - 按阶段分组返回客户（注意：必须在 /:id 之前，Express按顺序匹配）
router.get('/pipeline', async (req, res) => {
  try {
    const userId = req.userId;
    const customers = await prisma.customer.findMany({
      where: { userId },
      orderBy: { updatedAt: 'desc' },
      include: { _count: { select: { followUps: true } } },
    });
    const stages = {};
    for (const st of DEAL_STAGES) {
      stages[st] = { key: st, ...STAGE_META[st], items: [], count: 0, value: 0 };
    }
    for (const c of customers) {
      const st = DEAL_STAGES.includes(c.dealStage) ? c.dealStage : 'new';
      stages[st].items.push({
        id: c.id, name: c.name, companyName: c.companyName, country: c.country,
        customerLevel: c.customerLevel, dealValue: c.dealValue || 0,
        dealStage: st, dealStageAt: c.dealStageAt, lastContactAt: c.lastContactAt,
        _followUpCount: c._count?.followUps || 0,
      });
      stages[st].count++;
      stages[st].value += c.dealValue || 0;
    }
    const totalValue = Object.values(stages).reduce((a,s)=>a+s.value,0);
    res.json({ stages: DEAL_STAGES.map(k=>stages[k]), totalValue, total: customers.length });
  } catch (err) {
    console.error('[Pipeline] error:', err);
    res.status(500).json({ error: 'Failed to load pipeline' });
  }
});

// PATCH /:id/stage - 更新客户阶段（必须在 /:id 路由之前）
router.patch('/:id/stage', async (req, res) => {
  try {
    if (!/^\d+$/.test(req.params.id)) return res.status(400).json({ error: 'Invalid id' });
    const id = parseInt(req.params.id);
    const { stage, note, dealValue } = req.body;
    if (!DEAL_STAGES.includes(stage)) return res.status(400).json({ error: 'Invalid stage' });
    const customer = await prisma.customer.findUnique({ where: { id } });
    if (!customer) return res.status(404).json({ error: 'Customer not found' });
    const oldStage = customer.dealStage || 'new';
    const data = { dealStage: stage, dealStageAt: new Date() };
    if (typeof dealValue === 'number' && dealValue >= 0) data.dealValue = dealValue;
    const updated = await prisma.customer.update({ where: { id }, data });
    // 写跟进记录
    const meta = STAGE_META[stage];
    const oldMeta = STAGE_META[oldStage] || { label: oldStage };
    let content = `📋 阶段变更：${oldMeta.label} → ${meta.label}`;
    if (note) content += `\n📝 备注：${note}`;
    await prisma.customerFollowUp.create({
      data: { customerId: id, content, source: 'stage_change', metadata: JSON.stringify({ from: oldStage, to: stage }) },
    });
    res.json({ ok: true, customer: serializeCustomer(updated) });
  } catch (err) {
    console.error('[Pipeline] stage update error:', err);
    res.status(500).json({ error: 'Failed to update stage' });
  }
});

// GET /:id/stage-history - 获取阶段变更历史
router.get('/:id/stage-history', async (req, res) => {
  try {
    if (!/^\d+$/.test(req.params.id)) return res.status(400).json({ error: 'Invalid id' });
    const id = parseInt(req.params.id);
    const records = await prisma.customerFollowUp.findMany({
      where: { customerId: id, source: 'stage_change' },
      orderBy: { createdAt: 'desc' },
      take: 20,
    });
    res.json(records.map(r => {
      let meta = {};
      try { meta = JSON.parse(r.metadata || '{}'); } catch {}
      return { id: r.id, from: meta.from, to: meta.to, note: r.content, createdAt: r.createdAt };
    }));
  } catch (err) {
    console.error('[Pipeline] history error:', err);
    res.status(500).json({ error: 'Failed to load history' });
  }
});

export async function autoFillCustomer(jid, userId = 1) {
  try {
    if (!jid) return null;
    const cust = await findCustomerByJid(prisma, userId, jid);
    if (!cust) return null;
    // 24h冷却：aiExtractedAt 24小时内跳过
    if (cust.aiExtractedAt && (Date.now() - new Date(cust.aiExtractedAt).getTime()) < 24*3600*1000) {
      return null;
    }
    const extracted = await extractCustomerInfoFromChat(jid, 20);
    if (!extracted) {
      await prisma.customer.update({ where: { id: cust.id }, data: { aiExtractedAt: new Date() } });
      return null;
    }
    // 只填空字段
    const updateData = {};
    const newlyFilled = [];
    let existingFields = {};
    try { existingFields = cust.aiAutoFields ? JSON.parse(cust.aiAutoFields) : []; } catch { existingFields = []; }
    if (!Array.isArray(existingFields)) existingFields = [];

    for (const f of AUTO_FILL_FIELDS) {
      const current = cust[f];
      const isEmpty = !current || (typeof current === 'string' && !current.trim());
      if (isEmpty && extracted[f]) {
        updateData[f] = extracted[f];
        if (!existingFields.includes(f)) existingFields.push(f);
        newlyFilled.push(f);
      }
    }
    if (!newlyFilled.length) {
      await prisma.customer.update({ where: { id: cust.id }, data: { aiExtractedAt: new Date() } });
      return null;
    }
    updateData.aiAutoFields = JSON.stringify(existingFields);
    updateData.aiExtractedAt = new Date();
    await prisma.customer.update({ where: { id: cust.id }, data: updateData });
    console.log(`[autoFill] jid=${jid} filled fields: ${newlyFilled.join(',')}`);
    return { filled: newlyFilled, customerId: cust.id };
  } catch (err) {
    console.error('[autoFill] error:', err.message);
    return null;
  }
}

// ===== 自动背调（入站消息后异步调用） =====
// 规则：7天冷却；至少要有公司名或联系人名；不阻塞主流程
export async function autoBackgroundCheck(jid, userId = 1, io = null) {
  try {
    if (!jid) return { skipped: true, reason: 'no jid' };
    const cust = await findCustomerByJid(prisma, userId, jid);
    if (!cust) return { skipped: true, reason: 'customer not found' };

    // 7天冷却
    if (cust.bgUpdatedAt) {
      const elapsed = Date.now() - new Date(cust.bgUpdatedAt).getTime();
      if (elapsed < 7 * 24 * 3600 * 1000) {
        return { skipped: true, reason: 'within 7-day cooldown' };
      }
    }

    // 至少要有公司名或联系人名
    const hasCompany = cust.companyName && cust.companyName.trim();
    const hasContactName = cust.contactName && cust.contactName.trim();
    if (!hasCompany && !hasContactName) {
      return { skipped: true, reason: 'missing companyName and contactName' };
    }

    let query = hasCompany ? cust.companyName : cust.contactName;
    if (hasCompany && hasContactName) query = cust.companyName + ' ' + cust.contactName;
    if (!hasCompany && hasContactName && cust.phone) query = cust.contactName + ' ' + cust.phone;

    console.log('[autoBgCheck] starting structured bg check for jid=' + jid + ' query=' + query);

    const result = await runFullBackgroundCheck(query, {
      email: cust.email || undefined,
      context: [cust.contactName, cust.title, cust.country, cust.city, cust.address].filter(Boolean).join(' ')
    });

    const now = new Date();
    const rating = result.rating || 'C';
    const summary = result.summary || '';

    // 从 dimensions 提取结构化字段
    let companyName = cust.companyName || null;
    let country = cust.country || null;
    let industry = cust.industry || null;
    let companySize = null;
    let website = cust.website || null;

    if (result.dimensions && result.dimensions.length > 0) {
      const step1 = result.dimensions[0];
      if (step1 && step1.data) {
        if (step1.data.companyName) companyName = step1.data.companyName;
        if (step1.data.country) country = step1.data.country;
        if (step1.data.industry) industry = step1.data.industry;
      }
      const step2 = result.dimensions[1];
      if (step2 && step2.data && step2.data.url) website = step2.data.url;
      const step5 = result.dimensions[4];
      if (step5 && step5.data && step5.data.companySize) companySize = step5.data.companySize;
    }

    // 保存到 CustomerBackgroundCheck 表
    try {
      await prisma.customerBackgroundCheck.upsert({
        where: { contactId: cust.id },
        update: {
          companyName, country, industry, companySize, website,
          details: JSON.stringify({
            dimensions: result.dimensions.map(d => ({ step: d.step, name: d.name, status: d.status, summary: d.summary || '' })),
            sources: result.sources || [], completedAt: result.completedAt
          }),
          riskLevel: rating, notes: summary, source: 'llm'
        },
        create: {
          contactId: cust.id,
          companyName, country, industry, companySize, website,
          details: JSON.stringify({
            dimensions: result.dimensions.map(d => ({ step: d.step, name: d.name, status: d.status, summary: d.summary || '' })),
            sources: result.sources || [], completedAt: result.completedAt
          }),
          riskLevel: rating, notes: summary, source: 'llm'
        }
      });
    } catch (bgcErr) {
      console.warn('[autoBgCheck] save CBC failed:', bgcErr.message);
    }

    // 更新 Customer.bgReport 和 bgUpdatedAt
    try {
      await prisma.customer.update({
        where: { id: cust.id },
        data: { bgReport: summary, bgUpdatedAt: now }
      });
    } catch (updErr) {
      console.warn('[autoBgCheck] update customer failed:', updErr.message);
    }

    // WebSocket 通知前端刷新
    if (io) {
      io.emit('customer:bgcheck:done', { jid, rating, summary: summary.slice(0, 200) });
    }

    // Phase 3: Auto BANT scoring after background check (fire-and-forget)
    try {
      autoBantScore(jid, io).catch(e => console.warn('[autoBgCheck] BANT follow-up error:', e.message));
    } catch (e) {
      console.warn('[autoBgCheck] BANT trigger error:', e.message);
    }

    console.log('[autoBgCheck] done for jid=' + jid + ' rating=' + rating);
    return { skipped: false, customerId: cust.id, rating, summary, jid };
  } catch (err) {
    console.error('[autoBgCheck] error:', err.message);
    return { skipped: true, reason: err.message };
  }
}

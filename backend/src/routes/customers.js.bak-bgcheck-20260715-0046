// Update customer by numeric id
router.put('/:id', async (req, res, next) => {
  try {
    if (!/^\d+$/.test(req.params.id)) return next('route');
    const id = parseInt(req.params.id);
    const existing = await prisma.customer.findUnique({ where: { id } });
    if (!existing) return res.status(404).json({ error: 'Customer not found' });

    const data = {};
    for (const field of ID_WRITABLE_FIELDS) {
      if (req.body[field] !== undefined) {
        if (field === 'tags') {
          const v = req.body[field];
          data[field] = Array.isArray(v) ? JSON.stringify(v) : String(v);
        } else if (['firstContactAt', 'lastContactAt'].includes(field)) {
          data[field] = req.body[field] ? new Date(req.body[field]) : null;
        } else {
          data[field] = req.body[field];
        }
      }
    }
    if (data.companyName && !data.company) data.company = data.companyName;

    // 如果更新了任何需求字段，自动更新时间戳
    const hasRequirementField = REQUIREMENT_FIELDS.some(f => f in data);
    if (hasRequirementField) {
      data.requirementUpdatedAt = new Date();
      // 未显式指定来源则标记为 manual
      if (!data.requirementSource) data.requirementSource = 'manual';
    }

    const customer = await prisma.customer.update({ where: { id }, data });
    res.json(serializeCustomer(customer));
  } catch (err) {
    console.error('[Customers] Update error:', err);
    res.status(500).json({ error: 'Failed to update customer: ' + err.message });
  }

import express from "express";
import { PrismaClient } from "@prisma/client";
import { getEvolutionConnector } from "../services/evolution-connector.js";

const router = express.Router();
const prisma = new PrismaClient();

const DEFAULT_SESSION_ID = "user_1"; // MVP单账号默认

// 从remoteJid提取手机号
function jidToPhone(jid) {
  return (jid || "").split("@")[0];
}

function isGroup(jid) {
  return (jid || "").includes("@g.us");
}

// 从Evolution原始消息体提取文本与类型
function extractBody(msg) {
  const m = msg.message || {};
  const t = msg.messageType;
  if (m.conversation) return { body: m.conversation, type: "text" };
  if (m.extendedTextMessage) return { body: m.extendedTextMessage.text || "", type: "text" };
  if (m.imageMessage) return { body: m.imageMessage.caption || "[图片]", type: "image", mediaUrl: m.imageMessage.url || null };
  if (m.videoMessage) return { body: m.videoMessage.caption || "[视频]", type: "video" };
  if (m.audioMessage) return { body: "[语音]", type: "audio" };
  if (m.documentMessage) return { body: m.documentMessage.fileName || "[文件]", type: "document", fileName: m.documentMessage.fileName };
  if (m.stickerMessage) return { body: "[表情贴纸]", type: "sticker" };
  if (m.locationMessage) return { body: `[位置] ${m.locationMessage.degreesLatitude || ""},${m.locationMessage.degreesLongitude || ""}`, type: "location" };
  if (m.contactsArrayMessage) return { body: "[联系人卡片]", type: "contacts" };
  return { body: `[${t || "unknown"}]`, type: t || "unknown" };
}

function evoTsToDate(ts) {
  if (!ts) return new Date();
  const n = typeof ts === "object" ? ts.low : Number(ts);
  // Evolution返回秒级时间戳，*1000转毫秒；如果已经很大就是毫秒
  return new Date(n > 1e12 ? n : n * 1000);
}

async function ensureWAConnection(sessionId, phone) {
  let conn = await prisma.wAConnection.findUnique({ where: { sessionId } });
  if (!conn) {
    conn = await prisma.wAConnection.create({
      data: {
        userId: 1,
        sessionId,
        phone: phone || null,
        status: "connected",
        lastConnectedAt: new Date(),
      },
    });
  } else if (phone && conn.phone !== phone) {
    conn = await prisma.wAConnection.update({
      where: { id: conn.id },
      data: { phone, status: "connected", lastConnectedAt: new Date() },
    });
  } else if (conn.status !== "connected") {
    conn = await prisma.wAConnection.update({
      where: { id: conn.id },
      data: { status: "connected", lastConnectedAt: new Date() },
    });
  }
  return conn;
}

async function upsertCustomer(userId, phone, pushName) {
  if (!phone || phone.length < 5) return null;
  try {
    let cust = await prisma.customer.findFirst({ where: { userId, phone } });
    const name = pushName && pushName.trim() ? pushName.trim() : phone;
    if (!cust) {
      cust = await prisma.customer.create({
        data: { userId, phone, name, source: "whatsapp", status: "potential", lastContactAt: new Date() },
      });
    } else {
      // 如果有pushName且当前name就是纯号码，更新成真名
      if (pushName && pushName.trim() && cust.name === phone) {
        await prisma.customer.update({ where: { id: cust.id }, data: { name: pushName.trim(), lastContactAt: new Date() } });
      } else {
        await prisma.customer.update({ where: { id: cust.id }, data: { lastContactAt: new Date() } });
      }
    }
    return cust;
  } catch (e) {
    console.warn("[Webhook] upsertCustomer error:", e.message);
    return null;
  }
}

async function saveMessage(sessionId, from, to, body, type, direction, waMessageId, timestamp, extra = {}) {
  try {
    // 避免重复落库（同waMessageId已存在则跳过）
    if (waMessageId) {
      const exists = await prisma.wAMessage.findFirst({ where: { sessionId, waMessageId } });
      if (exists) return exists;
    }
    return await prisma.wAMessage.create({
      data: {
        sessionId,
        from,
        to,
        body: body || "",
        type: type || "text",
        direction,
        timestamp,
        waMessageId: waMessageId || null,
        mediaUrl: extra.mediaUrl || null,
        fileName: extra.fileName || null,
      },
    });
  } catch (e) {
    console.warn("[Webhook] saveMessage error:", e.message);
    return null;
  }
}

router.post("/", async (req, res) => {
  try {
    const event = req.body;
    const eventType = event.event || event.type || "unknown";
    const instanceName = event.instance || event.instance_name || "jeremy-main";
    const data = event.data || {};

    const io = req.app.get("io");
    const connector = getEvolutionConnector(instanceName);
    try { connector.handleWebhookEvent(event); } catch (e) {}

    // 连接状态事件
    if (eventType === "CONNECTION_UPDATE" || eventType === "connection.update") {
      const state = typeof data.state === "string" ? data.state : (data.state?.state || data.state || "");
      console.log(`[Evolution Webhook] connection state: ${state}`);
      if (state === "open") {
        connector.connected = true;
        const info = await connector.getInstanceInfo().catch(() => null);
        const ownerJid = info?.ownerJid || "";
        const ownerPhone = jidToPhone(ownerJid);
        await ensureWAConnection(DEFAULT_SESSION_ID, ownerPhone);
        if (io) io.emit("whatsapp:status", { status: "connected", phone: ownerPhone, instance: instanceName, sessionId: DEFAULT_SESSION_ID });
      } else if (state === "close" || state === "disconnected") {
        connector.connected = false;
        try { await prisma.wAConnection.updateMany({ where: { sessionId: DEFAULT_SESSION_ID }, data: { status: "disconnected" } }); } catch (e) {}
        if (io) io.emit("whatsapp:status", { status: "disconnected", reason: "connection closed", instance: instanceName, sessionId: DEFAULT_SESSION_ID });
      }
      return res.status(200).json({ received: true });
    }

    // 收/发消息事件
    if (eventType === "messages.upsert" || eventType === "MESSAGES_UPSERT") {
      const messages = data.messages || [];
      for (const msg of messages) {
        const key = msg.key || {};
        const remoteJid = key.remoteJid || "";
        const fromMe = !!key.fromMe;

        // 忽略群消息、状态广播、回执类
        if (isGroup(remoteJid)) continue;
        if (remoteJid === "status@broadcast") continue;

        const { body, type, mediaUrl, fileName } = extractBody(msg);
        const pushName = msg.pushName || "";
        const phone = jidToPhone(remoteJid);
        const timestamp = evoTsToDate(msg.messageTimestamp);
        const waMessageId = key.id || null;

        if (!phone) continue;

        // 获取自己JID
        const ownerJid = (await connector.getOwnerJid().catch(() => null)) || "8613016242602@s.whatsapp.net";
        const mePhone = jidToPhone(ownerJid);

        const from = fromMe ? ownerJid : remoteJid;
        const to = fromMe ? remoteJid : ownerJid;
        const direction = fromMe ? "outbound" : "inbound";

        // 1. 确保connection存在
        await ensureWAConnection(DEFAULT_SESSION_ID, mePhone);

        // 2. 入站消息：维护客户档案
        if (!fromMe) {
          await upsertCustomer(1, phone, pushName);
        }

        // 3. 落库
        const saved = await saveMessage(
          DEFAULT_SESSION_ID, from, to, body, type, direction, waMessageId, timestamp,
          { mediaUrl, fileName }
        );

        console.log(`[Evolution Webhook] ${direction} from=${pushName||phone} me=${fromMe} type=${type} text="${body.substring(0,60)}" saved=${!!saved}`);

        // 4. 广播给前端
        if (io) {
          const payload = {
            id: saved?.id || `evo_${Date.now()}`,
            waMessageId,
            jid: remoteJid,
            from,
            to,
            body,
            content: body,
            direction,
            fromMe,
            messageType: type,
            timestamp: timestamp.getTime(),
            contact: { name: pushName || phone, phone, pushName },
            instance: instanceName,
            sessionId: DEFAULT_SESSION_ID,
          };

          if (fromMe) {
            io.emit("whatsapp:message_sent", payload);
          } else {
            io.emit("whatsapp:message", payload);
          }
        }
      }
      return res.status(200).json({ received: true, count: messages.length });
    }

    // 其他事件静默确认
    res.status(200).json({ received: true, event: eventType });
  } catch (err) {
    console.error("[Evolution Webhook] error:", err.message, err.stack);
    res.status(200).json({ received: true, error: err.message });
  }
});

export default router;

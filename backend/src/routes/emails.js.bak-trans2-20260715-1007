// Get emails for an account
router.get('/accounts/:id/emails', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const account = await prisma.emailAccount.findFirst({
      where: { id, userId: req.userId },
    });
    if (!account) {
      return res.status(404).json({ error: 'Account not found' });
    }

    const { page = 1, pageSize = 50, direction, search } = req.query;
    const skip = (parseInt(page) - 1) * parseInt(pageSize);
    const take = parseInt(pageSize);

    const where = { accountId: id };
    if (direction) where.direction = direction;
    if (search) {
      where.OR = [
        { subject: { contains: search } },
        { from: { contains: search } },
        { body: { contains: search } },
      ];
    }

    const [emails, total] = await Promise.all([
      prisma.emailMessage.findMany({
        where,
        orderBy: { createdAt: 'desc' },
        skip,
        take,
      }),
      prisma.emailMessage.count({ where }),
    ]);

    res.json({ emails, total, page: parseInt(page), pageSize: take });
  } catch (err) {
    console.error('[Emails] List emails error:', err);
    res.status(500).json({ error: 'Failed to list emails' });
  }
});

// Mark email as read
router.post('/:id/read', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const email = await prisma.emailMessage.findUnique({
      where: { id },
      include: { account: true },
    });
    if (!email || email.account.userId !== req.userId) {
      return res.status(404).json({ error: 'Email not found' });
    }

    await prisma.emailMessage.update({
      where: { id },
      data: { read: true },
    });

    res.json({ success: true });
  } catch (err) {
    console.error('[Emails] Mark read error:', err);
    res.status(500).json({ error: 'Failed to mark as read' });
  }
});

// Send email
router.post('/send', async (req, res) => {
  try {
    const { accountId, to, subject, body, html } = req.body;

    if (!accountId || !to || !subject) {
      return res.status(400).json({ error: 'accountId, to, and subject are required' });
    }

    const account = await prisma.emailAccount.findFirst({
      where: { id: accountId, userId: req.userId },
    });
    if (!account) {
      return res.status(404).json({ error: 'Account not found' });
    }

    const sent = await sendEmail(accountId, { to, subject, body, html });
    res.json(sent);
  } catch (err) {
    console.error('[Emails] Send error:', err);
    res.status(500).json({ error: err.message || 'Failed to send email' });
  }
});

// Translate email
router.post('/:id/translate', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const email = await prisma.emailMessage.findUnique({
      where: { id },
      include: { account: true },
    });
    if (!email || email.account.userId !== req.userId) {
      return res.status(404).json({ error: 'Email not found' });
    }

    const { targetLang, cleanText } = req.body;
    // 前端做了引用清理时优先用清理后文本，否则用原文
    const text = (cleanText && cleanText.trim().length > 20) ? cleanText : (email.bodyPlain || email.body);

    // 检测源语言（先调用LLM，因为quickDetect对葡语关键字误判高）
    let sourceLang;
    try {
      const langResp = await chatComplete(
        [{role:'system',content:'You are a language detector. Return ONLY the 2-letter ISO 639-1 code for the primary language of the given text. Return ONLY the code, e.g. en/zh/es/pt/fr/de/ja/ko/ar/ru/it/nl.'},
         {role:'user',content:text.substring(0,300)}],
        {temperature:0.1}
      );
      const lang = langResp.trim().toLowerCase().replace(/[^a-z]/g,'');
      sourceLang = /^[a-z]{2}$/.test(lang) ? lang : 'en';
    } catch(e) {
      sourceLang = await detectLanguage(text);
    }

    // Translate（翻译时保持原文换行结构，让LLM按段落翻译）
    const result = await translateText(text, sourceLang, targetLang || 'zh');

    // Save translation
    if (result.translated) {
      await prisma.emailMessage.update({
        where: { id },
        data: { translation: result.translated, sourceLang: result.sourceLang },
      });
    }

    res.json({
      translation: result.translated,
      sourceLang: result.sourceLang,
      targetLang: result.targetLang,
    });
  } catch (err) {
    console.error('[Emails] Translate error:', err);
    res.status(500).json({ error: 'Translation failed' });
  }
});

// AI generate reply for email
router.post('/:id/ai-reply', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const email = await prisma.emailMessage.findUnique({
      where: { id },
      include: { account: true },
    });
    if (!email || email.account.userId !== req.userId) {
      return res.status(404).json({ error: 'Email not found' });
    }

    const { style = 'formal' } = req.body;

    // Use AI reply service with email context via ai-client


    const text = email.bodyPlain || email.body;
    const customerLang = email.sourceLang || await detectLanguage(text);

    const langNames = {
      zh: 'Chinese', en: 'English', es: 'Spanish', de: 'German',
      fr: 'French', ja: 'Japanese', ko: 'Korean', ar: 'Arabic',
      pt: 'Portuguese', ru: 'Russian', it: 'Italian', nl: 'Dutch',
    };

    const stylePrompts = {
      formal: '使用正式、礼貌的商务用语，表达专业、严谨',
      friendly: '语气热情友好，像朋友一样交流',
      concise: '回复简短有力，直击要点，信息密度高',
    };

    const systemPrompt = `你是一位专业的外贸销售，正在通过邮件与海外客户沟通。
${stylePrompts[style] || stylePrompts.formal}

请根据客户的邮件内容，生成3个不同角度的回复选项。

要求：
1. 每个回复是一个完整的邮件正文，可以直接发送
2. 回复要有针对性地回应客户邮件内容
3. 3个回复各有侧重（直接回应、延伸话题、促成行动）
4. 回复语言应与客户使用的语言一致（${langNames[customerLang] || 'English'}）
5. 回复要自然流畅，不要生硬或模板化
6. 包含适当的邮件称呼和结尾

请严格按以下JSON格式返回：
{"replies": ["回复1", "回复2", "回复3"]}`;

    const responseContent = await chatComplete(
      [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: `客户邮件主题：${email.subject}\n\n客户邮件内容：\n${text}\n\n请生成3个回复选项。` },
      ],
      { temperature: 0.8 }
    );

    // Parse response
    let replies = [];
    try {
      const content = responseContent.trim();
      const jsonMatch = content.match(/```(?:json)?\s*([\s\S]*?)```/);
      const jsonStr = jsonMatch ? jsonMatch[1].trim() : content;
      const parsed = JSON.parse(jsonStr);
      replies = Array.isArray(parsed.replies) ? parsed.replies : parsed;
    } catch (e) {
      replies = [responseContent];
    }

    res.json({ replies });
  } catch (err) {
    console.error('[Emails] AI reply error:', err);
    res.status(500).json({ error: 'AI reply generation failed' });
  }
});

// Match email to customer or create new customer

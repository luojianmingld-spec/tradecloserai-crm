/**
 * Email API Routes
 */
import { Router } from 'express';
import { PrismaClient } from '@prisma/client';
import {
  encryptPassword,
  decryptPassword,
  testConnection,
  syncEmails,
  sendEmail,
  matchOrCreateCustomer,
  PROVIDER_PRESETS,
} from '../services/email.js';
import { translateText, detectLanguage } from '../services/translation.js';
import { chatComplete } from '../services/ai-client.js';
import { generateReply } from '../services/ai-reply.js';

const router = Router();
const prisma = new PrismaClient();

// List email accounts for current user
router.get('/accounts', async (req, res) => {
  try {
    const accounts = await prisma.emailAccount.findMany({
      where: { userId: req.userId },
      select: {
        id: true,
        email: true,
        provider: true,
        status: true,
        lastSyncAt: true,
        createdAt: true,
        updatedAt: true,
        _count: { select: { emails: true } },
      },
      orderBy: { createdAt: 'desc' },
    });
    res.json(accounts);
  } catch (err) {
    console.error('[Emails] List accounts error:', err);
    res.status(500).json({ error: 'Failed to list email accounts' });
  }
});

// Add email account
router.post('/accounts', async (req, res) => {
  try {
    const { email, password, provider, imapHost, imapPort, smtpHost, smtpPort } = req.body;

    if (!email || !password) {
      return res.status(400).json({ error: 'Email and password are required' });
    }

    // Get provider presets or use custom values
    const preset = PROVIDER_PRESETS[provider] || {};
    const finalImapHost = imapHost || preset.imapHost || '';
    const finalImapPort = imapPort || preset.imapPort || 993;
    const finalSmtpHost = smtpHost || preset.smtpHost || '';
    const finalSmtpPort = smtpPort || preset.smtpPort || 465;

    if (!finalImapHost || !finalSmtpHost) {
      return res.status(400).json({ error: 'IMAP and SMTP hosts are required for custom provider' });
    }

    const account = await prisma.emailAccount.create({
      data: {
        userId: req.userId,
        email,
        provider: provider || 'custom',
        imapHost: finalImapHost,
        imapPort: finalImapPort,
        smtpHost: finalSmtpHost,
        smtpPort: finalSmtpPort,
        password: encryptPassword(password),
        status: 'disconnected',
      },
    });

    res.status(201).json({
      id: account.id,
      email: account.email,
      provider: account.provider,
      status: account.status,
      createdAt: account.createdAt,
    });
  } catch (err) {
    console.error('[Emails] Create account error:', err);
    res.status(500).json({ error: 'Failed to create email account' });
  }
});

// Delete email account
router.delete('/accounts/:id', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const account = await prisma.emailAccount.findFirst({
      where: { id, userId: req.userId },
    });
    if (!account) {
      return res.status(404).json({ error: 'Account not found' });
    }

    await prisma.emailAccount.delete({ where: { id } });
    res.json({ success: true });
  } catch (err) {
    console.error('[Emails] Delete account error:', err);
    res.status(500).json({ error: 'Failed to delete account' });
  }
});

// Test email connection
router.post('/accounts/:id/test', async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const account = await prisma.emailAccount.findFirst({
      where: { id, userId: req.userId },
    });
    if (!account) {

import express from "express";
import { PrismaClient } from "@prisma/client";
import { getEvolutionConnector } from "../services/evolution-connector.js";

const router = express.Router();
const prisma = new PrismaClient();

const DEFAULT_SESSION_ID = "user_1";

function jidToPhone(jid) {
  return (jid || "").split("@")[0];
}
function isGroup(jid) {
  return (jid || "").includes("@g.us");
}
function isStatusBroadcast(jid) {
  return jid === "status@broadcast" || (jid || "").endsWith("@lid") && jid.length < 22;
}

function extractBody(msg) {
  const m = msg.message || {};
  const t = msg.messageType;
  if (m.conversation) return { body: m.conversation, type: "text" };
  if (m.extendedTextMessage) return { body: m.extendedTextMessage.text || "", type: "text" };
  if (m.imageMessage) return { body: m.imageMessage.caption || "[图片]", type: "image", mediaUrl: m.imageMessage.url || null };
  if (m.videoMessage) return { body: m.videoMessage.caption || "[视频]", type: "video" };
  if (m.audioMessage) return { body: "[语音]", type: "audio" };
  if (m.documentMessage) return { body: m.documentMessage.fileName || "[文件]", type: "document", fileName: m.documentMessage.fileName };
  if (m.stickerMessage) return { body: "[贴纸]", type: "sticker" };
  if (m.locationMessage) return { body: `[位置] ${m.locationMessage.degreesLatitude || ""},${m.locationMessage.degreesLongitude || ""}`, type: "location" };
  if (m.contactsArrayMessage) return { body: "[联系人卡片]", type: "contacts" };
  return { body: `[${t || "unknown"}]`, type: t || "unknown" };
}

function evoTsToDate(ts) {
  if (!ts) return new Date();
  const n = typeof ts === "object" ? ts.low : Number(ts);
  return new Date(n > 1e12 ? n : n * 1000);
}

async function ensureWAConnection(sessionId, phone) {
  let conn = await prisma.wAConnection.findUnique({ where: { sessionId } });
  if (!conn) {
    conn = await prisma.wAConnection.create({ data: { sessionId, phone: phone || null, status: "connected" } });
  } else if (conn.status !== "connected") {
    await prisma.wAConnection.update({ where: { id: conn.id }, data: { status: "connected" } });
  }
  return conn;
}

async function upsertCustomer(phone, pushName) {
  if (!phone || phone.length < 5) return null;
  try {
    let cust = await prisma.customer.findFirst({ where: { phone } });
    const name = pushName && pushName.trim() ? pushName.trim() : phone;
    if (!cust) {
      cust = await prisma.customer.create({
        data: { userId: 1, phone, name, source: "whatsapp", status: "potential", lastContactAt: new Date() },
      });
    } else if (pushName && pushName.trim() && cust.name === phone) {
      await prisma.customer.update({ where: { id: cust.id }, data: { name: pushName.trim(), lastContactAt: new Date() } });
    } else {
      await prisma.customer.update({ where: { id: cust.id }, data: { lastContactAt: new Date() } });
    }
    return cust;
  } catch (e) {
    console.warn("[Webhook] upsertCustomer error:", e.message);
    return null;
  }
}

async function saveMessage(sessionId, from, to, body, type, direction, waMessageId, timestamp, pushName, extra = {}) {
  try {
    if (waMessageId) {
      const exists = await prisma.wAMessage.findFirst({ where: { waMessageId } });
      if (exists) return exists;
    }
    const msg = await prisma.wAMessage.create({
      data: {
        sessionId, from, to, body: body || "", type: type || "text", direction,
        timestamp, waMessageId: waMessageId || null,
        mediaUrl: extra.mediaUrl || null, fileName: extra.fileName || null,
      },
    });
    // 入站消息维护客户
    if (direction === "inbound") {
      const phone = jidToPhone(from);
      await upsertCustomer(phone, pushName);
    }
    return msg;
  } catch (e) {
    console.warn("[Webhook] saveMessage error:", e.message);
    return null;
  }
}

// 处理单条消息（统一格式）
async function processOneMessage(instanceName, msg, fromMe, remoteJid, ownerJid) {
  if (isGroup(remoteJid)) return null;
  if (remoteJid === "status@broadcast") return null;
  // 忽略@lid临时ID消息（WhatsApp匿名，不是真实联系人）
  if (remoteJid.endsWith("@lid") && !remoteJid.startsWith("86") && !/^\d{6,}@lid$/.test(remoteJid)) {
    // 放宽：有些国家手机号@lid，但是没发过消息的陌生人可能也是@lid，先不丢
  }

  const { body, type, mediaUrl, fileName } = extractBody(msg);
  if (!body || body === "[unknown]") return null;
  const pushName = msg.pushName || "";
  const timestamp = evoTsToDate(msg.messageTimestamp);
  const waMessageId = (msg.key || {}).id || null;
  if (!waMessageId) return null;

  const mePhone = jidToPhone(ownerJid);
  const from = fromMe ? ownerJid : remoteJid;
  const to = fromMe ? remoteJid : ownerJid;
  const direction = fromMe ? "outbound" : "inbound";

  await ensureWAConnection(DEFAULT_SESSION_ID, mePhone);
  const saved = await saveMessage(DEFAULT_SESSION_ID, from, to, body, type, direction, waMessageId, timestamp, pushName, { mediaUrl, fileName });
  if (saved) {
    console.log(`[Evolution Webhook] ${direction} from=${jidToPhone(fromMe?to:from)} me=${fromMe} type=${type} saved=${!!saved} text="${body.slice(0,50)}"`);
  }
  return saved;
}

router.post("/", async (req, res) => {
  try {
    const event = req.body;
    let eventType = event.event || event.type || "unknown";
    // 规范化事件名（Evolution v2实际发送send.message/messages.upsert/messages.update，大写是订阅名）
    eventType = eventType.toLowerCase().replace(/_/g, ".");
    const instanceName = event.instance || event.instance_name || "jeremy-main";
    const data = event.data || {};
    const dest = event.destination || "";

    const io = req.app.get("io");
    const connector = getEvolutionConnector(instanceName);

    // 连接状态
    if (eventType === "connection.update" || eventType === "connection.update") {
      let state = "";
      if (typeof data.state === "string") state = data.state;
      else if (data.state) state = data.state.state || data.state || "";
      else if (data.state === undefined && event.data) state = "";
      console.log(`[Evolution Webhook] connection state: ${state}`);
      if (state === "open") {
        connector.connected = true;
        const info = await connector.getInstanceInfo().catch(() => null);
        const ownerJid = info?.ownerJid || event.sender || "";
        const ownerPhone = jidToPhone(ownerJid);
        await ensureWAConnection(DEFAULT_SESSION_ID, ownerPhone);
        if (io) io.emit("whatsapp:status", { status: "connected", phone: ownerPhone, instance: instanceName, sessionId: DEFAULT_SESSION_ID });
      } else if (state === "close" || state === "disconnected") {
        connector.connected = false;
        if (io) io.emit("whatsapp:status", { status: "disconnected", instance: instanceName, sessionId: DEFAULT_SESSION_ID });
      }
      return res.status(200).json({ received: true, event: eventType });
    }

    let ownerJid = event.sender || "";
    if (!ownerJid) {
      try {
        const info = await connector.getOwnerJid().catch(() => null);
        ownerJid = info || "";
      } catch(e){}
    }

    let processed = 0;

    // 入站/出站消息批量（messages.upsert）
    if (eventType === "messages.upsert") {
      const messages = Array.isArray(data.messages) ? data.messages : (data.message ? [data.message] : [data]);
      for (const m of messages) {
        if (!m || typeof m !== "object") continue;
        const key = m.key || data.key || {};
        const remoteJid = key.remoteJid || data.remoteJid || "";
        const fromMe = !!key.fromMe;
        if (!remoteJid) continue;
        await processOneMessage(instanceName, m, fromMe, remoteJid, ownerJid);
        processed++;
      }
    }
    // 单条出站发送事件（send.message）
    else if (eventType === "send.message") {
      const m = data;
      const key = m.key || {};
      const remoteJid = key.remoteJid || m.remoteJid || m.chatId || "";
      const fromMe = true;
      if (remoteJid) {
        await processOneMessage(instanceName, m, fromMe, remoteJid, ownerJid);
        processed++;
      }
    }
    // 消息状态更新（messages.update）—— 只打日志不重落库
    else if (eventType === "messages.update") {
      const status = data.status || "";
      const keyId = data.keyId || "";
      if (keyId && (status === "SERVER_ACK" || status === "DELIVERY_ACK" || status === "READ" || status === "ERROR")) {
        // 更新read状态可后续处理，MVP先忽略
        console.log(`[Evolution Webhook] msg ${keyId.slice(0,10)} status=${status}`);
      }
    }
    // 其他事件忽略
    else {
      // 未识别事件，静默接受
    }

    // Socket广播最新消息（如果有io且有新消息）
    // （processOneMessage内部已save，这里不重复广播，让前端刷新即可）

    return res.status(200).json({ received: true, event: eventType, processed });
  } catch (e) {
    console.error("[Webhook] error:", e.message);
    return res.status(500).json({ error: e.message });
  }
});

export default router;

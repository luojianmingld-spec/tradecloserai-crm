/**
 * Customer API Routes (V2)
 * - 按jid(whatsapp号)查找/更新客户资料（客户背调V1基础）
 * - 保留原有按id的CRUD接口兼容旧代码
 */

import { Router } from 'express';
import { PrismaClient } from '@prisma/client';
import { chatComplete, resolveModelId } from '../services/ai.service.js';

const router = Router();
const prisma = new PrismaClient();

// 允许更新的字段（按jid的接口）
const JID_WRITABLE_FIELDS = [
  'name', 'companyName', 'contactName', 'title', 'email', 'website',
  'country', 'phone', 'notes', 'tags', 'source', 'customerLevel',
  'firstContactAt', 'lastContactAt',
];

function safeParseJSON(str, fallback) {
  if (str == null) return fallback;
  try { return JSON.parse(str); } catch { return fallback; }
}

function serializeCustomer(c) {
  if (!c) return null;
  return {
    ...c,
    tags: typeof c.tags === 'string' ? safeParseJSON(c.tags, []) : (c.tags || []),
  };
}

// JID 参数编码/解码（@ 可能在 URL 中）
function decodeJid(param) {
  if (!param) return null;
  // 前端可能传 %40 或 @
  return decodeURIComponent(param);
}

// ============ 按 JID 的接口（客户背调 V1） ============

/**
 * GET /api/customers/by-jid/:jid
 * 按 WhatsApp JID 获取客户资料，不存在则自动创建空记录并返回
 */
router.get('/by-jid/:jid', async (req, res) => {
  try {
    const jid = decodeJid(req.params.jid);
    if (!jid) return res.status(400).json({ error: 'jid required' });
    const userId = req.userId;

    let customer = await prisma.customer.findFirst({
      where: { userId, jid },
    });

    if (!customer) {
      // 从 WAMessage 中捞一下最早/最晚消息时间
      const firstMsg = await prisma.wAMessage.findFirst({
        where: {
          OR: [{ from: jid }, { to: jid }],
        },
        orderBy: { timestamp: 'asc' },
      });
      const lastMsg = await prisma.wAMessage.findFirst({
        where: {
          OR: [{ from: jid }, { to: jid }],
        },
        orderBy: { timestamp: 'desc' },
      });

      // 从jid提取手机号作为默认phone
      const phone = jid.split('@')[0] || null;
      // 从联系人表找pushName
      let defaultName = phone || '';
      try {
        const contact = await prisma.contact?.findFirst?.({ where: { jid } });
        if (contact?.name || contact?.pushName) {
          defaultName = contact.name || contact.pushName || defaultName;
        }
      } catch {}

      customer = await prisma.customer.create({
        data: {
          userId,
          jid,
          name: defaultName,
          phone,
          customerLevel: 'C',
          source: 'whatsapp',
          status: 'potential',
          intentLevel: 5,
          assignedTo: userId,
          firstContactAt: firstMsg?.timestamp || new Date(),
          lastContactAt: lastMsg?.timestamp || new Date(),
        },
      });
    } else {
      // 如果已存在但 firstContactAt/lastContactAt 为空，尝试补齐
      const patch = {};
      if (!customer.firstContactAt || !customer.lastContactAt) {
        const firstMsg = await prisma.wAMessage.findFirst({
          where: { OR: [{ from: jid }, { to: jid }] },
          orderBy: { timestamp: 'asc' },
        });
        const lastMsg = await prisma.wAMessage.findFirst({
          where: { OR: [{ from: jid }, { to: jid }] },
          orderBy: { timestamp: 'desc' },
        });
        if (!customer.firstContactAt && firstMsg) patch.firstContactAt = firstMsg.timestamp;
        if (!customer.lastContactAt && lastMsg) patch.lastContactAt = lastMsg.timestamp;
        if (Object.keys(patch).length) {
          customer = await prisma.customer.update({ where: { id: customer.id }, data: patch });
        }
      }
    }

    res.json(serializeCustomer(customer));
  } catch (err) {
    console.error('[Customers] by-jid GET error:', err);
    res.status(500).json({ error: 'Failed to get customer' });
  }
});

/**
 * PUT /api/customers/by-jid/:jid
 * 更新客户资料
 */
router.put('/by-jid/:jid', async (req, res) => {
  try {
    const jid = decodeJid(req.params.jid);
    if (!jid) return res.status(400).json({ error: 'jid required' });
    const userId = req.userId;

    let customer = await prisma.customer.findFirst({ where: { userId, jid } });
    if (!customer) {
      // 自动创建后再更新
      const phone = jid.split('@')[0] || null;
      customer = await prisma.customer.create({
        data: {
          userId, jid, name: phone || '', phone, customerLevel: 'C', source: 'whatsapp',
          status: 'potential', intentLevel: 5, assignedTo: userId,
          firstContactAt: new Date(), lastContactAt: new Date(),
        },
      });
    }

    const data = {};
    for (const field of JID_WRITABLE_FIELDS) {
      if (req.body[field] !== undefined) {
        if (field === 'tags') {
          // 接受数组或字符串，统一存成JSON字符串
          const v = req.body[field];
          data[field] = Array.isArray(v) ? JSON.stringify(v) : String(v);
        } else {
          data[field] = req.body[field];
        }
      }
    }

    // 公司名填到 company 字段做兼容
    if (data.companyName !== undefined) {
      data.company = data.companyName;
    }

    const updated = await prisma.customer.update({ where: { id: customer.id }, data });
    res.json(serializeCustomer(updated));
  } catch (err) {
    console.error('[Customers] by-jid PUT error:', err);
    res.status(500).json({ error: 'Failed to update customer' });
  }
});

/**
 * POST /api/customers/by-jid/:jid/extract-ai
 * 读取最近N条消息，AI抽取客户结构化信息（不直接入库）
 */
router.post('/by-jid/:jid/extract-ai', async (req, res) => {
  try {
    const jid = decodeJid(req.params.jid);
    if (!jid) return res.status(400).json({ error: 'jid required' });
    const userId = req.userId;
    const limit = Math.min(parseInt(req.body.limit) || 20, 50);

    const messages = await prisma.wAMessage.findMany({
      where: { OR: [{ from: jid }, { to: jid }] },
      orderBy: { timestamp: 'desc' },
      take: limit,
    });

    const context = messages.slice().reverse().map(m => {
      const who = (m.direction === 'outbound' || m.direction === 'outgoing') ? '我(业务员)' : '客户';
      const ts = m.timestamp ? new Date(m.timestamp).toISOString().slice(0, 16).replace('T', ' ') : '';
      return `[${ts}] ${who}: ${m.body || ''}`;
    }).join('\n');

    if (!context.trim()) {
      return res.json({
        companyName: null, contactName: null, country: null, title: null,
        email: null, website: null, source: '未知', notes: '暂无聊天记录',
      });
    }

    const modelId = await resolveModelId();
    const systemPrompt = `你是一个外贸客户信息抽取助手。根据以下WhatsApp聊天记录，抽取客户关键信息。

## 抽取字段
- companyName: 客户公司名（英文/原文），没有则null
- contactName: 客户联系人名/称呼，没有则null
- country: 客户国家/地区，没有则null（根据手机号国家码、语言、提到的地点推断）
- title: 客户职位/头衔，没有则null
- email: 邮箱地址，没有则null
- website: 网址，没有则null
- source: 客户来源推测（展会/独立站询盘/主动开发/老客户推荐/其他/未知）
- notes: 其他关键信息摘要（一句话，中文）

要求：
- 严格只输出JSON，不要markdown代码块，不要其他文字
- 不确定的字段设null，不要瞎猜
- 格式：{"companyName":"...","contactName":"...","country":"...","title":"...","email":"...","website":"...","source":"...","notes":"..."}`;

    const userPrompt = `聊天记录（最近${messages.length}条）：\n${context}\n\n请抽取：`;
    const raw = await chatComplete(modelId, systemPrompt, userPrompt, { temperature: 0.2, maxTokens: 800 });

    let parsed = null;
    try {
      const m = raw.match(/\{[\s\S]*\}/);
      if (m) parsed = JSON.parse(m[0]);
    } catch (e) {
      console.error('[Customers] extract-ai JSON parse error:', e.message, raw);
    }
    if (!parsed || typeof parsed !== 'object') {
      parsed = { companyName: null, contactName: null, country: null, title: null, email: null, website: null, source: '未知', notes: 'AI解析失败' };
    }

    // 字段白名单
    const safe = {
      companyName: parsed.companyName || null,
      contactName: parsed.contactName || null,
      country: parsed.country || null,
      title: parsed.title || null,
      email: parsed.email || null,
      website: parsed.website || null,
      source: parsed.source || '未知',
      notes: parsed.notes || null,
    };

    // 更新 aiExtractedAt
    await prisma.customer.updateMany({
      where: { userId, jid },
      data: { aiExtractedAt: new Date() },
    });

    res.json(safe);
  } catch (err) {
    console.error('[Customers] extract-ai error:', err);
    res.status(500).json({ error: 'AI抽取失败' });
  }
});

/**
 * POST /api/customers/by-jid/:jid/ask-company
 * 生成询问客户公司名的话术（2版）
 */
router.post('/by-jid/:jid/ask-company', async (req, res) => {
  try {
    const jid = decodeJid(req.params.jid);
    const userId = req.userId;
    const limit = Math.min(parseInt(req.body.limit) || 20, 50);

    const messages = await prisma.wAMessage.findMany({
      where: { OR: [{ from: jid }, { to: jid }] },
      orderBy: { timestamp: 'desc' },
      take: limit,
    });
    const context = messages.slice().reverse().map(m => {
      const who = (m.direction === 'outbound' || m.direction === 'outgoing') ? '我' : '客户';
      return `${who}: ${m.body || ''}`;
    }).join('\n');

    const modelId = await resolveModelId();
    const systemPrompt = `你是外贸业务员助手。我还不知道客户的公司名，请根据聊天记录生成2句自然的询问话术，礼貌地了解对方公司信息。

要求：
- 用客户当前使用的语言（从聊天记录判断，英语/阿语/西语/法语等）
- 自然不生硬，不要像问卷
- 给2个版本："自然随意版"、"礼貌正式版"
- 严格只输出JSON，不要markdown：{"replies":[{"name":"自然随意版","foreign":"外文原文","chinese":"中文翻译"},{"name":"礼貌正式版","foreign":"外文原文","chinese":"中文翻译"}]}`;
    const userPrompt = `聊天记录：\n${context || '(暂无)'}\n\n请生成话术。`;
    const raw = await chatComplete(modelId, systemPrompt, userPrompt, { temperature: 0.8, maxTokens: 600 });

    let parsed = null;
    try {
      const m = raw.match(/\{[\s\S]*\}/);
      if (m) parsed = JSON.parse(m[0]);
    } catch {}
    if (!parsed || !Array.isArray(parsed.replies)) {
      parsed = { replies: [
        { name: '自然随意版', foreign: 'By the way, may I know which company you are from?', chinese: '顺便问一下，您是哪家公司的？' },
        { name: '礼貌正式版', foreign: 'Could you please let me know your company name so I can better assist you?', chinese: '请问您能告诉我贵公司名称吗，以便我更好地为您服务？' },
      ]};
    }
    res.json(parsed);
  } catch (err) {
    console.error('[Customers] ask-company error:', err);
    res.status(500).json({ error: '生成失败' });
  }
});


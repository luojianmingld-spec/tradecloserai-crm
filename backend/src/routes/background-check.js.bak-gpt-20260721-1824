/**
 * Customer Background Check API
 * 全网搜索 + AI分析 生成客户背调报告
 */
import { Router } from 'express';
import dds from 'duck-duck-scrape';
const { search, SafeSearchType, TimeType } = dds;
import { chatComplete, getAISettings, resolveModelId } from '../services/ai.service.js';

const router = Router();

/**
 * POST /api/background-check
 * Body: { query, context?, email? }
 * - query: 公司名/域名/关键词
 * - context: 可选，邮件内容或聊天记录（辅助分析）
 * - email: 可选，客户邮箱（自动提取域名）
 */
router.post('/', async (req, res) => {
  try {
    const { query, context, email } = req.body;
    if (!query) {
      return res.status(400).json({ error: '请输入公司名称、域名或关键词' });
    }

    // 1. 确定搜索关键词
    let searchTerms = [];
    const domain = email ? email.split('@')[1] : (query.includes('.') ? query : null);

    if (domain) {
      // 有域名，搜索公司信息
      searchTerms = [
        domain.replace(/\.(com|net|org|io|co)$/i, ' company'),
        `site:${domain} about`,
        `${domain} company profile`
      ];
    } else {
      // 公司名/关键词
      searchTerms = [
        `${query} company profile`,
        `${query} business`,
        `${query} official website`
      ];
    }

    // 2. 执行搜索（最多3组关键词）
    let allResults = [];
    for (const term of searchTerms) {
      try {
        const result = await search(term, {
          safeSearch: SafeSearchType.MODERATE,
          time: TimeType.YEAR,
          locale: 'us-en'
        });
        if (result.results) {
          allResults.push(...result.results.slice(0, 5));
        }
      } catch (e) {
        console.error(`[BG-Check] Search error for "${term}":`, e.message);
      }
    }

    // 去重 + 限制数量
    const seen = new Set();
    const uniqueResults = allResults.filter(r => {
      if (!r.title || seen.has(r.url)) return false;
      seen.add(r.url);
      return true;
    }).slice(0, 15);

    // 3. 构建搜索结果摘要
    const searchSummary = uniqueResults.map((r, i) =>
      `[${i + 1}] ${r.title}\nURL: ${r.url}\n${r.description || ''}\n`
    ).join('\n');

    // 4. 用AI分析
    const settings = await getAISettings(req.userId || 'default');
    const modelId = await resolveModelId(settings);

    const systemPrompt = `你是一位资深的外贸客户背调分析师。根据搜索结果分析客户公司的背景信息。

请严格按以下JSON格式返回分析结果（不要返回其他内容）：

{
  "companyName": "公司全称",
  "industry": "所属行业",
  "country": "所在国家/地区",
  "website": "官方网站",
  "description": "公司简介（2-3句话）",
  "products": "主要产品/业务",
  "scale": "公司规模（员工数/营收规模，如能推断）",
  "trustLevel": "可信度评级：高/中/低",
  "trustReasons": "可信度判断依据",
  "riskFlags": ["风险信号列表，无则为空数组"],
  "marketFit": "与外贸供应商的合作匹配度分析",
  "suggestedApproach": "跟进策略建议（2-3条具体建议）",
  "socialLinks": {
    "linkedin": "",
    "facebook": "",
    "twitter": ""
  }
}

分析要点：
1. 根据域名、描述判断行业和国家
2. 评估公司可信度（有官网、有真实产品信息=高；仅有域名注册=低）
3. 评估合作潜力（是否在采购同类产品）
4. 识别风险信号（新注册域名、无实际业务信息等）

仅返回JSON。`;

    const userPrompt = `搜索关键词: ${query}
${email ? `客户邮箱: ${email}` : ''}
${context ? `相关对话/邮件内容:\n${context.substring(0, 500)}` : ''}

搜索结果:
${searchSummary || '未找到相关搜索结果'}

请根据以上信息分析客户背景。如果搜索结果有限，根据域名和可用信息做合理推断，并注明哪些是推断的。`;

    const result = await chatComplete(modelId, systemPrompt, userPrompt, {
      temperature: 0.3,
      maxTokens: 1500
    });

    // 5. 解析结果
    let report;
    try {
      const jsonMatch = result.match(/\{[\s\S]*\}/);
      if (jsonMatch) {
        report = JSON.parse(jsonMatch[0]);
      } else {
        report = { rawResult: result };
      }
    } catch (e) {
      report = { rawResult: result };
    }

    res.json({
      query,
      domain,
      sourcesCount: uniqueResults.length,
      sources: uniqueResults.slice(0, 5).map(r => ({ title: r.title, url: r.url })),
      report
    });
  } catch (err) {
    console.error('[BG-Check] Error:', err);
    res.status(500).json({ error: '背调分析失败，请稍后重试' });
  }
});

export default router;

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  accounts  WhatsAppAccount[]
  settings  Setting[]
  waConnection WAConnection[]
  customers    Customer[]    @relation("CustomerOwner")
  assignedCustomers Customer[] @relation("CustomerAssignee")
  emailAccounts  EmailAccount[]
  automationRules AutomationRule[]
  automationCustomers AutomationCustomer[]
  automationQueue AutomationQueueItem[]
}

model WhatsAppAccount {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform            String   @default("whatsapp") // whatsapp | telegram
  phone               String?
  name                String?
  pushName            String?
  status              String   @default("disconnected") // whatsapp: disconnected/connecting/connected; telegram: disconnected/connected
  sessionDir          String?  @unique
  instanceName        String?  // Evolution API instance name
  avatarUrl           String?
  // Telegram 专用
  telegramBotToken    String?  // 123456:ABC-DEF...
  telegramBotUsername String?  // @jzjglass_bot
  telegramBotInfo     String?  // JSON getMe() 缓存
  createdAt           DateTime @default(now())
  lastActiveAt        DateTime?
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
}

model Contact {
  id          Int      @id @default(autoincrement())
  accountId   Int
  account     WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform   String   @default("whatsapp") // whatsapp | telegram
  jid         String
  name        String?
  phone       String?
  pushName    String?
  avatarUrl   String?
  tags        String?
  notes       String?
  country     String?
  language    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
  conversation Conversation?

  @@unique([accountId, platform, jid])
}

model Setting {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model TranslationCache {
  id           Int      @id @default(autoincrement())
  sourceText   String
  sourceLang   String
  targetLang   String
  engine       String
  translated   String
  createdAt    DateTime @default(now())

  @@unique([sourceText, sourceLang, targetLang, engine])
}

model Message {
  id          Int      @id @default(autoincrement())
  accountId   Int
  account     WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform   String   @default("whatsapp") // whatsapp | telegram
  contactId   Int
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jid         String
  fromMe      Boolean
  content     String
  translation String?
  sourceLang  String?
  messageType String   @default("text")
  mediaUrl    String?
  mediaKey    String?
  timestamp   DateTime
  createdAt   DateTime @default(now())
}

model Conversation {
  id            Int      @id @default(autoincrement())
  accountId    Int
  account      WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform   String   @default("whatsapp") // whatsapp | telegram
  contactId    Int      @unique
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jid          String
  lastMessage  String?
  lastMessageAt DateTime?
  unreadCount  Int      @default(0)
  pinned       Boolean  @default(false)
  starred      Boolean  @default(false)
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, platform, jid])
}

model WAConnection {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String    @unique
  phone           String?
  status          String    @default("disconnected")
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        WAMessage[]
}

model WAMessage {
  id          Int      @id @default(autoincrement())
  sessionId   String
  connection  WAConnection @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  from        String
  to          String
  body        String
  type        String   @default("text")
  direction   String   @default("inbound")
  timestamp   DateTime
  read        Boolean  @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  ackError    String?
  waMessageId String?   @unique
  mediaUrl    String?
  fileName    String?
  mimeType    String?
  // 入站WhatsApp加密媒体解密所需字段（从webhook原始消息中提取）
  mediaKey    String?    // base64 mediaKey
  mediaDirectPath String? // directPath (相对MMG路径，无host)
  mediaEncSha256 String? // fileEncSha256
  mediaSha256 String?   // fileSha256（明文校验）
  fileLength  Int?      // 明文文件大小
  waKeyJson   String?   // 完整key对象JSON（{id,fromMe,remoteJid,participant}）
  waMsgTimestamp Int?   // messageTimestamp (秒)
  translation   String?
  sourceLang   String?
  createdAt   DateTime @default(now())
}

model Customer {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("CustomerOwner", fields: [userId], references: [id], onDelete: Cascade)
  jid           String?  // WhatsApp JID (e.g. 86138...@s.whatsapp.net), unique per user
  name          String   @default("")
  companyName   String?  // V2: 客户公司名（硬性门槛）
  contactName   String?  // 联系人名
  title         String?  // 职位/头衔
  website       String?  // 网站
  customerLevel String   @default("C") // A/B/C
  firstContactAt DateTime?
  businessProfileSyncedAt DateTime?
  aiExtractedAt DateTime?
  aiAutoFields  String?  @map("ai_auto_fields") // JSON array of field names auto-filled by AI
  phone         String?
  email         String?
  company       String?  // legacy 旧字段，保留兼容
  country       String?
  city          String?
  address      String?
  industry     String?
  tags          String?  @default("[]")
  notes         String?
  source        String?  @default("whatsapp") // 展会/独立站询盘/主动开发/老客户推荐/其他/未知
  intentLevel   Int      @default(5)
  status        String   @default("potential")
  assignedTo    Int?
  assignee      User?    @relation("CustomerAssignee", fields: [assignedTo], references: [id])
  lastContactAt DateTime?
  // 需求总结模块
  requirementSummary   String?   @map("requirement_summary")    // 需求总结（较长文本）
  requirementProducts  String?   @map("requirement_products")   // 意向产品
  requirementBudget    String?   @map("requirement_budget")     // 预算/目标价
  requirementQuantity  String?   @map("requirement_quantity")   // 数量
  requirementDelivery  String?   @map("requirement_delivery")   // 交期要求
  requirementUpdatedAt DateTime? @map("requirement_updated_at") // 需求最后更新时间
  requirementSource    String?   @map("requirement_source")     // manual / ai_summary
  automationAssignments AutomationCustomer[]
  documents    Document[]
  followUps    CustomerFollowUp[]
  automationQueueItems AutomationQueueItem[]
  // 客户背调模块
  bgReport     String?
  bgUpdatedAt  DateTime?
  // 销售漏斗
  dealStage     String   @default("new") // new/qualified/quoting/negotiating/won/completed/lost
  dealStageAt   DateTime?
  dealValue     Float?   @default(0)
  translationSettings String?  @map("translation_settings") // per-customer translation JSON, null = follow global
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, jid])
}

model EmailAccount {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  provider    String   @default("custom")
  imapHost    String
  imapPort    Int      @default(993)
  smtpHost    String
  smtpPort    Int      @default(465)
  password    String
  status      String   @default("disconnected")
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  emails      EmailMessage[]
}

model EmailMessage {
  id              Int      @id @default(autoincrement())
  accountId       Int
  account         EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messageId       String?
  from            String
  to              String
  subject         String
  body            String
  bodyHtml        String?
  bodyPlain       String?
  direction       String   @default("inbound")
  translation     String?
  sourceLang      String?
  attachmentNames String?
  createdAt       DateTime @default(now())
  read            Boolean  @default(false)

  @@unique([accountId, messageId])
}

model AutomationRule {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  enabled       Boolean  @default(false)
  schedule      String   @default("{}")
  languageMode  String   @default("auto")
  defaultLang   String?
  aiPrompt      String?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         AutomationQueueItem[]
  @@unique([userId, type])
}

model AutomationCustomer {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  types        String   @default("[]")
  customLang   String?
  lastSentAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, customerId])
}

model AutomationQueueItem {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId        Int
  rule          AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          String
  language      String   @default("en")
  content       String
  subject       String?
  reference     String?
  status        String   @default("pending")
  editedContent String?
  sentAt        DateTime?
  waMessageId   String?
  errorMsg      String?
  scheduledFor  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId, status])
}

model Document {
  id            String   @id @default(cuid())
  userId        Int      @default(1)
  customerId    Int?
  customerJid   String?
  type          String   // QUOTATION / PI
  docNumber     String   @unique
  title         String
  issueDate     DateTime @default(now())
  validUntil    DateTime?
  currency      String   @default("USD")
  totalAmount   Float    @default(0)
  amountInWords String?
  status        String   @default("DRAFT")
  sellerInfo    Json
  buyerInfo     Json
  tradeTerm     String?
  paymentTerm   String?
  portOfLoading String?
  portOfDest    String?
  shipDate      String?
  remarks       String?
  items         DocumentItem[]
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId, customerId])
  @@index([type])
}

model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  productName String
  model       String?
  spec        String?
  quantity    Float    @default(1)
  unit        String   @default("pcs")
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  remark      String?
  @@index([documentId])
}

model CustomerFollowUp {
  id         String   @id @default(cuid())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  source     String   @default("manual")
  metadata   String?
  createdAt  DateTime @default(now())
  @@index([customerId])
}

model MessageSample {
  id                    Int      @id @default(autoincrement())
  accountId             Int      @default(1)
  contactJid            String
  customerMsg           String
  customerMsgTranslated String?
  customerMsgLang       String?
  salesReply            String
  salesReplyTranslated  String?
  salesReplyLang        String?
  usedAi                Boolean  @default(false)
  aiSuggestion          String?
  aiModified            Boolean  @default(false)
  contextBefore         String?
  industry              String?
  productLine           String?
  application           String?
  scene                 String?
  favorited             Boolean  @default(false)
  qualityScore          Float?
  createdAt             DateTime @default(now())

  @@index([accountId, contactJid, createdAt])
}

model CompanyMaterial {
  id          Int      @id @default(autoincrement())
  accountId   Int      @default(1)
  type        String   @default("text") // text/pdf/image/video
  category    String   // company/payment/certification/logistics/warranty/product/other
  title       String
  content     String   // text body or file description
  lang        String   @default("en") // en/zh/es/fr/ar/pt/de/ru/ja/ko/it/tr
  fileName    String?  // original filename for files
  filePath    String?  // server relative path
  fileSize    Int?     // bytes
  mimeType    String?
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([accountId, category])
}


// AI销售助理对话历史
model AssistantConversation {
  id        Int      @id @default(autoincrement())
  userId    Int      // 销售用户ID
  role      String   // "user" 或 "assistant"
  content   String   // 对话内容
  tasks     String?  // 关联的任务ID（JSON数组）
  attachments String? // 附件信息（JSON数组）
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
}

// AI销售助理执行的任务
model AssistantTask {
  id             Int       @id @default(autoincrement())
  conversationId Int?      // 关联的对话ID
  userId         Int       // 销售用户ID
  type           String    // "send_message", "create_order", "update_customer"等
  status         String    @default("pending") // "pending", "confirmed", "executed", "failed"
  params         String    // 任务参数（JSON）
  result         String?   // 执行结果（JSON）
  confirmedAt    DateTime?
  executedAt     DateTime?
  createdAt      DateTime  @default(now())
  
  @@index([userId, status])
  @@index([conversationId])
}


model TopicSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  topic       String
  description String?
  keywords    String?
  focusAreas  String?
  frequency   String   @default("daily")
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)

  briefings   TopicBriefing[]

  @@unique([userId, topic])
}

model TopicBriefing {
  id              Int      @id @default(autoincrement())
  subscriptionId  Int
  content         String
  summary         String?
  createdAt       DateTime @default(now())

  topicSubscription TopicSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}


// ==================== 产品知识库 ====================

model ProductKnowledgeBase {
  id              Int      @id @default(autoincrement())
  accountId       Int      @default(1)
  
  // 基本信息
  productNameCn   String   // 产品中文名
  productNameEn   String   // 产品英文名
  productDesc     String?  // 产品描述
  productImageUrl String?  // 产品图片URL
  
  // 报价规则
  pricingUnit     String?  // 计价单位（kg/piece/set）
  basePrice       Float?   // 基础价格
  moq             String?  // 最小起订量（文本，如"1个20GP"、"1000吨"）
  deliveryDays    String?  // 标准交期（文本，如"15天"、"3-4周"）
  paymentTerms    String?  // 付款条件
  
  // 配置状态
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  questions       ProductQuestion[]
  
  @@index([accountId])
  @@index([productNameEn])
}

model ProductQuestion {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      ProductKnowledgeBase @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // 问题内容
  questionCn   String   // 中文问题
  questionEn   String   // 英文问题
  questionType String   @default("text") // text/single_choice/multiple_choice/number
  optionsJson  String?  // 选项列表（JSON格式）
  
  // 问题属性
  priority     Int      @default(1) // 1=必须问，2=进阶问
  sortOrder    Int      @default(0)
  
  // 配置状态
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([productId, priority])
}

// ==================== 客户背调与BANT评分 ====================

model CustomerBackgroundCheck {
  id          Int      @id @default(autoincrement())
  contactId   Int      // 关联的Contact ID
  
  // 公司信息
  companyName String?  // 公司名称
  website     String?  // 公司官网
  country     String?  // 国家
  industry    String?  // 行业
  companySize String?  // 公司规模
  
  // 详细信息（JSON）
  details     String?  // 完整背调信息（JSON格式）
  
  // 分析结果
  riskLevel   String?  // 风险等级：Low/Medium/High
  notes       String?  // 备注
  
  // 元数据
  source      String   @default("llm") // 数据来源：llm/manual/api
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([contactId])
  @@index([contactId])
}

model CustomerBantScore {
  id          Int      @id @default(autoincrement())
  contactId   Int      // 关联的Contact ID
  
  // BANT四维评分（0-10）
  budgetScore     Float  @default(0)
  authorityScore  Float  @default(0)
  needScore       Float  @default(0)
  timelineScore   Float  @default(0)
  
  // 综合评分
  totalScore      Float  @default(0)
  level           String @default("MEDIUM") // HIGH/MEDIUM/LOW
  
  // 评估详情（JSON）
  evaluationDetails String? // 评估详情（JSON格式）
  
  // 元数据
  evaluatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([contactId])
  @@index([totalScore])
}

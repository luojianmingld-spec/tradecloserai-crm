generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./crm.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  accounts  WhatsAppAccount[]
  settings  Setting[]
  waConnection WAConnection[]
  customers    Customer[]    @relation("CustomerOwner")
  assignedCustomers Customer[] @relation("CustomerAssignee")
  emailAccounts  EmailAccount[]
}

model WhatsAppAccount {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String?
  name         String?
  pushName     String?
  status       String   @default("disconnected")
  sessionDir   String   @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime?
  contacts     Contact[]
  conversations Conversation[]
  messages     Message[]
}

model Contact {
  id          Int      @id @default(autoincrement())
  accountId   Int
  account     WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  jid         String
  name        String?
  phone       String?
  pushName    String?
  avatarUrl   String?
  tags        String?
  notes       String?
  country     String?
  language    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
  conversation Conversation?

  @@unique([accountId, jid])
}

model Setting {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model TranslationCache {
  id           Int      @id @default(autoincrement())
  sourceText   String
  sourceLang   String
  targetLang   String
  engine       String
  translated   String
  createdAt    DateTime @default(now())

  @@unique([sourceText, sourceLang, targetLang, engine])
}

model Message {
  id          Int      @id @default(autoincrement())
  accountId   Int
  account     WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId   Int
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jid         String
  fromMe      Boolean
  content     String
  translation String?
  sourceLang  String?
  messageType String   @default("text")
  mediaUrl    String?
  mediaKey    String?
  timestamp   DateTime
  createdAt   DateTime @default(now())
}

model Conversation {
  id            Int      @id @default(autoincrement())
  accountId    Int
  account      WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId    Int      @unique
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jid          String
  lastMessage  String?
  lastMessageAt DateTime?
  unreadCount  Int      @default(0)
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, jid])
}

model WAConnection {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String    @unique
  phone           String?
  status          String    @default("disconnected")
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        WAMessage[]
}

model WAMessage {
  id          Int      @id @default(autoincrement())
  sessionId   String
  connection  WAConnection @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  from        String
  to          String
  body        String
  type        String   @default("text")
  direction   String   @default("inbound")
  timestamp   DateTime
  read        Boolean  @default(false)
  waMessageId String?
  mediaUrl    String?
  fileName    String?
  translation   String?
  sourceLang   String?
  createdAt   DateTime @default(now())
}

model Customer {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("CustomerOwner", fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  company       String?
  country       String?
  tags          String?  @default("[]")
  notes         String?
  source        String?  @default("whatsapp")
  intentLevel   Int      @default(5)
  status        String   @default("potential")
  assignedTo    Int?
  assignee      User?    @relation("CustomerAssignee", fields: [assignedTo], references: [id])
  lastContactAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailAccount {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  provider    String   @default("custom")
  imapHost    String
  imapPort    Int      @default(993)
  smtpHost    String
  smtpPort    Int      @default(465)
  password    String
  status      String   @default("disconnected")
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  emails      EmailMessage[]
}

model EmailMessage {
  id              Int      @id @default(autoincrement())
  accountId       Int
  account         EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messageId       String?
  from            String
  to              String
  subject         String
  body            String
  bodyHtml        String?
  bodyPlain       String?
  direction       String   @default("inbound")
  translation     String?
  sourceLang      String?
  attachmentNames String?
  createdAt       DateTime @default(now())
  read            Boolean  @default(false)

  @@unique([accountId, messageId])
}

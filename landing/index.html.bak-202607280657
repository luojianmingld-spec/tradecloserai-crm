<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TradeAgent - 外贸成交转化AI工作台</title>
<style>
  :root {
    --bg-primary: #0a0e1a;
    --bg-secondary: #0f1629;
    --bg-card: #131a2e;
    --bg-card-hover: #1a2340;
    --border-color: #1e2a4a;
    --border-highlight: #2a3a6a;
    --text-primary: #e8ecf4;
    --text-secondary: #8892a8;
    --text-muted: #5a6478;
    --accent-cyan: #00d4ff;
    --accent-green: #00e676;
    --accent-amber: #f59e0b;
    --accent-purple: #a855f7;
    --accent-pink: #ec4899;
    --accent-red: #ef4444;
    --accent-blue: #3b82f6;
    --gradient-cyan: linear-gradient(135deg, #00d4ff, #00e676);
    --gradient-hero: linear-gradient(135deg, #00d4ff 0%, #00e676 50%, #f59e0b 100%);
    --radius: 12px;
    --radius-lg: 16px;
    --radius-full: 9999px;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ============ NAV ============ */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; height: 64px;
    background: rgba(10, 14, 26, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }
  .nav-logo {
    display: flex; align-items: center; gap: 10px;
    font-size: 18px; font-weight: 700; color: var(--text-primary);
    text-decoration: none;
  }
  .nav-logo-icon {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-green));
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; color: #fff;
  }
  .nav-links { display: flex; gap: 32px; align-items: center; }
  .nav-links a {
    color: var(--text-secondary); text-decoration: none; font-size: 14px;
    transition: color 0.2s;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--text-primary); }
  .nav-actions { display: flex; gap: 12px; align-items: center; }
  .btn {
    padding: 8px 20px; border-radius: var(--radius-full); font-size: 14px;
    font-weight: 600; cursor: pointer; border: none; transition: all 0.2s;
    text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-ghost {
    background: transparent; color: var(--text-primary);
    border: 1px solid var(--border-highlight);
  }
  .btn-ghost:hover { background: var(--bg-card); }
  .btn-primary {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
    color: #fff;
  }
  .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
  .btn-large { padding: 12px 32px; font-size: 15px; }
  .btn-outline {
    background: transparent; color: var(--text-primary);
    border: 1px solid var(--border-highlight);
  }
  .btn-outline:hover { background: var(--bg-card); }
  .btn-green {
    background: linear-gradient(135deg, #00c853, #00e676);
    color: #000;
  }
  .btn-green:hover { opacity: 0.9; transform: translateY(-1px); }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center;
    padding: 120px 20px 80px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(30,42,74,0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(30,42,74,0.15) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 0;
  }
  .hero::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0; height: 200px;
    background: linear-gradient(to top, var(--bg-primary), transparent);
    z-index: 1;
  }
  .hero > * { position: relative; z-index: 2; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 16px; border-radius: var(--radius-full);
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.2);
    color: var(--accent-cyan); font-size: 13px; font-weight: 500;
    margin-bottom: 24px;
  }
  .hero-badge::before {
    content: '';
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent-green);
  }

  .hero h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .hero h1 .gradient-text {
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .hero-actions { display: flex; gap: 16px; margin-bottom: 48px; flex-wrap: wrap; justify-content: center; }

  .hero-stats {
    display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;
  }
  .hero-stat {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 20px 28px;
    min-width: 130px;
    text-align: center;
  }
  .hero-stat-value {
    font-size: 28px; font-weight: 800;
    background: var(--gradient-cyan);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

  /* ============ SECTIONS ============ */
  .section {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-tag {
    display: block; text-align: center;
    font-size: 13px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 2px;
    color: var(--accent-cyan);
    margin-bottom: 12px;
  }
  .section-title {
    text-align: center;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    margin-bottom: 12px;
  }
  .section-title .highlight { color: var(--accent-green); }
  .section-desc {
    text-align: center;
    color: var(--text-secondary);
    font-size: 15px;
    max-width: 600px;
    margin: 0 auto 48px;
  }

  /* ============ PIPELINE ============ */
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .pipeline-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 28px 20px;
    text-align: center;
    position: relative;
    transition: all 0.3s;
  }
  .pipeline-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }
  .pipeline-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    margin: 0 auto 16px;
  }
  .pipeline-step {
    font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .pipeline-name {
    font-size: 16px; font-weight: 700;
    margin-bottom: 8px;
  }
  .pipeline-desc {
    font-size: 13px; color: var(--text-secondary); line-height: 1.5;
  }
  .pipeline-arrow {
    position: absolute; right: -12px; top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted); font-size: 18px;
    z-index: 2;
  }
  .pipeline-card:last-child .pipeline-arrow { display: none; }

  /* ============ SKILLS GRID ============ */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .skill-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 24px 20px;
    transition: all 0.3s;
    position: relative;
  }
  .skill-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }
  .skill-badge {
    position: absolute; top: 12px; right: 12px;
    padding: 3px 10px; border-radius: var(--radius-full);
    font-size: 11px; font-weight: 600;
    background: rgba(0,212,255,0.1);
    color: var(--accent-cyan);
    border: 1px solid rgba(0,212,255,0.2);
  }
  .skill-icon { font-size: 24px; margin-bottom: 12px; }
  .skill-name { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .skill-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

  /* ============ WHY ============ */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 800px;
    margin: 0 auto;
  }
  .why-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 24px;
    display: flex; gap: 16px; align-items: flex-start;
    transition: all 0.3s;
  }
  .why-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-2px);
  }
  .why-icon { font-size: 24px; flex-shrink: 0; }
  .why-title { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
  .why-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

  /* ============ CTA BANNER ============ */
  .cta-banner {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 60px 40px;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  .cta-banner h2 {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    margin-bottom: 12px;
  }
  .cta-banner p {
    color: var(--text-secondary);
    margin-bottom: 32px;
    font-size: 15px;
  }
  .cta-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  /* ============ PRICING ============ */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
  }
  .pricing-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 32px 24px;
    position: relative;
    transition: all 0.3s;
  }
  .pricing-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-4px);
  }
  .pricing-card.featured {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 40px rgba(0,212,255,0.1);
  }
  .pricing-card.featured::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--gradient-cyan);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .pricing-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 12px; border-radius: var(--radius-full);
    font-size: 12px; font-weight: 600;
    margin-bottom: 16px;
  }
  .pricing-badge.hot { background: rgba(245,158,11,0.15); color: var(--accent-amber); }
  .pricing-badge.pro { background: rgba(0,212,255,0.1); color: var(--accent-cyan); }
  .pricing-badge.ent { background: rgba(168,85,247,0.15); color: var(--accent-purple); }
  .pricing-plan { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
  .pricing-plan-en { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }
  .pricing-amount {
    font-size: 40px; font-weight: 800; margin-bottom: 4px;
  }
  .pricing-amount .currency { font-size: 20px; }
  .pricing-amount .period { font-size: 14px; color: var(--text-muted); font-weight: 400; }
  .pricing-tagline { font-size: 13px; color: var(--text-secondary); margin-bottom: 24px; }
  .pricing-features { list-style: none; margin-bottom: 28px; }
  .pricing-features li {
    font-size: 13px; color: var(--text-secondary);
    padding: 6px 0;
    display: flex; align-items: flex-start; gap: 8px;
  }
  .pricing-features li::before {
    content: '✓';
    color: var(--accent-green);
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }
  .pricing-btn {
    width: 100%; padding: 12px; border-radius: var(--radius);
    font-size: 14px; font-weight: 600; cursor: pointer;
    border: none; transition: all 0.2s;
  }
  .pricing-btn.outline {
    background: transparent; color: var(--text-primary);
    border: 1px solid var(--border-highlight);
  }
  .pricing-btn.outline:hover { background: var(--bg-card-hover); }
  .pricing-btn.filled {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
    color: #fff;
  }
  .pricing-btn.filled:hover { opacity: 0.9; }

  /* Enterprise Private Deployment */
  .enterprise-private {
    max-width: 960px;
    margin: 32px auto 0;
    background: linear-gradient(135deg, rgba(168,85,247,0.08), rgba(0,212,255,0.06));
    border: 1px solid rgba(168,85,247,0.25);
    border-radius: var(--radius);
    padding: 32px;
  }
  .enterprise-private-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 32px;
    align-items: center;
  }
  .enterprise-private-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 12px;
  }
  .enterprise-private-title-en {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .enterprise-private-features {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .enterprise-private-features li {
    font-size: 14px;
    color: var(--text-secondary);
    padding: 4px 0;
    position: relative;
    padding-left: 20px;
  }
  .enterprise-private-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent-purple);
    font-weight: 700;
  }
  .enterprise-private-price {
    font-size: 28px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-purple), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-align: center;
  }
  .enterprise-private-price-en {
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: 16px;
  }
  .enterprise-private-right .pricing-btn {
    width: 100%;
  }

  @media (max-width: 768px) {
    .enterprise-private-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 20px;
    }
    .enterprise-private-right {
      max-width: 280px;
      margin: 0 auto;
    }
  }

  /* ============ CREDITS ============ */
  .credits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 960px;
    margin: 0 auto;
  }
  .credit-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 24px 16px;
    text-align: center;
    transition: all 0.3s;
    position: relative;
  }
  .credit-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-2px);
  }
  .credit-card.hot { border-color: var(--accent-amber); }
  .credit-card.best { border-color: var(--accent-green); }
  .credit-tag {
    position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
    padding: 2px 12px; border-radius: var(--radius-full);
    font-size: 11px; font-weight: 700;
  }
  .credit-tag.hot { background: var(--accent-amber); color: #000; }
  .credit-tag.best { background: var(--accent-green); color: #000; }
  .credit-name { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .credit-price { font-size: 28px; font-weight: 800; margin-bottom: 4px; }
  .credit-amount { font-size: 14px; color: var(--accent-cyan); font-weight: 600; margin-bottom: 4px; }
  .credit-unit { font-size: 12px; color: var(--text-muted); margin-bottom: 8px; }
  .credit-save { font-size: 12px; font-weight: 600; }

  /* ============ COMPARISON TABLE ============ */
  .comparison-table {
    max-width: 960px; margin: 0 auto;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .comparison-table table {
    width: 100%; border-collapse: collapse;
  }
  .comparison-table th, .comparison-table td {
    padding: 14px 16px; text-align: center; font-size: 13px;
    border-bottom: 1px solid var(--border-color);
  }
  .comparison-table th {
    background: rgba(0,0,0,0.2);
    font-weight: 700; color: var(--text-primary);
  }
  .comparison-table td:first-child { text-align: left; color: var(--text-secondary); }
  .comparison-table tr:last-child td { border-bottom: none; }
  .comparison-table .check { color: var(--accent-green); }
  .comparison-table .dash { color: var(--text-muted); }
  .comparison-table .highlight-cell { color: var(--accent-cyan); font-weight: 600; }

  /* ============ FAQ ============ */
  .faq-list {
    max-width: 720px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 12px;
  }
  .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s;
  }
  .faq-item:hover { border-color: var(--border-highlight); }
  .faq-q {
    padding: 18px 24px;
    font-size: 15px; font-weight: 600;
    display: flex; justify-content: space-between; align-items: center;
  }
  .faq-q::after {
    content: '+'; font-size: 20px; color: var(--text-muted);
    transition: transform 0.2s;
  }
  .faq-item.open .faq-q::after { transform: rotate(45deg); }
  .faq-a {
    max-height: 0; overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0 24px;
    font-size: 14px; color: var(--text-secondary); line-height: 1.6;
  }
  .faq-item.open .faq-a {
    max-height: 200px;
    padding: 0 24px 18px;
  }

  /* ============ FOOTER ============ */
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 48px 40px 24px;
    margin-top: 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto 40px;
  }
  .footer-col-links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
  }
  .footer-brand p {
    font-size: 13px; color: var(--text-muted); margin-top: 12px; line-height: 1.5;
  }
  .footer-col h4 {
    font-size: 14px; font-weight: 700; margin-bottom: 16px;
  }
  .footer-col a {
    display: block; font-size: 13px; color: var(--text-muted);
    text-decoration: none; padding: 4px 0; transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--text-primary); }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    max-width: 1200px; margin: 0 auto;
    padding-top: 24px; border-top: 1px solid var(--border-color);
    font-size: 12px; color: var(--text-muted);
  }
  .footer-models { display: flex; gap: 8px; flex-wrap: wrap; }
  .footer-model-tag {
    padding: 3px 10px; border-radius: var(--radius-full);
    background: var(--bg-card); border: 1px solid var(--border-color);
    font-size: 11px; color: var(--text-secondary);
  }

  /* ============ MODAL ============ */
  .modal-overlay {
    display: none; position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    align-items: center; justify-content: center;
  }
  .modal-overlay.active { display: flex; }
  .modal {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 40px;
    width: 90%; max-width: 520px;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }
  .modal-close {
    position: absolute; top: 16px; right: 16px;
    background: none; border: none; color: var(--text-muted);
    font-size: 24px; cursor: pointer;
  }
  .modal h2 { font-size: 22px; font-weight: 800; margin-bottom: 8px; }
  .modal > p { font-size: 14px; color: var(--text-secondary); margin-bottom: 28px; }
  .form-group { margin-bottom: 18px; }
  .form-group label {
    display: block; font-size: 13px; font-weight: 600;
    margin-bottom: 6px; color: var(--text-secondary);
  }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%; padding: 12px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    color: var(--text-primary);
